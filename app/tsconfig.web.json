{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "outDir": "node_modules/.tsc/web",
    "tsBuildInfoFile": "node_modules/.tsc/web.tsbuildinfo"
  },
  "include": ["src/renderer/src", "src/shared"]
}
