{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "outDir": "node_modules/.tsc/node",
    "tsBuildInfoFile": "node_modules/.tsc/node.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main",
    "src/preload",
    "src/shared",
    "src/core",
    "src/adapters",
    "test"
  ]
}
