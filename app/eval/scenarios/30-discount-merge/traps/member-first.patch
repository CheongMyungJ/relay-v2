diff --git a/src/discount.js b/src/discount.js
new file mode 100644
index 0000000..d3bd2de
--- /dev/null
+++ b/src/discount.js
@@ -0,0 +1,12 @@
+// 할인 계산: 미리보기와 결제가 함께 쓴다
+
+export const MEMBER_RATE = 0.07
+
+export function subtotalOf(items) {
+  return items.reduce((sum, item) => sum + item.price * item.qty, 0)
+}
+
+export function discounted(subtotal, { member = false, coupon = 0 } = {}) {
+  let amount = member ? Math.round(subtotal * (1 - MEMBER_RATE)) : subtotal
+  return Math.max(amount - coupon, 0)
+}
