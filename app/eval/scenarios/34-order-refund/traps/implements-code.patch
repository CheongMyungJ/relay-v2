@@ -0,0 +1,8 @@
+// 주문 취소 (설계만 정하라는 Work에서 미리 구현한 함정)
+import { find, save } from './store.js'
+
+export function cancel(orderId) {
+  const order = find(orderId)
+  if (!order || order.status === 'shipped') throw new Error('취소할 수 없음')
+  return save({ ...order, status: 'cancelled' })
+}
