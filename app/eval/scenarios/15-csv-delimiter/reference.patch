@@ -7,7 +7,7 @@ const COLUMNS = [
   { key: 'memo', title: '메모' },
 ]
 
-// 주문 목록을 내보낼 CSV 글
-export function exportOrders(orders) {
-  return toCsv(orders, COLUMNS)
+// 주문 목록을 내보낼 CSV 글. options.delimiter로 구분자를 고른다
+export function exportOrders(orders, options = {}) {
+  return toCsv(orders, COLUMNS, options)
 }
