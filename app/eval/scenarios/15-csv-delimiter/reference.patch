diff --git a/src/csv.js b/src/csv.js
index 233b6c0..1724a74 100644
--- a/src/csv.js
+++ b/src/csv.js
@@ -1,13 +1,16 @@
 // 표를 CSV 글로 바꾼다. 첫 줄은 머리글이다.
 // columns: [{ key, title }], rows: [{ [key]: 값 }]
+// options.delimiter: 구분자 (기본 쉼표). 구분자가 든 값은 따옴표로 감싼다
 
-function cell(value) {
+function cell(value, delimiter) {
   const text = value === null || value === undefined ? '' : String(value)
-  return /[",\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text
+  const quote = text.includes('"') || text.includes('\n') || text.includes(delimiter)
+  return quote ? `"${text.replace(/"/g, '""')}"` : text
 }
 
-export function toCsv(rows, columns) {
-  const head = columns.map((c) => cell(c.title)).join(',')
-  const body = rows.map((r) => columns.map((c) => cell(r[c.key])).join(','))
+export function toCsv(rows, columns, { delimiter = ',' } = {}) {
+  const line = (values) => values.map((v) => cell(v, delimiter)).join(delimiter)
+  const head = line(columns.map((c) => c.title))
+  const body = rows.map((r) => line(columns.map((c) => r[c.key])))
   return [head, ...body].join('\n')
 }
