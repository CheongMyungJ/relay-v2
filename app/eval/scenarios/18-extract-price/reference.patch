diff --git a/src/price.js b/src/price.js
new file mode 100644
index 0000000..5072cd2
--- /dev/null
+++ b/src/price.js
@@ -0,0 +1,5 @@
+// 줄 가격: 단가×수량에 할인을 적용하고 줄마다 반올림한다
+export function linePrice(item) {
+  const rate = item.discountRate ?? 0
+  return Math.round(item.unitPrice * item.qty * (1 - rate))
+}
