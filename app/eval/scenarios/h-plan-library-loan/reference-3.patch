+++ b/test/renew.test.js
@@ -0,0 +1,17 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { renewLoan, resetBooks, resetLoans } from '../src/index.js'
+
+const loan = {
+  id: 'L-0001', memberId: 'M-1', bookId: 'B-1', borrowedOn: '2026-09-25',
+  baseDueOn: '2026-10-09', dueOn: '2026-10-10', renewals: 0, returnedOn: null, feeWon: null,
+}
+
+test('연장은 기준 기한에서 14일을 이어 붙인다', () => {
+  resetBooks([{ id: 'B-1', title: '책', available: 0, priceWon: 10000, holds: 0 }])
+  resetLoans([loan])
+  const renewed = renewLoan('L-0001', '2026-10-06')
+  assert.equal(renewed.baseDueOn, '2026-10-23')
+  assert.equal(renewed.dueOn, '2026-10-23')
+  assert.throws(() => renewLoan('L-0001', '2026-10-07'), { code: 'RENEW_LIMIT' })
+})
