+import { isOpenDay } from '../calendar.js'
+import { LOAN_DAYS, MAX_LOANS } from '../config.js'
+import { LoanError } from '../errors.js'
+import { getBook, saveBook } from '../books/store.js'
+import { getMember } from '../members/store.js'
+import { addDays } from '../util/dates.js'
+import { listLoans, nextLoanId, saveLoan } from './store.js'
+
+/** 대출 기록을 만들어 저장하고 돌려준다. 거절은 LoanError (D10) */
+export function checkout(memberId, bookId, today) {
+  if (!getMember(memberId)) throw new LoanError('NOT_FOUND', `없는 회원: ${memberId}`)
+  const book = getBook(bookId)
+  if (!book) throw new LoanError('NOT_FOUND', `없는 책: ${bookId}`)
+  if (!isOpenDay(today)) throw new LoanError('CLOSED', `휴관일에는 빌릴 수 없다: ${today}`)
+
+  const mine = listLoans().filter((l) => l.memberId === memberId && !l.returnedOn)
+  if (mine.some((l) => today > l.dueOn)) throw new LoanError('OVERDUE_BLOCK', '연체 중인 책이 있다')
+  if (mine.length >= MAX_LOANS) throw new LoanError('LIMIT', `최대 ${MAX_LOANS}권`)
+  if (mine.some((l) => l.bookId === bookId)) throw new LoanError('DUPLICATE', '이미 빌린 책')
+  if (book.available < 1) throw new LoanError('NO_COPIES', '빌릴 수 있는 책이 없다')
+
+  const baseDueOn = addDays(today, LOAN_DAYS)
+  const loan = {
+    id: nextLoanId(),
+    memberId,
+    bookId,
+    borrowedOn: today,
+    baseDueOn,
+    dueOn: baseDueOn,
+    renewals: 0,
+    returnedOn: null,
+    feeWon: null,
+  }
+  saveBook({ ...book, available: book.available - 1 })
+  return saveLoan(loan)
+}
