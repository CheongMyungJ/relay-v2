@@ -0,0 +1,18 @@
+import { nextOpenDay } from '../calendar.js'
+import { LOAN_DAYS, MAX_RENEWALS } from '../config.js'
+import { LoanError } from '../errors.js'
+import { addDays } from '../util/dates.js'
+import { getLoan, saveLoan } from './store.js'
+
+/** 연장하고 갱신된 기록을 돌려준다 (D8, D9) */
+export function renewLoan(loanId, today) {
+  const loan = getLoan(loanId)
+  if (!loan) throw new LoanError('NOT_FOUND', `없는 대출: ${loanId}`)
+  if (loan.returnedOn) throw new LoanError('ALREADY_RETURNED', '이미 반납했다')
+  if (today > loan.dueOn) throw new LoanError('OVERDUE', '연체 중에는 연장할 수 없다')
+  if (loan.renewals >= MAX_RENEWALS) throw new LoanError('RENEW_LIMIT', '연장은 한 번만')
+
+  // 연장하는 날이 아니라 기준 기한에서 이어 붙인다. 휴관으로 미뤄 준 날은 쌓지 않는다 (D8)
+  const baseDueOn = addDays(loan.baseDueOn, LOAN_DAYS)
+  return saveLoan({ ...loan, renewals: loan.renewals + 1, baseDueOn, dueOn: nextOpenDay(baseDueOn) })
+}
