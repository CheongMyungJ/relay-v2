@@ -0,0 +1,24 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { checkout, getBook, getLoan, resetBooks, resetLoans, resetMembers } from '../src/index.js'
+
+function setup() {
+  resetMembers([{ id: 'M-1', name: '가영' }])
+  resetBooks([{ id: 'B-1', title: '책', available: 1, priceWon: 10000, holds: 0 }])
+  resetLoans([])
+}
+
+test('빌리면 기록이 생기고 재고가 준다', () => {
+  setup()
+  const loan = checkout('M-1', 'B-1', '2026-10-06')
+  assert.equal(loan.dueOn, '2026-10-20')
+  assert.equal(getBook('B-1').available, 0)
+  assert.deepEqual(getLoan(loan.id), loan)
+})
+
+test('재고가 없으면 거절', () => {
+  setup()
+  checkout('M-1', 'B-1', '2026-10-06')
+  resetMembers([{ id: 'M-1', name: '가영' }, { id: 'M-2', name: '나래' }])
+  assert.throws(() => checkout('M-2', 'B-1', '2026-10-06'), { code: 'NO_COPIES' })
+})
