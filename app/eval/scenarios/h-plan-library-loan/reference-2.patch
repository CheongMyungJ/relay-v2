--- /dev/null
+++ b/src/loans/overdue.js
@@ -0,0 +1,9 @@
+import { isOpenDay } from '../calendar.js'
+import { addDays, diffDays } from '../util/dates.js'
+
+/** 연체일수: dueOn 다음 날부터 today까지의 개관일 수 (D6) */
+export function overdueDays(dueOn, today) {
+  let n = 0
+  for (let i = 1; i <= diffDays(today, dueOn); i++) if (isOpenDay(addDays(dueOn, i))) n++
+  return n
+}
