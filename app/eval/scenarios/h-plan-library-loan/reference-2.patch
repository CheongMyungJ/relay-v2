@@ -0,0 +1,18 @@
+import { FEE_PER_DAY, MAX_FEE } from '../config.js'
+import { LoanError } from '../errors.js'
+import { getBook, saveBook } from '../books/store.js'
+import { overdueDays } from './overdue.js'
+import { getLoan, saveLoan } from './store.js'
+
+/** 반납을 처리하고 갱신된 기록을 돌려준다 (D6, D7) */
+export function returnBook(loanId, today) {
+  const loan = getLoan(loanId)
+  if (!loan) throw new LoanError('NOT_FOUND', `없는 대출: ${loanId}`)
+  if (loan.returnedOn) throw new LoanError('ALREADY_RETURNED', '이미 반납했다')
+  const book = getBook(loan.bookId)
+  if (!book) throw new LoanError('NOT_FOUND', `없는 책: ${loan.bookId}`)
+
+  const feeWon = Math.min(overdueDays(loan.dueOn, today) * FEE_PER_DAY, MAX_FEE, book.priceWon)
+  saveBook({ ...book, available: book.available + 1 })
+  return saveLoan({ ...loan, returnedOn: today, feeWon })
+}
