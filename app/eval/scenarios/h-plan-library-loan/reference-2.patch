@@ -0,0 +1,24 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { getBook, resetBooks, resetLoans, returnBook } from '../src/index.js'
+import { overdueDays } from '../src/loans/overdue.js'
+
+const loan = {
+  id: 'L-0001', memberId: 'M-1', bookId: 'B-1', borrowedOn: '2026-10-06',
+  baseDueOn: '2026-10-20', dueOn: '2026-10-20', renewals: 0, returnedOn: null, feeWon: null,
+}
+
+test('연체일수는 개관일만 센다', () => {
+  assert.equal(overdueDays('2026-10-20', '2026-10-20'), 0)
+  assert.equal(overdueDays('2026-10-20', '2026-10-26'), 5)
+})
+
+test('제때 반납하면 재고가 늘고 연체료는 0', () => {
+  resetBooks([{ id: 'B-1', title: '책', available: 0, priceWon: 10000, holds: 0 }])
+  resetLoans([loan])
+  const done = returnBook('L-0001', '2026-10-20')
+  assert.equal(done.feeWon, 0)
+  assert.equal(done.returnedOn, '2026-10-20')
+  assert.equal(getBook('B-1').available, 1)
+  assert.throws(() => returnBook('L-0001', '2026-10-21'), { code: 'ALREADY_RETURNED' })
+})
