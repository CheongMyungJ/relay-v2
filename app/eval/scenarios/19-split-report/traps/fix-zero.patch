+// CSV 글을 행 목록으로 읽는다. 머리글 줄의 이름을 키로 쓰고, 빈 줄은 건너뛴다
+export function parseCsv(text) {
+  const lines = text.trim().split('\n')
+  const header = lines[0].split(',').map((h) => h.trim())
+  const rows = []
+  for (const line of lines.slice(1)) {
+    if (!line.trim()) continue
+    const cells = line.split(',')
+    const row = {}
+    header.forEach((h, i) => {
+      row[h] = (cells[i] ?? '').trim()
+    })
+    rows.push({ date: row.date, category: row.category, amount: Number(row.amount) })
+  }
+  return rows
+}
diff --git a/src/format.js b/src/format.js
new file mode 100644
index 0000000..cdcc089
--- /dev/null
+++ b/src/format.js
@@ -0,0 +1,8 @@
+// 보고서 글: 분류 이름을 맞춰 쓰고 마지막 줄에 합계
+export function formatReport(summary) {
+  const width = Math.max(4, ...summary.map(([c]) => c.length))
+  const out = summary.map(([c, t]) => `${c.padEnd(width)} ${t.toLocaleString('en-US')}`)
+  const sum = summary.reduce((a, [, t]) => a + t, 0)
+  out.push(`${'합계'.padEnd(width)} ${sum.toLocaleString('en-US')}`)
+  return out.join('\n')
+}
