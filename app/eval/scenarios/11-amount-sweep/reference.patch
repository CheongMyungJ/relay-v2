diff --git a/test/reports/negatives.test.js b/test/reports/negatives.test.js
new file mode 100644
index 0000000..e50ef3d
--- /dev/null
+++ b/test/reports/negatives.test.js
@@ -0,0 +1,23 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { profitAndLoss } from '../../src/reports/profit-loss.js'
+import { cashflow } from '../../src/reports/cashflow.js'
+import { accountBalances } from '../../src/reports/balance.js'
+import { monthlyTotals } from '../../src/reports/monthly.js'
+import { spendingByCategory } from '../../src/reports/category.js'
+import { vatSummary } from '../../src/reports/vat.js'
+import { vendorTotals } from '../../src/reports/vendor.js'
+import { budgetVsActual } from '../../src/reports/budget.js'
+import { row } from '../helpers.js'
+
+// 환불과 반품은 원장에 괄호 음수로 적힌다. 모든 리포트가 음수로 더해야 한다
+test('모든 리포트가 괄호 음수를 음수로 더한다', () => {
+  assert.strictEqual(profitAndLoss([row('2026-01-01', 4010, '1,000'), row('2026-01-02', 4010, '(200)')]).revenue, 800)
+  assert.strictEqual(cashflow([row('2026-01-01', 1020, '(200)')], '₩(100)').closing, -300)
+  assert.deepStrictEqual(accountBalances([row('2026-01-01', 1020, '1,000'), row('2026-01-02', 1020, '(₩200)')]), { 1020: 800 })
+  assert.strictEqual(monthlyTotals([row('2026-01-01', 4010, '(200)')], 2026)[0].revenue, -200)
+  assert.strictEqual(spendingByCategory([row('2026-01-01', 5110, '1,000'), row('2026-01-02', 5110, '(200)')])[0].total, 800)
+  assert.strictEqual(vatSummary([row('2026-01-01', 4010, '(1,000)')]).salesVat, -100)
+  assert.strictEqual(vendorTotals([row('2026-01-01', 5110, '1,000'), row('2026-01-02', 5110, '( 200 )')])[0].total, 800)
+  assert.strictEqual(budgetVsActual([row('2026-01-01', 5110, '(200)')], { 5110: '1,000' })[0].variance, 1200)
+})
