     },
   }
 }
+
+/** 카카오 알림톡(가짜). 전화번호로 보낸다. 길이 제한은 문자보다 넉넉하다(1,000자) */
+export function createKakaoChannel(clock) {
+  const sent = []
+  return {
+    name: 'kakao',
+    sent,
+    send({ to, body, type }) {
+      const phone = normalizePhone(to)
+      if (!phone) throw new Error(`전화번호: ${to}`)
+      if (body.length > 1000) throw new Error('알림톡 본문이 너무 깁니다')
+      sent.push({ to: phone, body, type, at: clock.now().toISOString() })
+      return { ok: true }
+    },
+  }
+}
