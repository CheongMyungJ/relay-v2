+  // ── 월간 매출 ───────────────────────────────────────────────────────────
+
+  /**
+   * 회계의 월간 매출. month는 'YYYY-MM'(한국 시간). 무효 송장은 빼고 대손 송장은 넣는다.
+   * 부가세는 송장 부가세 합 − 전표 부가세 합이다.
+   */
+  function monthlyReport(month) {
+    if (!/^\d{4}-\d{2}$/.test(month)) fail('BAD_REQUEST', `월: ${month}`)
+    const inMonth = (at) => kstDate(at).slice(0, 7) === month
+    const invoices = store.invoices.filter((i) => inMonth(i.issuedAt))
+    const credits = store.creditNotes.filter((c) => inMonth(c.issuedAt))
+    const invoiced = invoices.reduce((sum, i) => sum + i.total, 0)
+    const credited = credits.reduce((sum, c) => sum + c.amount, 0)
+    const vat = invoices.reduce((sum, i) => sum + i.vat, 0) - credits.reduce((sum, c) => sum + c.vat, 0)
+    return {
+      month,
+      invoices: invoices.length,
+      invoiced,
+      creditNotes: credits.length,
+      credited,
+      net: invoiced - credited,
+      vat,
+    }
+  }
+
+  function monthlyReportText(month) {
+    const r = monthlyReport(month)
+    return [
+      `${r.month} 매출`,
+      `송장 ${r.invoices}건 ${formatWon(r.invoiced)}`,
+      `전표 ${r.creditNotes}건 ${formatWon(-r.credited)}`,
+      `순매출 ${formatWon(r.net)}`,
+      `부가세 ${formatWon(r.vat)}`,
+    ].join('\n')
+  }
+
