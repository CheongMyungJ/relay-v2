diff --git a/src/customers/customers.js b/src/customers/customers.js
index 10f8d95..3599b33 100644
--- a/src/customers/customers.js
+++ b/src/customers/customers.js
@@ -15,6 +15,14 @@ export function normalizePhone(raw) {
     : `${digits.slice(0, 3)}-${digits.slice(3, 7)}-${digits.slice(7)}`
 }
 
+/** 사람이 보는 곳(내보낸 파일, 상담 화면, 알림 본문)의 전화번호: 010-****-5678 */
+export function maskPhone(phone) {
+  const normalized = normalizePhone(phone)
+  if (!normalized) return ''
+  const [head, , tail] = normalized.split('-')
+  return `${head}-****-${tail}`
+}
