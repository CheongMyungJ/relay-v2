diff --git a/src/shared/tax.js b/src/shared/tax.js
new file mode 100644
index 0000000..75fb63e
--- /dev/null
+++ b/src/shared/tax.js
@@ -0,0 +1,9 @@
+// 부가세. 가격은 부가세 포함이므로 금액의 1/11이 부가세다. 면세는 0, 원 미만은 버린다.
+// 주문(orders/pricing.js)과 청구(billing/invoices.js)가 같이 쓴다.
+
+export const TAX_CLASSES = ['standard', 'exempt']
+
+export function lineVat(amount, taxClass = 'standard') {
+  if (taxClass === 'exempt') return 0
+  return Math.floor(amount / 11)
+}
diff --git a/test/tax.test.js b/test/tax.test.js
new file mode 100644
index 0000000..a609234
--- /dev/null
+++ b/test/tax.test.js
@@ -0,0 +1,9 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { lineVat } from '../src/shared/tax.js'
+
+test('부가세 포함 금액의 부가세', () => {
+  assert.equal(lineVat(12000), 1090)
+  assert.equal(lineVat(3000), 272)
+  assert.equal(lineVat(33000, 'exempt'), 0)
+})
