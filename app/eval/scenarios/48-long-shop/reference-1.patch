+  function cancelLines(orderId, items, { reason = 'customer' } = {}) {
+    const order = load(orderId)
+    if (order.status !== 'placed' && order.status !== 'paid') {
+      fail('CANNOT_CANCEL', `취소할 수 없는 주문: ${order.number} (${order.status})`)
+    }
+    if (!Array.isArray(items) || items.length === 0) fail('BAD_QTY', '취소할 상품이 없습니다')
+    const wanted = new Map()
+    for (const it of items) {
+      if (!Number.isInteger(it.qty) || it.qty <= 0) fail('BAD_QTY', `수량: ${it.qty}`)
+      wanted.set(it.sku, (wanted.get(it.sku) ?? 0) + it.qty)
+    }
