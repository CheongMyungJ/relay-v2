+    let refund = 0
+    if (order.status === 'paid') {
+      refund = amount - discountShare(order, amount)
+      if (refund > 0) payments.refund(order.paymentRef, refund)
+      order.refunded += refund
+    }
+    order.history.push({ status: order.status, at: clock.now().toISOString(), reason, cancelled: lines })
+    bus.emit('order.lines_cancelled', { order: snapshot(order), lines, refund, reason })
