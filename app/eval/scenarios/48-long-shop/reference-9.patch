+  /**
+   * 예전 주문을 지금 가격으로 장바구니에 다시 담는다. 취소한 수량은 빼고, 판매 중지된 상품은 빼고, 재고가 모자라면 있는
+   * 만큼만 담는다. 뺐거나 덜 담은 상품은 skipped에 까닭과 함께 둔다. 재고는 잡지 않는다(주문할 때 잡는다).
+   * @returns {{ cart: ReturnType<typeof createCart>, skipped: { sku: string, reason: string, wanted: number, added: number }[] }}
+   */
+  function reorder(orderId) {
+    const order = load(orderId)
+    const cart = createCart(catalog)
+    const skipped = []
+    for (const line of order.lines) {
+      const wanted = line.qty - line.cancelledQty
+      if (wanted <= 0) continue
+      const p = catalog.find(line.sku)
+      if (!p || !p.active) {
+        skipped.push({ sku: line.sku, reason: 'discontinued', wanted, added: 0 })
+        continue
+      }
+      const added = Math.min(wanted, p.stock)
+      if (added > 0) cart.add(line.sku, added)
+      if (added < wanted) skipped.push({ sku: line.sku, reason: added === 0 ? 'out_of_stock' : 'short', wanted, added })
+    }
+    return { cart, skipped }
+  }
+
