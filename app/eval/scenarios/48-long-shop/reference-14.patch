diff --git a/test/status.test.js b/test/status.test.js
new file mode 100644
index 0000000..5fc3a21
--- /dev/null
+++ b/test/status.test.js
@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { canTransition } from '../src/orders/status.js'
+
+test('주문 상태 바꾸기 표', () => {
+  assert.equal(canTransition('placed', 'paid'), true)
+  assert.equal(canTransition('paid', 'cancelled'), true)
+  assert.equal(canTransition('shipped', 'cancelled'), false)
+  assert.equal(canTransition('cancelled', 'paid'), false)
+  assert.equal(canTransition('delivered', 'shipped'), false)
+})
