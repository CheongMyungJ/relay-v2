diff --git a/src/orders/status.js b/src/orders/status.js
new file mode 100644
index 0000000..3bcb179
--- /dev/null
+++ b/src/orders/status.js
@@ -0,0 +1,26 @@
+// 주문 상태와 허용하는 바꾸기. 주문의 상태는 이 표를 거쳐서만 바뀐다(orders.js의 moveTo).
+import { fail } from '../shared/errors.js'
+
+export const STATUSES = ['placed', 'paid', 'shipped', 'delivered', 'cancelled']
+
+const NEXT = {
+  placed: ['paid', 'cancelled'],
+  paid: ['shipped', 'cancelled'],
+  shipped: ['delivered'],
+  delivered: [],
+  cancelled: [],
+}
+
+export function canTransition(from, to) {
+  return (NEXT[from] ?? []).includes(to)
+}
+
+/** 바꿀 수 없으면 BAD_STATUS */
+export function assertTransition(order, to) {
+  if (!canTransition(order.status, to)) {
+    fail('BAD_STATUS', `주문 ${order.number}: ${order.status}에서 ${to}(으)로 바꿀 수 없습니다`, {
+      from: order.status,
+      to,
+    })
+  }
+}
