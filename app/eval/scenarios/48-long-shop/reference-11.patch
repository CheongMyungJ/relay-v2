+  /** 상담원이 보는 주문 요약. 전화번호는 가린다 */
+  function supportSummary(orderId) {
+    const order = load(orderId)
+    const customer = customers.get(order.customerId)
+    const amounts = [`상품 ${formatWon(order.itemsTotal)}`]
+    if (order.discount > 0) amounts.push(`할인 ${formatWon(-order.discount)}`)
+    amounts.push(`배송비 ${formatWon(order.shipping)}`, `합계 ${formatWon(order.total)}`)
+    const rows = [
+      `주문 ${order.number} · ${STATUS_LABEL[order.status] ?? order.status}`,
+      `고객 ${customer.name} · ${customer.phone ? maskPhone(customer.phone) : '연락처 없음'}`,
+      amounts.join(' · '),
+    ]
+    if (order.refunded > 0) rows.push(`환불 ${formatWon(order.refunded)}`)
+    return rows.join('\n')
+  }
