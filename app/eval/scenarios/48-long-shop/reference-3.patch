+  shop.orders.cancelLines(order.id, [{ sku: 'MUG', qty: 1 }])
+  assert.equal(shop.channels.sms.sent.at(-1).body, '[샵] 주문 A-1001 일부 취소, 환불 12,000원')
+  shop.orders.cancelOrder(order.id)
+  assert.match(shop.channels.email.sent.at(-1).body, /환불 금액: 33,000원/)
