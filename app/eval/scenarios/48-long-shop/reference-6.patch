diff --git a/test/notifier.test.js b/test/notifier.test.js
index 2705fe7..d666ff1 100644
--- a/test/notifier.test.js
+++ b/test/notifier.test.js
@@ -109,3 +109,10 @@ test('환불 알림은 금액을 알리고 방해 금지 시간에도 바로 간
   assert.match(shop.channels.email.sent.at(-1).body, /환불 금액: 33,000원/)
   assert.deepEqual(shop.notifier.pending().map((m) => m.type), ['order.placed'])
 })
+
+test('영어 알림의 금액은 KRW', () => {
+  const shop = setup('2026-03-02T05:00:00Z')
+  shop.orders.placeOrder({ customerId: 'u-2', cart: cartOf(shop, [['MUG', 1]]) })
+  assert.match(shop.channels.email.sent[0].body, /Amount due: KRW 15,000/)
+  assert.equal(shop.channels.sms.sent[0].body, '[Shop] Order A-1001 received, KRW 15,000')
+})
