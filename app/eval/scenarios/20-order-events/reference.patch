+import { test } from 'node:test'
+import assert from 'node:assert'
+import { balance, listOrders, placeOrder } from '../src/app.js'
+
+test('메일 주소가 틀리면 오류를 던지고 주문과 적립은 남는다 (지금 동작)', () => {
+  assert.throws(() => placeOrder({ customer: 'p', email: 'bad', items: [{ price: 100, qty: 1 }] }), /invalid address/)
+  assert.strictEqual(listOrders().length, 1)
+  assert.strictEqual(balance('p'), 1)
+})
