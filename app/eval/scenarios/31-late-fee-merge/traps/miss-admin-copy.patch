diff --git a/src/rentals/late-fee.js b/src/rentals/late-fee.js
new file mode 100644
index 0000000..e0478dc
--- /dev/null
+++ b/src/rentals/late-fee.js
@@ -0,0 +1,26 @@
+import { daysBetween } from '../util/dates.js'
+
+// 연체료 규칙. 규칙이 바뀌면 여기만 고친다
+export const LATE_FEE_RULE = {
+  rate: 0.5, // 일 대여료에 곱하는 비율
+  graceDays: 1, // 이만큼 늦은 것은 받지 않는다
+}
+
+/** 반납 예정일에서 on까지 늦은 날 수. 늦지 않았으면 0 이하 */
+export function overdueDays(rental, on) {
+  return daysBetween(rental.dueDate, on)
+}
+
+/**
+ * days일 늦은 대여의 연체료(원).
+ * - grace: false면 유예 없이 계산한다(연체 안내 문자는 일부러 유예 없는 금액을 보여 준다)
+ * - round: 원 단위 처리. 고객에게 받는 돈은 반올림, 파트너 정산은 내림(파트너 계약)
+ * - uncappedWithoutDeposit: 보증금이 없는 옛 계약(deposit null)은 상한 없이 받는다(반납)
+ */
+export function lateFee(rental, days, { grace = true, round = Math.round, uncappedWithoutDeposit = false } = {}) {
+  if (days < 1) return 0
+  if (grace && days <= LATE_FEE_RULE.graceDays) return 0
+  const fee = round(rental.dailyRate * days * LATE_FEE_RULE.rate)
+  const cap = rental.deposit == null && uncappedWithoutDeposit ? Infinity : rental.deposit
+  return Math.min(fee, cap)
+}
