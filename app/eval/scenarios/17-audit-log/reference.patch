new file mode 100644
index 0000000..a2097d4
--- /dev/null
+++ b/src/audit.js
@@ -0,0 +1,25 @@
+// 감사 로그. 성공한 사용자 작업만 기록하고, 이메일은 앞 한 글자만 두고 가린다(개인정보 규정)
+
+export function maskEmail(email) {
+  const [local, domain] = email.split('@')
+  return `${local.slice(0, 1)}***@${domain}`
+}
+
+export function createAuditLog() {
+  const entries = []
+  return {
+    record(entry) {
+      entries.push({ ...entry, detail: { ...entry.detail } })
+    },
+    // 최신순. 같은 시각이면 나중에 기록된 것이 먼저다. since는 그 시각을 포함한다
+    list({ userId, since } = {}) {
+      const from = since === undefined ? null : new Date(since).getTime()
+      return entries
+        .map((e, i) => ({ e, i }))
+        .filter(({ e }) => userId === undefined || e.userId === userId)
+        .filter(({ e }) => from === null || new Date(e.at).getTime() >= from)
+        .sort((a, b) => b.e.at.localeCompare(a.e.at) || b.i - a.i)
+        .map(({ e }) => ({ ...e, detail: { ...e.detail } }))
+    },
+  }
+}
