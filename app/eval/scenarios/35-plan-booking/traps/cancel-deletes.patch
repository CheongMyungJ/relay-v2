--- /dev/null
+++ b/test/cancel.test.js
@@ -0,0 +1,12 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { cancelBooking, createBooking, listBookings } from '../src/booking.js'
+import { createStore } from '../src/store.js'
+
+test('취소한 시간에 다시 예약할 수 있다', () => {
+  const s = createStore()
+  const b = createBooking(s, { room: 'A', start: '2026-11-02T10:00', end: '2026-11-02T11:00', by: 'kim' })
+  cancelBooking(s, b.id, { now: '2026-11-01T09:00' })
+  createBooking(s, { room: 'A', start: '2026-11-02T10:00', end: '2026-11-02T11:00', by: 'lee' })
+  assert.equal(listBookings(s, 'A').length, 2)
+})
