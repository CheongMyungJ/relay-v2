index 8e051d1..4ab0077 100644
--- a/src/booking.js
+++ b/src/booking.js
@@ -36,3 +36,13 @@ export function listBookings(store, room) {
     .filter((b) => b.room === room)
     .sort((a, b) => toMinutes(a.start) - toMinutes(b.start))
 }
+
+// B3: 취소한 예약은 남기고 상태만 바꾼다. 겹침 판정은 active만 본다. 이미 시작한 예약은 취소할 수 없다(운영팀)
+export function cancelBooking(store, id, { now }) {
+  const booking = store.bookings.find((b) => b.id === id)
+  if (!booking) throw fail('NOT_FOUND', `예약 ${id}가 없다`)
+  if (toMinutes(now) >= toMinutes(booking.start))
+    throw fail('ALREADY_STARTED', '이미 시작한 예약은 취소할 수 없다')
+  booking.status = 'cancelled'
+  return booking
+}
