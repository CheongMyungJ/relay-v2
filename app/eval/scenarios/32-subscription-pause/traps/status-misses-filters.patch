--- a/src/subscriptions/service.js
+++ b/src/subscriptions/service.js
@@ -1,6 +1,7 @@
 import { log } from '../log.js'
 import { getMember } from '../members/members.js'
 import { getPlan } from '../plans/plans.js'
+import { addDays, daysBetween } from '../util/dates.js'
 import { RuleError } from '../util/errors.js'
 import { getSubscription, listSubscriptions, nextSubscriptionId, saveSubscription } from './store.js'
 
@@ -61,3 +62,42 @@ export function cancelSubscription(id, today, reason = '') {
   log.info('cancelled', { id, reason })
   return sub
 }
+
+/** 일시정지는 한 번에 이 날 수까지다. 지나면 해지가 아니라 자동으로 재개된다 */
+export const MAX_PAUSE_DAYS = 28
+
+/** 일시정지. 정지 중에는 결제, 배송, 결제 안내가 모두 멈춘다. 연간 플랜은 정지할 수 없다(연간 할인가) */
+export function pauseSubscription(id, today) {
+  const sub = getSubscription(id)
+  if (sub.status !== 'active') throw new RuleError('활성 구독만 정지할 수 있음')
+  if (getPlan(sub.planId).period === 'annual') throw new RuleError('연간 플랜은 일시정지할 수 없음')
+  sub.status = 'paused'
+  sub.pausedOn = today
+  saveSubscription(sub)
+  log.info('paused', { id, on: today })
+  return sub
+}
+
+/** 재개. 이미 낸 기간을 다 쓰게 다음 결제일을 정지한 날 수만큼(최대 MAX_PAUSE_DAYS) 뒤로 민다 */
+export function resumeSubscription(id, today) {
+  const sub = getSubscription(id)
+  if (sub.status !== 'paused') throw new RuleError('정지된 구독이 아님')
+  const days = Math.min(daysBetween(sub.pausedOn, today), MAX_PAUSE_DAYS)
+  sub.nextBillingOn = addDays(sub.nextBillingOn, days)
+  sub.status = 'active'
+  sub.pausedOn = null
+  saveSubscription(sub)
+  log.info('resumed', { id, on: today, days })
+  return sub
+}
+
+/** 정지한 지 MAX_PAUSE_DAYS가 지난 구독을 재개한다. 하루 작업이 맨 먼저 부른다 */
+export function resumeExpiredPauses(today) {
+  const resumed = []
+  for (const s of listSubscriptions()) {
+    if (s.status !== 'paused' || daysBetween(s.pausedOn, today) < MAX_PAUSE_DAYS) continue
+    resumeSubscription(s.id, addDays(s.pausedOn, MAX_PAUSE_DAYS))
+    resumed.push(s.id)
+  }
+  return resumed
+}
