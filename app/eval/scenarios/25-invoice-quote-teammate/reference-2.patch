diff --git a/src/invoice/credit-note.js b/src/invoice/credit-note.js
index 6e6fe7d..8f6de6f 100644
--- a/src/invoice/credit-note.js
+++ b/src/invoice/credit-note.js
@@ -80,14 +80,20 @@ export function creditLineAmounts(note) {
   })
 }
 
+// 돌려받는 줄 하나의 부가세. 회계 규정: 청구서처럼 줄마다 원 단위 버림
+export function returnedLineVat(net, ratePercent = VAT_RATE_PERCENT) {
+  return Math.floor((net * ratePercent) / 100)
+}
+
 // 반품 전표의 돌려주는 금액
-//   supply: 공급가액, taxable / exempt: 과세분 / 면세분, vat: 부가세, total: 돌려주는 합계
+//   supply: 공급가액, taxable / exempt: 과세분 / 면세분, total: 돌려주는 합계
+//   vat: 부가세. 과세 줄마다 할인 뒤 금액의 부가세를 버림해 더한다(합계에서 다시 반올림하지 않는다)
 export function creditTotals(note) {
   const rows = creditLineAmounts(note)
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = note.zeroRated ? 0 : sumWon(rows.filter((r) => r.taxable).map((r) => returnedLineVat(r.net)))
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
