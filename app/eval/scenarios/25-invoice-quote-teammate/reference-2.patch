@@ -81,3 +81,29 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 부가세는 돌려받는 줄마다 버림해 더한다', () => {
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-0388',
+      lines: [
+        { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 8, discount: { amount: 1500 } },
+        { sku: 'OF-2150', name: '형광펜 5색', unitPrice: 2150, qty: 6, discount: { percent: 5 } },
+        { sku: 'OF-0415', name: '지우개', unitPrice: 415, qty: 9 },
+      ],
+    }),
+    { number: 'INV-2047', issueDate: '2026-09-24' },
+  )
+  const cn = createCreditNote(inv2, {
+    number: 'CN-0112',
+    issueDate: '2026-10-06',
+    reason: '파손 및 주문 착오',
+    returns: [
+      { sku: 'OF-1342', qty: 8 },
+      { sku: 'OF-2150', qty: 3 },
+      { sku: 'OF-0415', qty: 5 },
+    ],
+  })
+  assert.strictEqual(cn.totals.vat, 923 + 612 + 207)
+  assert.strictEqual(cn.totals.total, 19180)
+})
