diff --git a/src/workdays.js b/src/workdays.js
index 9827d99..98b93b9 100644
--- a/src/workdays.js
+++ b/src/workdays.js
@@ -4,3 +4,16 @@ export function isWeekend(date) {
   const day = new Date(`${date}T00:00:00Z`).getUTCDay()
   return day === 0 || day === 6
 }
+
+const DAY = 24 * 60 * 60 * 1000
+export function workdaysBetween(start, end, holidays = []) {
+  let count = 0
+  for (let t = Date.parse(`${start}T00:00:00Z`); t < Date.parse(`${end}T00:00:00Z`); t += DAY) {
+    const d = new Date(t).toISOString().slice(0, 10)
+    if (!isWeekend(d) && !holidays.includes(d)) count++
+  }
+  return count
+}
+export function addWorkdays(date) {
+  return date
+}
