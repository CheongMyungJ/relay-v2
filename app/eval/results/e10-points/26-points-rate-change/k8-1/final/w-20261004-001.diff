 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액: 상품 금액 - 쿠폰 할인 - 사용한 포인트. 배송비는 넣지 않는다 */
+export function earnBase({ goods, coupon, pointsUsed }) {
+  return goods - coupon - pointsUsed
+}
+
+/** 기준 금액의 POINT_RATE_PERCENT%. 1P 미만은 버린다 */
+export function earnOn(base) {
+  return Math.floor((base * POINT_RATE_PERCENT) / 100)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnOn(earnBase(order.amounts))
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..7c93172
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,109 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+const gift = { ...base, recipient: { name: '김하늘', phone: '010-1234-5678' } }
+
+test('적립: O-1042는 쿠폰과 사용 포인트를 뺀 23,770원의 1%, 배송비 제외 237P', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [
+      { sku: 'TE-0410', unitPrice: 8900, qty: 2 },
+      { sku: 'SN-1135', unitPrice: 3490, qty: 3 },
+    ],
+    coupon: { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 },
+    pointsUsed: 1500,
+  })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('적립: 배송비가 있어도 없어도 같은 기준 금액이다', () => {
+  const withShip = createOrder({ ...base, number: 'O-0010', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  const noShip = createOrder({ ...base, number: 'O-0011', lines: [{ sku: 'A', unitPrice: 30000, qty: 1 }] })
+  assert.strictEqual(withShip.amounts.shipping, 3000)
+  assert.strictEqual(withShip.points.earned, 100)
+  assert.strictEqual(noShip.points.earned, 300)
+})
+
+test('적립: 1P 미만은 반올림하지 않고 버린다', () => {
+  const o = createOrder({ ...base, number: 'O-0012', lines: [{ sku: 'A', unitPrice: 12990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 129)
+})
+
+test('적립: 선물하기 주문도 같은 규정', () => {
+  const g = createGiftOrder({
+    ...gift,
+    number: 'G-0213',
+    lines: [
+      { sku: 'HN-0120', unitPrice: 15900, qty: 1 },
+      { sku: 'JM-0332', unitPrice: 4480, qty: 2 },
+    ],
+    coupon: { code: 'GIFT2000', amount: 2000 },
+    pointsUsed: 1000,
+  })
+  // 24,860 - 2,000 - 1,000 = 21,860 → 218P (배송비 3,000 제외)
+  assert.strictEqual(g.points.earned, 218)
+})
+
+const stored = createOrder({
+  ...base,
+  number: 'O-0200',
+  lines: [
+    { sku: 'A', unitPrice: 5990, qty: 3 },
+    { sku: 'B', unitPrice: 4010, qty: 3 },
+  ],
+  coupon: { code: 'C', amount: 3000 },
+  pointsUsed: 1500,
+})
+
+test('회수: 한 건 환불은 남은 주문의 적립 규정과 맞는다', () => {
+  const goods = stored.amounts.goods
+  const r = createRefund(stored, { number: 'R-0001', items: [{ sku: 'B', qty: 1 }] })
+  const after = Math.floor((goods - 4010 - 3000 - 1500) / 100)
+  assert.strictEqual(r.pointsRecovered, stored.points.earned - after)
+})
+
+test('회수: 여러 번 부분 환불해도 합계가 저장된 적립액을 넘지 않는다', () => {
+  const steps = [
+    [{ sku: 'B', qty: 1 }],
+    [{ sku: 'B', qty: 1 }],
+    [{ sku: 'B', qty: 1 }],
+    [{ sku: 'A', qty: 1 }],
+  ]
+  const already = []
+  let total = 0
+  steps.forEach((items, i) => {
+    let r
+    try {
+      r = createRefund(stored, { number: `R-000${i + 1}`, items, alreadyRefunded: already })
+    } catch (e) {
+      assert.match(e.message, /전체 취소/)
+      return
+    }
+    total += r.pointsRecovered
+    assert.ok(total <= stored.points.earned, `${i + 1}번째 환불 뒤 회수 합계 ${total} > ${stored.points.earned}`)
+    for (const it of items) {
+      const f = already.find((a) => a.sku === it.sku)
+      if (f) f.qty += it.qty
+      else already.push({ ...it })
+    }
+  })
+  assert.ok(total > 0)
+})
+
+test('회수: 1원 단위 환불을 쪼개도 합계가 저장된 적립액 이하', () => {
+  const o = createOrder({ ...base, number: 'O-0201', lines: [{ sku: 'A', unitPrice: 1050, qty: 40 }] })
+  const already = []
+  let total = 0
+  for (let i = 0; i < 39; i++) {
+    const r = createRefund(o, { number: 'R-0100', items: [{ sku: 'A', qty: 1 }], alreadyRefunded: already.length ? [{ sku: 'A', qty: already.length }] : [] })
+    total += r.pointsRecovered
+    already.push(1)
+    assert.ok(total <= o.points.earned)
+  }
+})
