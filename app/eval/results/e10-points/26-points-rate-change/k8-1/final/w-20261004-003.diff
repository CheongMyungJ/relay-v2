diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..5bb88f0 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,19 @@
-import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { EARN_RATE_PERCENT } from '../config.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+// 적립 규정: (상품 − 쿠폰 − 사용 포인트)의 EARN_RATE_PERCENT%, 배송비 제외, 1P 미만 버림.
+// 일반 주문과 선물하기가 모두 이것을 쓴다
+
+/** 적립 기준 금액. 배송비는 넣지 않는다 */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 기준 금액의 적립률%. 1P 미만은 버린다 */
+export function earnOn(base) {
+  return Math.floor((base * EARN_RATE_PERCENT) / 100)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnOn(earnBase(order.amounts))
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..0e1ac71
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,45 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createOrder } from '../src/orders/order.js'
+import { createRefund } from '../src/orders/refund.js'
+import { earnPoints } from '../src/points/earn.js'
+
+const o1107 = JSON.parse(fs.readFileSync(new URL('../examples/O-1107.json', import.meta.url), 'utf8'))
+
+test('O-1107은 상품−쿠폰−포인트의 2%, 1P 미만 버림으로 486P 적립', () => {
+  const o = createOrder(o1107)
+  assert.strictEqual(o.amounts.total, 27330)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('배송비는 적립 기준에서 제외한다', () => {
+  const o = createOrder({ customerId: 'U-1', number: 'O-0003', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 400)
+})
+
+test('선물하기도 같은 규정으로 2% 적립', () => {
+  const g = createGiftOrder({
+    ...o1107,
+    number: 'G-0001',
+    recipient: { name: '김하늘', phone: '010-1234-5678' },
+  })
+  assert.strictEqual(g.points.earned, 486)
+})
+
+test('earnPoints는 저장된 주문 금액으로 계산한다', () => {
+  assert.strictEqual(earnPoints({ amounts: { goods: 28270, coupon: 3000, pointsUsed: 1500, shipping: 0, total: 23770 } }), 475)
+})
+
+test('부분 환불 회수 포인트는 적립률 변경과 무관하게 현행(1%)이다', () => {
+  const order = {
+    number: 'O-0100',
+    lines: [{ sku: 'A', unitPrice: 25000, qty: 2 }],
+    amounts: { goods: 50000, coupon: 0, shipping: 0, pointsUsed: 0, total: 50000 },
+    points: { used: 0, earned: 1000 },
+  }
+  const r = createRefund(order, { number: 'R-0001', items: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 250)
+})
