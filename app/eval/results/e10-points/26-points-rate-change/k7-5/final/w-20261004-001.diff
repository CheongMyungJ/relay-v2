-/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다) */
+/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다). 일반 주문과 같은 기준 */
 export function giftPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnPoints(order)
 }
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..05aebd2 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,11 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액: 배송비를 뺀 금액(상품 − 쿠폰 − 사용 포인트) */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 주문의 적립 포인트. 배송비를 뺀 금액의 POINT_RATE_PERCENT%를 원 단위로 내린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return Math.floor((earnBase(order.amounts) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..24a31f3
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,35 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { cancelOrder } from '../src/orders/refund.js'
+
+const load = (n) => JSON.parse(readFileSync(new URL(`../examples/${n}.json`, import.meta.url)))
+
+test('적립은 배송비를 뺀 금액의 1% 내림 (O-1042: 237P)', () => {
+  const o = createOrder(load('O-1042'))
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('무료 배송 주문도 같은 기준', () => {
+  const o = createOrder({ number: 'O-0003', customerId: 'U-1', lines: [{ sku: 'A', unitPrice: 33999, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 339)
+})
+
+test('선물하기 주문도 배송비를 뺀 금액의 1% 내림', () => {
+  const g = createGiftOrder({
+    number: 'G-0004', customerId: 'U-1', recipient: { name: '김하늘', phone: '010-1234-5678' },
+    lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }], pointsUsed: 1000,
+  })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 190)
+})
+
+test('전체 취소는 저장된 적립 값을 그대로 돌려준다', () => {
+  const o = createOrder(load('O-1042'))
+  o.points.earned = 268
+  assert.strictEqual(cancelOrder(o).pointsRecovered, 268)
+})
