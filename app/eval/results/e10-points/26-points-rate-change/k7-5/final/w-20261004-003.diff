+  return floorPercentOf(earnBase(order), POINT_RATE_PERCENT)
 }
diff --git a/tree/test/earn-rate.test.js b/tree/test/earn-rate.test.js
new file mode 100644
index 0000000..4702261
--- /dev/null
+++ b/tree/test/earn-rate.test.js
@@ -0,0 +1,46 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const o1107 = JSON.parse(readFileSync(new URL('../examples/O-1107.json', import.meta.url), 'utf8'))
+
+test('O-1107: 적립은 (상품−쿠폰−사용 포인트)의 2% 내림 = 486P, 배송비 제외', () => {
+  const o = createOrder(o1107)
+  assert.strictEqual(o.amounts.total, 27330)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('선물하기 주문도 같은 기준: 배송비 제외, 2%, 내림', () => {
+  const g = createGiftOrder({
+    number: 'G-1107',
+    customerId: 'U-1',
+    recipient: { name: '김하늘', phone: '010-1234-5678' },
+    lines: o1107.lines,
+    coupon: o1107.coupon,
+    pointsUsed: o1107.pointsUsed,
+  })
+  assert.strictEqual(g.points.earned, 486)
+})
+
+test('1P 미만은 반올림하지 않고 버린다', () => {
+  // 상품 10,001 − 0 = 10,001 → 2% = 200.02 → 200 ; 배송비 3,000 제외
+  const o = createOrder({ number: 'O-0003', customerId: 'U-1', lines: [{ sku: 'A', unitPrice: 10001, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 200)
+  // 상품 10,075 → 201.5 → 201 (반올림이면 202)
+  const p = createOrder({ number: 'O-0004', customerId: 'U-1', lines: [{ sku: 'A', unitPrice: 10075, qty: 1 }] })
+  assert.strictEqual(p.points.earned, 201)
+})
+
+test('부분 환불 회수 포인트는 적립률을 바꿔도 이전과 같다(1% 반올림)', () => {
+  const stored = {
+    number: 'O-0100',
+    lines: [{ sku: 'A', unitPrice: 13130, qty: 1 }, { sku: 'B', unitPrice: 20000, qty: 1 }],
+    amounts: { goods: 33130, coupon: 0, shipping: 0, pointsUsed: 0, total: 33130 },
+    points: { used: 0, earned: 662 },
+  }
+  const r = createRefund(stored, { number: 'R-0001', items: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 131)
+})
