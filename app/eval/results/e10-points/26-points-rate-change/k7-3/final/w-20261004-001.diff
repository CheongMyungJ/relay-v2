diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..abd0b43 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 결제 금액의 POINT_RATE_PERCENT%, 원 단위 미만은 버린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const base = order.amounts.total - order.amounts.shipping
+  return Math.floor((base * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..37c60e0
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,39 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { earnPoints } from '../src/points/earn.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('O-1042: 배송비를 뺀 결제 금액 23,770원의 1%를 버림해 237P', () => {
+  const input = JSON.parse(fs.readFileSync(new URL('../examples/O-1042.json', import.meta.url), 'utf8'))
+  assert.strictEqual(createOrder(input).points.earned, 237)
+})
+
+test('배송비는 적립 기준에서 빠진다', () => {
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 100)
+})
+
+test('쿠폰 할인과 사용 포인트는 적립 기준에서 빠진다', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-0004',
+    lines: [{ sku: 'A', unitPrice: 40000, qty: 1 }],
+    coupon: { code: 'C', amount: 5000 },
+    pointsUsed: 2000,
+  })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 330)
+})
+
+test('적립은 원 단위 미만을 버린다', () => {
+  assert.strictEqual(earnPoints({ amounts: { total: 12999, shipping: 0 } }), 129)
+  assert.strictEqual(earnPoints({ amounts: { total: 12999 + 3000, shipping: 3000 } }), 129)
+})
+
+test('배송비 외 금액이 0이면 적립 0', () => {
+  assert.strictEqual(earnPoints({ amounts: { total: 3000, shipping: 3000 } }), 0)
+})
diff --git a/base/test/refund.test.js b/tree/test/refund.test.js
index de6f8a4..286f02b 100644
--- a/base/test/refund.test.js
+++ b/tree/test/refund.test.js
@@ -30,3 +30,43 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+// O-1042: 상품 28,270 - 쿠폰 3,000 - 포인트 1,500 + 배송비 3,000, 적립 237P(저장값)
+const o1042 = {
+  number: 'O-1042',
+  customerId: 'U-20417',
+  lines: [
+    { sku: 'TE-0410', name: 'T', unitPrice: 8900, qty: 2 },
+    { sku: 'SN-1135', name: 'S', unitPrice: 3490, qty: 3 },
+  ],
+  coupon: { code: 'AUTUMN3000', amount: 3000 },
+  amounts: { goods: 28270, coupon: 3000, shipping: 3000, pointsUsed: 1500, total: 26770 },
+  points: { used: 1500, earned: 237 },
+}
+
+test('부분 환불 회수는 원 단위 미만을 버린다', () => {
+  const r = createRefund(o1042, { number: 'R-0003', items: [{ sku: 'SN-1135', qty: 3 }] })
+  assert.strictEqual(r.refundAmount, 10470)
+  assert.strictEqual(r.pointsRecovered, 104)
+})
+
+test('부분 환불을 나눠 해도 회수 합계가 적립한 포인트를 넘지 않는다', () => {
+  const a = createRefund(o1042, { number: 'R-0004', items: [{ sku: 'TE-0410', qty: 2 }] })
+  const b = createRefund(o1042, {
+    number: 'R-0005',
+    items: [{ sku: 'SN-1135', qty: 1 }],
+    alreadyRefunded: [{ sku: 'TE-0410', qty: 2 }],
+  })
+  assert.strictEqual(a.pointsRecovered + b.pointsRecovered, 178 + 34)
+  assert.ok(a.pointsRecovered + b.pointsRecovered <= o1042.points.earned)
+})
+
+test('회수는 저장된 적립 포인트보다 많을 수 없다', () => {
+  const small = { ...o1042, points: { used: 1500, earned: 100 } }
+  const r = createRefund(small, { number: 'R-0006', items: [{ sku: 'TE-0410', qty: 2 }] })
+  assert.strictEqual(r.pointsRecovered, 100)
+})
+
+test('O-1042 전체 취소는 저장된 적립 237P를 그대로 회수한다', () => {
+  assert.strictEqual(cancelOrder(o1042).pointsRecovered, 237)
+})
