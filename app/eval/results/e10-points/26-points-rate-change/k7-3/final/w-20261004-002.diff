+++ b/tree/test/refund.test.js
@@ -30,3 +30,57 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+test('부분 환불 회수: 저장된 적립 - 남은 상품 기준 재계산 적립(버림)', () => {
+  const o = {
+    number: 'O-1077',
+    lines: [
+      { sku: 'KT', name: 'KT', unitPrice: 12900, qty: 2 },
+      { sku: 'TW', name: 'TW', unitPrice: 8380, qty: 1 },
+      { sku: 'SP', name: 'SP', unitPrice: 6565, qty: 2 },
+    ],
+    amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+    points: { used: 2000, earned: 403 },
+  }
+  const r = createRefund(o, { number: 'R-0311', items: [{ sku: 'SP', qty: 2 }] })
+  assert.strictEqual(r.refundAmount, 13130)
+  assert.strictEqual(r.pointsRecovered, 132)
+})
+
+test('나눠 환불해도 회수 합계는 한 번에 환불한 것과 같다', () => {
+  const o = {
+    number: 'O-1077',
+    lines: [
+      { sku: 'KT', name: 'KT', unitPrice: 12900, qty: 2 },
+      { sku: 'TW', name: 'TW', unitPrice: 8380, qty: 1 },
+      { sku: 'SP', name: 'SP', unitPrice: 6565, qty: 2 },
+    ],
+    amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+    points: { used: 2000, earned: 403 },
+  }
+  const a = createRefund(o, { number: 'R-0001', items: [{ sku: 'SP', qty: 1 }] })
+  const b = createRefund(o, { number: 'R-0002', items: [{ sku: 'SP', qty: 1 }], alreadyRefunded: [{ sku: 'SP', qty: 1 }] })
+  assert.strictEqual(a.pointsRecovered + b.pointsRecovered, 132)
+})
+
+test('세 번에 나눠 환불해도 회수 합계는 저장 적립 - 남은 상품 기준 재계산 적립이다', () => {
+  const o = {
+    number: 'O-1077',
+    lines: [
+      { sku: 'KT', name: 'KT', unitPrice: 12900, qty: 2 },
+      { sku: 'TW', name: 'TW', unitPrice: 8380, qty: 1 },
+      { sku: 'SP', name: 'SP', unitPrice: 6565, qty: 2 },
+    ],
+    amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+    points: { used: 2000, earned: 403 },
+  }
+  const a = createRefund(o, { number: 'R-0001', items: [{ sku: 'SP', qty: 1 }] })
+  const b = createRefund(o, { number: 'R-0002', items: [{ sku: 'SP', qty: 1 }], alreadyRefunded: [{ sku: 'SP', qty: 1 }] })
+  const c = createRefund(o, {
+    number: 'R-0003',
+    items: [{ sku: 'TW', qty: 1 }],
+    alreadyRefunded: [{ sku: 'SP', qty: 2 }],
+  })
+  // 남은 상품 47,310 - 13,130 - 8,380 = 25,800 → (25,800 - 7,000) × 1% = 188 → 403 - 188 = 215 (매번 반올림하면 216)
+  assert.strictEqual(a.pointsRecovered + b.pointsRecovered + c.pointsRecovered, 215)
+})
