+++ b/tree/test/earn.test.js
@@ -0,0 +1,24 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { earnPoints } from '../src/points/earn.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('적립은 배송비를 제외하고 소수점을 버린다 (O-1042: 237P)', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [{ sku: 'A', unitPrice: 28270, qty: 1 }],
+    coupon: { code: 'C', amount: 3000 },
+    pointsUsed: 1500,
+  })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.amounts.total, 26770)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('earnPoints는 저장된 금액에서 배송비를 뺀다', () => {
+  const amounts = { goods: 10000, coupon: 0, shipping: 3000, pointsUsed: 0, total: 13000 }
+  assert.strictEqual(earnPoints({ amounts }), 100)
+})
