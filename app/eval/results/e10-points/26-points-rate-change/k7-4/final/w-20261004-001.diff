+
+test('부분 환불의 포인트 회수는 적립처럼 소수점을 버린다', () => {
+  const o = { ...order, lines: [{ sku: 'A', name: 'A', unitPrice: 50, qty: 4 }], amounts: { goods: 200, coupon: 0, shipping: 0, pointsUsed: 0, total: 200 }, points: { used: 0, earned: 2 } }
