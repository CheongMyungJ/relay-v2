+++ b/tree/test/earn.test.js
@@ -0,0 +1,18 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+
+const example = (f) => JSON.parse(fs.readFileSync(new URL(`../examples/${f}`, import.meta.url)))
+
+test('O-1107: 배송비 제외·버림 2%로 486P (배송비 포함·반올림이면 547P)', () => {
+  const o = createOrder(example('O-1107.json'))
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('G-0213: 선물하기 주문도 같은 규정 (24,860 − 2,000 − 1,000 = 21,860원 × 2% = 437.2 → 437P)', () => {
+  const g = createGiftOrder(example('G-0213.json'))
+  assert.strictEqual(g.points.earned, 437)
+})
