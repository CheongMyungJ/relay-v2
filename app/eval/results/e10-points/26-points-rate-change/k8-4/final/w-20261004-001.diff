 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액: 배송비를 뺀 결제 금액(상품 − 쿠폰 − 사용 포인트) */
+export function earnBase({ goods, coupon, pointsUsed }) {
+  return goods - coupon - pointsUsed
+}
+
+/** 적립 기준 금액의 POINT_RATE_PERCENT%, 소수점 버림. 일반·선물 주문과 환불 회수가 모두 이 식을 쓴다 */
+export function earnOn(base) {
+  return floorPercentOf(base, POINT_RATE_PERCENT)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnOn(earnBase(order.amounts))
 }
diff --git a/tree/test/earn-rule.test.js b/tree/test/earn-rule.test.js
new file mode 100644
index 0000000..851b06c
--- /dev/null
+++ b/tree/test/earn-rule.test.js
@@ -0,0 +1,50 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund, cancelOrder } from '../src/orders/refund.js'
+
+const lines = [
+  { sku: 'TE-0410', name: 'A', unitPrice: 8900, qty: 2 },
+  { sku: 'SN-1135', name: 'B', unitPrice: 3490, qty: 3 },
+]
+const coupon = { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 }
+
+test('배송비가 있는 주문: 적립 기준에 배송비가 들어가지 않는다 (O-1042 = 237P)', () => {
+  const o = createOrder({ number: 'O-1042', customerId: 'U-1', lines, coupon, pointsUsed: 1500 })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('무료 배송 주문: 상품 − 쿠폰 − 사용 포인트 기준', () => {
+  const o = createOrder({ number: 'O-0001', customerId: 'U-1', lines: [{ sku: 'A', name: 'A', unitPrice: 30000, qty: 1 }], pointsUsed: 1000 })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 290)
+})
+
+test('적립은 소수점 버림이다', () => {
+  const o = createOrder({ number: 'O-0002', customerId: 'U-1', lines: [{ sku: 'A', name: 'A', unitPrice: 29990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 299) // 299.9 → 299 (반올림이면 300)
+})
+
+test('선물하기 적립도 같은 규칙이다', () => {
+  const input = { customerId: 'U-1', lines, coupon, pointsUsed: 1500 }
+  const g = createGiftOrder({ ...input, number: 'G-0001', recipient: { name: '김하늘', phone: '010-1234-5678' } })
+  assert.strictEqual(g.points.earned, 237)
+})
+
+test('부분 환불 회수는 같은 규칙의 적립분 차이이고, 합치면 남은 주문의 적립분과 맞는다', () => {
+  const o = createOrder({ number: 'O-1042', customerId: 'U-1', lines, coupon, pointsUsed: 1500 })
+  const r1 = createRefund(o, { number: 'R-0001', items: [{ sku: 'SN-1135', qty: 1 }] })
+  // 남은 상품 24,780 − 3,000 − 1,500 = 20,280 → 202P. 237 − 202 = 35
+  assert.strictEqual(r1.pointsRecovered, 35)
+  const r2 = createRefund(o, { number: 'R-0002', items: [{ sku: 'SN-1135', qty: 1 }], alreadyRefunded: [{ sku: 'SN-1135', qty: 1 }] })
+  // 남은 상품 21,290 − 3,000 − 1,500 = 16,790 → 167. 202 − 167 = 35
+  assert.strictEqual(r2.pointsRecovered, 35)
+  assert.strictEqual(o.points.earned - r1.pointsRecovered - r2.pointsRecovered, 167)
+})
+
+test('전체 취소는 저장된 적립 포인트를 그대로 회수한다', () => {
+  const o = createOrder({ number: 'O-1042', customerId: 'U-1', lines, coupon, pointsUsed: 1500 })
+  assert.strictEqual(cancelOrder(o).pointsRecovered, 237)
+})
