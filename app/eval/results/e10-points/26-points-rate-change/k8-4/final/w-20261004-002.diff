@@ -0,0 +1,17 @@
+---
+kind: fact
+source: investigation
+---
+# 부분 환불의 포인트 회수는 환불 전후 남은 주문 적립분의 차이다
+
+## 내용
+- 부분 환불(`src/orders/refund.js` `createRefund`)은 쿠폰과 사용 포인트를 남은 주문에 그대로 둔다.
+- 회수 포인트 = (환불 전 남은 주문의 적립분) − (환불 뒤 남은 주문의 적립분). 적립 규칙은 `docs/knowledge/points/earn-rule.md` 참고.
+- 첫 부분 환불의 "환불 전 적립분"은 다시 계산하지 않고 주문에 저장된 `points.earned`를 쓴다. 나눠 환불할 때는 이미 환불된 분을 뺀 남은 상품으로 다시 계산한다. 이미 처리한 환불은 다시 계산하지 않는다 (사람이 알려 줌, Work w-20261004-002).
+- 이렇게 해야 여러 번 환불해도 회수 합이 남은 주문의 적립분과 맞는다. 전체 취소(`cancelOrder`)는 저장된 `points.earned`를 그대로 회수한다.
+- 환불 금액에 적립률을 곱하면 쿠폰·사용 포인트가 있는 주문에서 1~2P 어긋난다 (O-1077/R-0311: 131P가 아니라 132P).
+- 옛 규칙(268P 등)으로 저장된 주문을 부분 환불하면 회수량이 저장된 적립과 맞지 않을 수 있다.
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
+- 2026-10-04 첫 환불의 환불 전 적립분: 재계산 → 저장된 `points.earned` (Work w-20261004-002, 사람이 알려 줌)
diff --git a/base/src/orders/refund.js b/tree/src/orders/refund.js
index 7d4f479..9166ea4 100644
--- a/base/src/orders/refund.js
+++ b/tree/src/orders/refund.js
@@ -1,12 +1,17 @@
 import { POINT_RATE_PERCENT, REFUND_NUMBER } from '../config.js'
 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { sumWon } from '../money.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
 //   쿠폰 할인과 사용한 포인트는 남은 주문에 그대로 둔다. 남은 상품 금액이 그보다 적어지면 전체 취소로 한다.
 // - 전체 취소(cancelOrder): 결제 금액을 모두 돌려주고, 적립 포인트를 모두 회수하고, 사용한 포인트를 돌려준다.
 
+// 적립 기준 금액(상품 금액 − 쿠폰 − 사용 포인트, 배송비 제외)의 적립률%, 소수점 버림
+function earnOnBase(base) {
+  return Math.floor((base * POINT_RATE_PERCENT) / 100)
+}
+
 export function createRefund(order, input) {
   if (!REFUND_NUMBER.test(input.number ?? '')) throw new Error(`환불 번호 형식은 R-0000: ${input.number}`)
   const already = new Map((input.alreadyRefunded ?? []).map((r) => [r.sku, r.qty]))
@@ -26,12 +31,18 @@ export function createRefund(order, input) {
   const remainingGoods = order.amounts.goods - refundedBefore - refundGoods
   if (remainingGoods < order.amounts.coupon + order.amounts.pointsUsed)
     throw new Error('남은 상품 금액이 쿠폰 할인과 사용 포인트보다 적다. 전체 취소로 처리한다')
+  // 회수 = 환불 전 남은 주문의 적립분 − 환불 뒤 남은 주문의 적립분. 쿠폰과 사용 포인트는 남은 주문에 그대로 둔다
+  // 첫 환불의 환불 전 적립분은 주문에 저장된 적립 포인트를 쓴다. 나눠 환불할 때는 이미 환불된 분을 뺀 남은 상품으로 다시 계산한다
+  const kept = order.amounts.coupon + order.amounts.pointsUsed
+  const earnedBefore =
+    refundedBefore === 0 ? order.points.earned : earnOnBase(remainingGoods + refundGoods - kept)
+  const pointsRecovered = earnedBefore - earnOnBase(remainingGoods - kept)
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered,
   }
 }
 
diff --git a/base/test/refund.test.js b/tree/test/refund.test.js
index de6f8a4..0a2f67c 100644
--- a/base/test/refund.test.js
+++ b/tree/test/refund.test.js
@@ -30,3 +30,39 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+// O-1077: 상품 47,310 / 쿠폰 5,000 / 사용 포인트 2,000, 적립 403P (정산팀 기대 회수 132P)
+const order1077 = {
+  number: 'O-1077',
+  customerId: 'U-11853',
+  lines: [
+    { sku: 'KT-2290', name: 'KT', unitPrice: 12900, qty: 2 },
+    { sku: 'TW-0838', name: 'TW', unitPrice: 8380, qty: 1 },
+    { sku: 'SP-0656', name: 'SP', unitPrice: 6565, qty: 2 },
+  ],
+  coupon: { code: 'WELCOME5000', amount: 5000, minGoods: 30000 },
+  amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+  points: { used: 2000, earned: 403 },
+}
+
+test('부분 환불: 쿠폰과 사용 포인트를 뺀 남은 주문 적립분의 차이를 회수한다 (R-0311 = 132P)', () => {
+  const r = createRefund(order1077, { number: 'R-0311', items: [{ sku: 'SP-0656', qty: 2 }] })
+  assert.strictEqual(r.refundAmount, 13130)
+  assert.strictEqual(r.pointsRecovered, 132)
+})
+
+test('여러 번 나눠 환불해도 회수 합이 남은 주문의 적립분과 맞는다', () => {
+  const r1 = createRefund(order1077, { number: 'R-0001', items: [{ sku: 'SP-0656', qty: 1 }] })
+  const r2 = createRefund(order1077, {
+    number: 'R-0002',
+    items: [{ sku: 'SP-0656', qty: 1 }],
+    alreadyRefunded: [{ sku: 'SP-0656', qty: 1 }],
+  })
+  assert.strictEqual(r1.pointsRecovered + r2.pointsRecovered, 132)
+})
+
+test('첫 부분 환불의 회수는 저장된 적립 포인트에서 남은 상품 기준 적립을 뺀 값이다', () => {
+  const stored = { ...order1077, points: { used: 2000, earned: 400 } }
+  const r = createRefund(stored, { number: 'R-0311', items: [{ sku: 'SP-0656', qty: 2 }] })
+  assert.strictEqual(r.pointsRecovered, 400 - 271)
+})
