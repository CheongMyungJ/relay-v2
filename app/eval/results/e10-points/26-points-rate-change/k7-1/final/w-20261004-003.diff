 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 포인트. (상품 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%를 소수점 버림한다. 배송비는 뺀다 */
+export function earnOn(goods, coupon = 0, pointsUsed = 0) {
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return earnOn(goods, coupon, pointsUsed)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..4e5f08b
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,32 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { earnOn } from '../src/points/earn.js'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const o1107 = JSON.parse(fs.readFileSync(new URL('../examples/O-1107.json', import.meta.url), 'utf8'))
+
+test('적립은 (상품 − 쿠폰 − 사용 포인트)의 2%를 버림한다', () => {
+  assert.strictEqual(earnOn(27350, 2000, 1020), 486)
+})
+
+test('O-1107 주문 적립은 486P', () => {
+  assert.strictEqual(createOrder(o1107).points.earned, 486)
+})
+
+test('선물하기 적립도 같은 2% 기준', () => {
+  const g = createGiftOrder({
+    ...o1107,
+    number: 'G-1107',
+    recipient: { name: '김하늘', phone: '010-1234-5678' },
+  })
+  assert.strictEqual(g.points.earned, 486)
+})
+
+test('부분 환불 회수는 적립률 변경과 별개로 기존 1% 그대로다', () => {
+  const stored = JSON.parse(fs.readFileSync(new URL('../examples/O-1077.json', import.meta.url), 'utf8'))
+  const refund = JSON.parse(fs.readFileSync(new URL('../examples/R-0311.json', import.meta.url), 'utf8'))
+  assert.strictEqual(createRefund(stored, refund).pointsRecovered, 131)
+})
