+
+test('O-1042의 적립 포인트는 237P (배송비 제외, 원 단위 버림)', () => {
+  const o = createOrder(o1042)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비가 붙어도 붙지 않아도 적립은 같은 기준(상품-쿠폰-사용 포인트)이다', () => {
+  const paid = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }] })
+  const free = createOrder({ ...base, number: 'O-0004', lines: [{ sku: 'A', unitPrice: 30000, qty: 1 }] })
+  assert.strictEqual(paid.amounts.shipping, 3000)
+  assert.strictEqual(paid.points.earned, 200)
+  assert.strictEqual(free.amounts.shipping, 0)
