--- a/base/test/order.test.js
+++ b/tree/test/order.test.js
@@ -29,3 +29,30 @@ test('적립 포인트를 주문에 저장한다', () => {
 test('주문 번호 형식', () => {
   assert.throws(() => createOrder({ ...base, number: 'O-12', lines: [{ sku: 'A', unitPrice: 1000 }] }), /O-0000/)
 })
+
+const o1042 = {
+  ...base,
+  number: 'O-1042',
+  lines: [
+    { sku: 'TE-0410', unitPrice: 8900, qty: 2 },
+    { sku: 'SN-1135', unitPrice: 3490, qty: 3 },
+  ],
+  coupon: { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 },
+  pointsUsed: 1500,
+  pointBalance: 4820,
