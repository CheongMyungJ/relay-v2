@@ -0,0 +1,39 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createOrder } from '../src/orders/order.js'
+import { createRefund } from '../src/orders/refund.js'
+import { receiptLines } from '../src/format/receipt.js'
+
+const read = (f) => JSON.parse(fs.readFileSync(new URL(`../examples/${f}`, import.meta.url), 'utf8'))
+
+test('O-1107: 배송비 제외 24,330원의 2%를 버림해 486P 적립', () => {
+  assert.strictEqual(createOrder(read('O-1107.json')).points.earned, 486)
+})
+
+test('선물하기 주문도 같은 기준으로 적립한다', () => {
+  const g = createGiftOrder({
+    customerId: 'U-1',
+    number: 'G-0010',
+    recipient: { name: '김하늘', phone: '010-1234-5678' },
+    lines: [{ sku: 'A', unitPrice: 12165, qty: 2 }],
+    coupon: null,
+    pointsUsed: 0,
+  })
+  // 상품 24,330원, 배송비는 적립 기준에서 제외 → 486P
+  assert.strictEqual(g.points.earned, 486)
+})
+
+test('이미 저장된 주문(O-1077)의 적립 포인트는 새 비율에도 403P 그대로 쓴다', () => {
+  const stored = read('O-1077.json')
+  assert.strictEqual(stored.points.earned, 403)
+  assert.ok(receiptLines(stored).join('\n').includes('403P'))
+  createRefund(stored, read('R-0311.json'))
+  assert.strictEqual(stored.points.earned, 403)
+})
+
+test('부분 환불 회수 포인트는 적립률 변경 전과 같다 (O-1077 / R-0311 = 131P)', () => {
+  const r = createRefund(read('O-1077.json'), read('R-0311.json'))
+  assert.strictEqual(r.pointsRecovered, 131)
+})
