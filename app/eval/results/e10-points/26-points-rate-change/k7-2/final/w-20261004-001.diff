diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..9725910 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. (상품 금액 − 쿠폰 − 사용한 포인트)의 POINT_RATE_PERCENT%, 배송비 제외, 1P 미만 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..86276e8
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,34 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('배송비가 있는 주문도 배송비는 적립 금액에 들어가지 않는다', () => {
+  const o = createOrder({ ...base, number: 'O-0001', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 100)
+})
+
+test('배송비가 없는 주문은 상품 금액 기준으로 적립한다', () => {
+  const o = createOrder({ ...base, number: 'O-0002', lines: [{ sku: 'A', unitPrice: 40000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 400)
+})
+
+test('1P 미만은 .5 이상이어도 올림하지 않고 버린다', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [{ sku: 'A', unitPrice: 8900, qty: 2 }, { sku: 'B', unitPrice: 3490, qty: 3 }],
+    coupon: { code: 'C', amount: 3000, minGoods: 20000 },
+    pointsUsed: 1500,
+  })
+  assert.strictEqual(o.amounts.goods - o.amounts.coupon - o.amounts.pointsUsed, 23770)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('쿠폰과 사용한 포인트를 뺀 금액으로 적립한다', () => {
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 50000, qty: 1 }], coupon: { code: 'C', amount: 5000 }, pointsUsed: 2000 })
+  assert.strictEqual(o.points.earned, 430)
+})
