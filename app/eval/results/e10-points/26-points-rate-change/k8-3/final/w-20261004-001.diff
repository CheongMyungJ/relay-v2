 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..d160439
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,55 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { earnPoints } from '../src/points/earn.js'
+import { giftPoints } from '../src/gift/gift-points.js'
+import { percentOfFloor } from '../src/money.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('적립 기준에서 배송비를 제외하고 버림한다 (O-1042)', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [{ sku: 'A', unitPrice: 28270, qty: 1 }],
+    coupon: { code: 'C', amount: 3000 },
+    pointsUsed: 1500,
+  })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.amounts.total, 26770)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('적립 포인트는 소수점 이하를 버린다', () => {
+  const o = createOrder({ ...base, number: 'O-0001', lines: [{ sku: 'A', unitPrice: 29990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 299)
+})
+
+test('배송비가 있어도 적립에 포함되지 않는다', () => {
+  const o = createOrder({ ...base, number: 'O-0002', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(earnPoints(o), 100)
+})
+
+test('선물하기 주문도 같은 기준으로 적립한다 (G-0213)', () => {
+  const g = createGiftOrder({
+    ...base,
+    number: 'G-0213',
+    recipient: { name: '한서윤', phone: '010-4821-3307' },
+    lines: [
+      { sku: 'HN-0120', unitPrice: 15900, qty: 1 },
+      { sku: 'JM-0332', unitPrice: 4480, qty: 2 },
+    ],
+    coupon: { code: 'GIFT2000', amount: 2000 },
+    pointsUsed: 1000,
+  })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 218)
+  assert.strictEqual(giftPoints(g), 218)
+})
+
+test('percentOfFloor는 원 단위로 버림한다', () => {
+  assert.strictEqual(percentOfFloor(29990, 1), 299)
+  assert.strictEqual(percentOfFloor(99, 1), 0)
+})
