+  // 앞선 부분 환불이 있으면 저장된 적립에서 이미 회수한 만큼이 빠져 있다. 그 환불 직전의 적립으로 보고 이번 몫만 회수한다
+  // (가정: 정산팀이 확인한 값이 아닌 해석이다. 확인되면 이 줄을 고친다)
+  const earnedBefore = refundedBefore > 0 ? earnedOn(order, order.amounts.goods - refundedBefore) : order.points.earned
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered: earnedBefore - earnedOn(order, remainingGoods),
