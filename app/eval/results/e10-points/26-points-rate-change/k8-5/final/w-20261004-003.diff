diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..c3e774c
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,31 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createRefund } from '../src/orders/refund.js'
+import { earnPoints } from '../src/points/earn.js'
+import { giftPoints } from '../src/gift/gift-points.js'
+
+test('O-1107: 배송비를 뺀 24,330원의 2%를 버림해 486P 적립', () => {
+  const input = JSON.parse(readFileSync(new URL('../examples/O-1107.json', import.meta.url)))
+  const o = createOrder(input)
+  assert.strictEqual(o.amounts.total, 27330)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('적립은 원 단위 미만 버림', () => {
+  const order = { amounts: { total: 10849, shipping: 3000 } } // 7,849원 → 156.98
+  assert.strictEqual(earnPoints(order), 156)
+  assert.strictEqual(giftPoints(order), 156)
+})
+
+test('부분 환불 회수는 기존 비율(1%, 반올림)을 유지한다', () => {
+  const order = {
+    number: 'O-0100',
+    lines: [{ sku: 'A', unitPrice: 40000, qty: 1 }, { sku: 'B', unitPrice: 10050, qty: 1 }],
+    amounts: { goods: 50050, coupon: 0, shipping: 0, pointsUsed: 0, total: 50050 },
+    points: { used: 0, earned: 1001 },
+  }
+  const r = createRefund(order, { number: 'R-0001', items: [{ sku: 'B', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 101) // 10,050원의 1% = 100.5 → 반올림
+})
