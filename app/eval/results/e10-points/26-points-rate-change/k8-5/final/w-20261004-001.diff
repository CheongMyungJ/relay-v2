diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..ca11f40
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,44 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const example = (n) => JSON.parse(fs.readFileSync(new URL(`../examples/${n}.json`, import.meta.url), 'utf8'))
+
+// 적립 대상 금액: 배송비를 뺀 결제 금액(상품 - 쿠폰 - 사용 포인트), 소수점 버림
+test('O-1042: 배송비를 적립에서 뺀다 (237P)', () => {
+  const o = createOrder(example('O-1042'))
+  assert.strictEqual(o.amounts.total, 26770)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('O-1107: 배송비가 있는 주문 (243P)', () => {
+  const o = createOrder(example('O-1107'))
+  assert.strictEqual(o.amounts.total, 27330)
+  assert.strictEqual(o.points.earned, 243)
+})
+
+test('O-1077: 배송비 무료 주문은 저장된 값(403P)과 같다', () => {
+  const saved = example('O-1077')
+  const o = createOrder({ ...saved, pointsUsed: saved.points.used })
+  assert.deepStrictEqual(o.amounts, saved.amounts)
+  assert.strictEqual(o.points.earned, saved.points.earned)
+})
+
+test('소수점은 버린다', () => {
+  const o = createOrder({ number: 'O-0003', customerId: 'U-1', lines: [{ sku: 'A', unitPrice: 31990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 319)
+})
+
+test('선물하기 적립도 같은 기준 (G-0213)', () => {
+  const g = createGiftOrder(example('G-0213'))
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 218)
+})
+
+test('부분 환불의 적립 회수는 버린다', () => {
+  const r = createRefund(createOrder(example('O-1042')), { number: 'R-0001', items: [{ sku: 'SN-1135', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 34)
+})
