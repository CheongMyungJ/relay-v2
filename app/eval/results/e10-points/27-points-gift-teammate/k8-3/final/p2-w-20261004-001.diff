diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..29d6204 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 결제 금액의 POINT_RATE_PERCENT%, 1P 미만은 버린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const base = order.amounts.total - order.amounts.shipping
+  return Math.floor((base * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..5930a7b
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,20 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { earnPoints } from '../src/points/earn.js'
+
+test('O-1042의 적립 예정 포인트는 237P (배송비를 빼고 원 단위 버림)', () => {
+  const input = JSON.parse(fs.readFileSync(new URL('../examples/O-1042.json', import.meta.url), 'utf8'))
+  assert.strictEqual(createOrder(input).points.earned, 237)
+})
+
+test('적립 기준은 배송비를 뺀 결제 금액이다', () => {
+  const order = { amounts: { goods: 10000, coupon: 0, shipping: 3000, pointsUsed: 0, total: 13000 } }
+  assert.strictEqual(earnPoints(order), 100)
+})
+
+test('1P 미만은 버린다', () => {
+  const order = { amounts: { goods: 12999, coupon: 0, shipping: 0, pointsUsed: 0, total: 12999 } }
+  assert.strictEqual(earnPoints(order), 129)
+})
