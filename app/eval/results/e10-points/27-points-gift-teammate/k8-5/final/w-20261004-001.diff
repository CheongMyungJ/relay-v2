+++ b/tree/test/earn.test.js
@@ -0,0 +1,24 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { earnPoints } from '../src/points/earn.js'
+
+const example = (n) => createOrder(JSON.parse(fs.readFileSync(new URL(`../examples/${n}.json`, import.meta.url), 'utf8')))
+
+test('O-1042의 적립 예정 포인트는 237P', () => {
+  assert.strictEqual(example('O-1042').points.earned, 237)
+})
+
+test('다른 문의 주문도 배송비를 뺀 금액의 1%를 버림한다', () => {
+  assert.strictEqual(example('O-1077').points.earned, 423)
+  assert.strictEqual(example('O-1107').points.earned, 243)
+})
+
+test('배송비는 적립 대상이 아니다', () => {
+  assert.strictEqual(earnPoints({ amounts: { total: 13000, shipping: 3000 } }), 100)
+})
+
+test('원 미만 적립은 버린다', () => {
+  assert.strictEqual(earnPoints({ amounts: { total: 23770, shipping: 0 } }), 237)
+})
