diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..7d53b7c 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. (상품 − 쿠폰 − 사용 포인트, 배송비 제외)의 POINT_RATE_PERCENT%를 원 단위로 버린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..e8814ff
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,25 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('적립 기준 금액에서 배송비를 뺀다', () => {
+  // 상품 20,000 + 배송비 3,000 → 기준 20,000 → 200P (배송비 포함이면 230P)
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 200)
+})
+
+test('적립 포인트는 원 단위로 버린다', () => {
+  // 기준 1,990원 × 1% = 19.9 → 19P (반올림이면 20P)
+  const o = createOrder({ ...base, number: 'O-0004', lines: [{ sku: 'A', unitPrice: 1990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 19)
+})
+
+test('O-1042: 쿠폰과 사용 포인트를 뺀 23,770원 기준 237P', () => {
+  const input = JSON.parse(fs.readFileSync(new URL('../examples/O-1042.json', import.meta.url), 'utf8'))
+  const o = createOrder(input)
+  assert.strictEqual(o.points.earned, 237)
+})
