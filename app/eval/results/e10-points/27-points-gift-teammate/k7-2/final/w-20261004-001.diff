+++ b/tree/docs/knowledge/earn-points-basis-excludes-shipping.md
@@ -0,0 +1,8 @@
+# 일반 주문 적립 포인트는 (상품 금액 - 쿠폰 - 사용 포인트)의 1%를 1P 단위로 버린다
+
+- 종류: 사실
+- 적용: `src/points/earn.js`
+- 출처: 조사로 알아냄(고객센터 기준 사례 O-1042 한 건으로 추론), relay Work w-20261004-001, 2026-10-04
+
+배송비는 적립 기준에서 뺀다. 예: O-1042는 28,270 - 3,000 - 1,500 = 23,770원 → 237P. 배송비 포함 26,770원 반올림은 268P로 틀린 값이다.
+버림은 고객센터 값 1건으로 추론했다. 부분 환불 회수(`src/orders/refund.js`)는 아직 반올림이라 적립과 규칙이 다르다.
diff --git a/tree/docs/knowledge/gift-points-shared-with-other-team.md b/tree/docs/knowledge/gift-points-shared-with-other-team.md
new file mode 100644
index 0000000..0c7636f
--- /dev/null
+++ b/tree/docs/knowledge/gift-points-shared-with-other-team.md
@@ -0,0 +1,9 @@
+# 선물하기 적립(`src/gift/gift-points.js`)은 다른 팀과 같이 보고 있어 함부로 바꾸지 않는다
+
+- 종류: 규칙
+- 적용: `src/gift/gift-points.js`, `src/gift/gift-order.js`
+- 출처: 사람이 알려 줌, relay Work w-20261004-001, 2026-10-04
+
+일반 주문 적립 버그를 고칠 때도 선물하기 적립 코드는 바꾸지 않는다. 같은 문제가 있어 보여도 다른 팀과 먼저 맞춘다.
+공용 `percentOf`(`src/money.js`, 반올림)를 쓰므로 `percentOf`를 바꾸면 선물하기 적립도 달라진다. 일반 주문 쪽에서 내림이 필요하면 `earnPoints`에서만 처리한다.
+이 Work 기준 선물하기는 `amounts.total`(배송비 포함) 반올림이라 일반 주문과 기준이 다르다.
diff --git a/tree/docs/knowledge/saved-earned-points-never-recalculated.md b/tree/docs/knowledge/saved-earned-points-never-recalculated.md
new file mode 100644
index 0000000..d24966b
--- /dev/null
+++ b/tree/docs/knowledge/saved-earned-points-never-recalculated.md
@@ -0,0 +1,8 @@
+# 이미 적립된 포인트는 다시 계산하지 않고 주문에 저장된 값을 쓴다
+
+- 종류: 규칙
+- 적용: `src/orders/order.js`(`createOrder`가 `points.earned`를 저장), `src/orders/refund.js`, `src/format/receipt.js`
+- 출처: 사람이 알려 줌, relay Work w-20261004-001, 2026-10-04
+
+적립 계산식을 고쳐도 저장된 주문의 `points.earned`는 바꾸거나 재계산하지 않는다. 영수증, 전체 취소의 회수는 저장된 값을 읽는다.
+적립 계산 수정은 새로 만드는 주문에만 적용된다. 예: 식을 고친 뒤에도 저장된 O-1077의 403P는 그대로여야 한다.
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..03580f0 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 상품 금액에서 쿠폰과 사용 포인트를 뺀 금액의 POINT_RATE_PERCENT%를 1P 단위로 버린다 (배송비는 뺀다) */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..4c2725c
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,28 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+
+const example = (f) => JSON.parse(fs.readFileSync(new URL(`../examples/${f}`, import.meta.url), 'utf8'))
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('O-1042 적립 예정은 배송비를 뺀 237P (고객센터 계산)', () => {
+  assert.strictEqual(createOrder(example('O-1042.json')).points.earned, 237)
+})
+
+test('O-1107: 배송비가 붙은 주문도 배송비를 빼고 적립한다', () => {
+  // 상품 27,350 - 쿠폰 2,000 - 포인트 1,020 = 24,330 (배송비 3,000은 제외)
+  assert.strictEqual(createOrder(example('O-1107.json')).points.earned, 243)
+})
+
+test('무료배송 주문은 결제 금액 기준과 같다 (O-1077 저장값 403P)', () => {
+  const saved = example('O-1077.json')
+  const o = createOrder({ ...base, number: 'O-1077', lines: saved.lines, coupon: saved.coupon, pointsUsed: saved.points.used })
+  assert.strictEqual(o.points.earned, saved.points.earned)
+})
+
+test('배송비가 있고 쿠폰·포인트가 없으면 상품 금액의 1%', () => {
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 100)
+})
