@@ -0,0 +1,13 @@
+---
+kind: pitfall
+source: investigation
+anchor: percentOf
+---
+# percentOf(src/money.js)는 반올림이며 여러 곳이 공유한다
+
+## 내용
+- `percentOf`는 `Math.round`로 반올림한다. 선물 적립(`giftPoints`)과 부분 환불 회수 포인트(`refund.js`)가 쓴다.
+- 이것을 버림으로 바꾸면 선물과 환불 값이 함께 바뀐다. 일반 주문 적립은 `earnPoints`에서 따로 버림 계산한다(규칙은 docs/knowledge/points/order-earn-points.md 참고).
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..9042fb2 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. (상품 금액 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%, 원 단위 미만 버림. 배송비는 제외 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..680be1f
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,26 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('O-1042: 배송비 제외, 쿠폰·사용 포인트 차감 후 1% 버림으로 237P', () => {
+  const o = createOrder(JSON.parse(fs.readFileSync('examples/O-1042.json', 'utf8')))
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비가 있는 주문도 없는 주문도 같은 기준 금액으로 적립한다', () => {
+  const withShip = createOrder({ ...base, number: 'O-0010', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  const noShip = createOrder({ ...base, number: 'O-0011', lines: [{ sku: 'A', unitPrice: 40000, qty: 1 }] })
+  assert.strictEqual(withShip.amounts.shipping, 3000)
+  assert.strictEqual(withShip.points.earned, 100)
+  assert.strictEqual(noShip.amounts.shipping, 0)
+  assert.strictEqual(noShip.points.earned, 400)
+})
+
+test('소수점이 생기면 버림한다', () => {
+  const o = createOrder({ ...base, number: 'O-0012', lines: [{ sku: 'A', unitPrice: 12990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 129) // 129.9 → 129 (반올림이면 130)
+})
