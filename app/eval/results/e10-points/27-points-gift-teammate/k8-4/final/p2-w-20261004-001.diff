+---
+kind: pitfall
+source: investigation
+anchor: percentOf
+---
+# percentOf(src/money.js)는 반올림이며 여러 곳이 공유한다
+
+## 내용
+- `percentOf`는 `Math.round`로 반올림한다. 부분 환불 회수 포인트(`refund.js`)가 쓴다. 선물 적립(`giftPoints`)은 더 이상 쓰지 않는다.
+- 이것을 버림으로 바꾸면 환불 값이 바뀐다. 일반 주문 적립은 `earnPoints`에서 따로 버림 계산한다(규칙은 docs/knowledge/points/order-earn-points.md 참고).
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
+- 2026-10-04 선물 적립이 `gift-points.js`의 자체 버림 계산으로 바뀌어 `percentOf` 사용처에서 빠짐 (Work w-20261004-001)
diff --git a/base/src/gift/gift-points.js b/tree/src/gift/gift-points.js
index 31d9ca8..552f272 100644
--- a/base/src/gift/gift-points.js
+++ b/tree/src/gift/gift-points.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다) */
+/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다). (상품 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%, 원 단위 미만 버림. 배송비는 제외 */
 export function giftPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
