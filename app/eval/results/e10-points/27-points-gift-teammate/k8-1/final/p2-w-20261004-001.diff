diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..54a8824 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 금액(상품 - 쿠폰 - 사용 포인트)의 POINT_RATE_PERCENT%, 1P 미만은 버린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { total, shipping } = order.amounts
+  return Math.floor(((total - shipping) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..8080038
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,17 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+
+test('적립 포인트는 배송비를 뺀 금액(상품-쿠폰-사용 포인트)의 1%, 소수는 버린다 (O-1042 = 237P)', () => {
+  const input = JSON.parse(readFileSync(new URL('../examples/O-1042.json', import.meta.url)))
+  const o = createOrder(input)
+  assert.strictEqual(o.amounts.total, 26770)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비는 적립 기준에 들어가지 않는다', () => {
+  const o = createOrder({ customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00', number: 'O-0003', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 100)
+})
