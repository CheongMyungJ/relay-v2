diff --git a/tree/docs/knowledge/regular-order-points-rule.md b/tree/docs/knowledge/regular-order-points-rule.md
new file mode 100644
index 0000000..ca553c0
--- /dev/null
+++ b/tree/docs/knowledge/regular-order-points-rule.md
@@ -0,0 +1,10 @@
+# 일반 주문 적립은 배송비를 뺀 결제 금액에 적립률을 곱하고 원 단위로 버린다
+
+- 종류: 규칙
+- 적용: src/points/earn.js (일반 주문 O-), POINT_RATE_PERCENT(src/config.js)
+- 출처: 조사로 알아냄(고객센터 기준 237P에서 역산), relay Work w-20261004-001, 2026-10-04
+
+적립 = floor((상품 - 쿠폰 - 사용 포인트) × 적립률 / 100). 배송비는 뺀다.
+예: O-1042는 23,770원 × 1% = 237.7 → 237P. 배송비 포함 26,770원 반올림은 268P로 틀리다.
+배송비만 빼고 반올림하면 238, 포함하고 버림하면 267이라 둘 다 필요하다.
+환불 회수(src/orders/refund.js의 부분 환불)는 아직 반올림이라 1P 어긋날 수 있다.
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..8e007db 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 결제 금액(상품 - 쿠폰 - 사용 포인트)의 POINT_RATE_PERCENT%, 원 단위 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { total, shipping } = order.amounts
+  return Math.floor(((total - shipping) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..9776e45
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,16 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+
+const example = (name) => JSON.parse(fs.readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+
+test('O-1042 적립 예정은 237P (배송비를 뺀 결제 금액 23,770원의 1%, 원 단위 버림)', () => {
+  assert.strictEqual(createOrder(example('O-1042')).points.earned, 237)
+})
+
+test('적립은 배송비를 제외한 금액 기준', () => {
+  const o = createOrder({ customerId: 'U-1', number: 'O-0003', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 100)
+})
