 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { percentOfFloor } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액: 상품 금액 − 쿠폰 할인 − 사용 포인트 (배송비 제외) */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 주문의 적립 포인트. 적립 기준 금액의 POINT_RATE_PERCENT%, 원 단위 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return percentOfFloor(earnBase(order.amounts), POINT_RATE_PERCENT)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..102aaef
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,47 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+const gift = { customerId: 'U-1', recipient: { name: '김하늘', phone: '010-1234-5678' } }
+
+test('O-1042: 배송비를 뺀 기준으로 237P, 소수는 버린다', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [{ sku: 'TE-0410', unitPrice: 8900, qty: 2 }, { sku: 'SN-1135', unitPrice: 3490, qty: 3 }],
+    coupon: { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 },
+    pointsUsed: 1500,
+  })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비가 있는 주문과 없는 주문의 적립 포인트는 같은 기준(배송비 제외)', () => {
+  const withFee = createOrder({ ...base, number: 'O-0301', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }] })
+  const noFee = createOrder({ ...base, number: 'O-0302', lines: [{ sku: 'A', unitPrice: 30000, qty: 1 }] })
+  assert.strictEqual(withFee.amounts.shipping, 3000)
+  assert.strictEqual(withFee.points.earned, 200)
+  assert.strictEqual(noFee.amounts.shipping, 0)
+  assert.strictEqual(noFee.points.earned, 300)
+})
+
+test('소수가 생기면 적립 포인트는 버림(반올림 아님)', () => {
+  const o = createOrder({ ...base, number: 'O-0303', lines: [{ sku: 'A', unitPrice: 1590, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 15)
+})
+
+test('선물하기 주문도 배송비 제외 + 버림', () => {
+  const g = createGiftOrder({ ...gift, number: 'G-0301', lines: [{ sku: 'A', unitPrice: 25990, qty: 1 }] })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 259)
+})
+
+test('부분 환불 회수 포인트도 버림이라 적립 포인트를 넘지 않는다', () => {
+  const o = createOrder({ ...base, number: 'O-0305', lines: [{ sku: 'A', unitPrice: 1590, qty: 1 }] })
+  const r = createRefund(o, { number: 'R-0305', items: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(o.points.earned, 15)
+  assert.strictEqual(r.pointsRecovered, 15)
+})
