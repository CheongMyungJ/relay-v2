--- /dev/null
+++ b/tree/test/points-rate.test.js
@@ -0,0 +1,51 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const read = (f) => JSON.parse(fs.readFileSync(new URL(`../examples/${f}`, import.meta.url), 'utf8'))
+
+test('O-1107은 배송비를 뺀 기준 24,330원의 2%인 486P를 적립한다', () => {
+  const o = createOrder(read('O-1107.json'))
+  assert.strictEqual(o.amounts.total, 27330)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('적립은 원 단위 버림이다', () => {
+  const o = createOrder({ number: 'O-0003', customerId: 'U-1', lines: [{ sku: 'A', unitPrice: 10025, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 200)
+})
+
+test('선물하기도 같은 적립 계산(배송비 제외, 2%)을 쓴다', () => {
+  const g = createGiftOrder({
+    number: 'G-0004', customerId: 'U-1',
+    recipient: { name: '김하늘', phone: '010-1234-5678' },
+    lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }],
+  })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 200)
+})
+
+test('부분 환불 회수는 원 적립 − 남은 상품 재계산 적립(2%, 버림)이다', () => {
+  const order = {
+    number: 'O-0200', customerId: 'U-1',
+    lines: [{ sku: 'A', unitPrice: 10000, qty: 3 }],
+    coupon: { code: 'C', amount: 1000 },
+    amounts: { goods: 30000, coupon: 1000, shipping: 0, pointsUsed: 1010, total: 27990 },
+    points: { used: 1010, earned: 559 },
+  }
+  const r = createRefund(order, { number: 'R-0200', items: [{ sku: 'A', qty: 1 }] })
+  // 남은 20,000 − 1,000 − 1,010 = 17,990 × 2% = 359.8 → 359. 회수 559 − 359 = 200
+  assert.strictEqual(r.pointsRecovered, 200)
+  assert.strictEqual(r.refundAmount, 10000)
+})
+
+test('옛 1%로 저장된 주문의 부분 환불 회수는 음수가 되지 않고 그 주문의 적립률로 계산한다', () => {
+  const order = read('O-1077.json')
+  const r = createRefund(order, read('R-0311.json'))
+  // 남은 27,180 × 1% = 271.8 → 271. 회수 403 − 271 = 132
+  assert.strictEqual(r.pointsRecovered, 132)
+  assert.strictEqual(r.refundAmount, 13130)
+})
