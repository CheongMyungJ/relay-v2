diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..baee460 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,28 @@
-import { POINT_RATE_PERCENT } from '../config.js'
+import { LEGACY_POINT_RATE_PERCENT, POINT_RATE_PERCENT } from '../config.js'
 import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액. 상품 금액 − 쿠폰 할인 − 사용 포인트(배송비 제외) */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 기준 금액의 percent%(기본 POINT_RATE_PERCENT). 원 단위 버림 */
+export function earnFromBase(base, percent = POINT_RATE_PERCENT) {
+  return Math.floor((base * percent) / 100)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnFromBase(earnBase(order.amounts))
+}
+
+/**
+ * 저장된 주문을 적립할 때 쓴 적립률. 옛 1%는 결제 금액을 반올림해 적립했으므로,
+ * 저장된 적립 값이 그 값과 같고 지금 규칙의 값과 다르면 옛 주문으로 본다.
+ */
+export function earnedRatePercent(order) {
+  const legacy = percentOf(order.amounts.total, LEGACY_POINT_RATE_PERCENT)
+  return order.points.earned === legacy && order.points.earned !== earnPoints(order)
+    ? LEGACY_POINT_RATE_PERCENT
+    : POINT_RATE_PERCENT
 }
