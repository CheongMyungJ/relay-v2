diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..b0f5436 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. (상품 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%, 배송비 제외, 소수점 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..8b54b32
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,21 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { POINT_RATE_PERCENT } from '../src/config.js'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+
+const o1107 = JSON.parse(readFileSync(new URL('../examples/O-1107.json', import.meta.url)))
+
+test('적립률은 2%다', () => {
+  assert.strictEqual(POINT_RATE_PERCENT, 2)
+})
+
+test('O-1107: (상품 − 쿠폰 − 사용 포인트) × 2%를 버림해 486P, 배송비 제외', () => {
+  assert.strictEqual(createOrder(o1107).points.earned, 486)
+})
+
+test('선물하기도 같은 기준으로 2% 적립', () => {
+  const g = createGiftOrder({ ...o1107, number: 'G-1107', recipient: { name: '김하늘', phone: '010-1234-5678' } })
+  assert.strictEqual(g.points.earned, 486)
+})
