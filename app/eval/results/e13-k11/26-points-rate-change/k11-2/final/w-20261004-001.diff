diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..b482ba3 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,11 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액: 쿠폰과 사용 포인트를 뺀 상품 금액. 배송비는 넣지 않는다 */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 주문의 적립 포인트. 적립 기준 금액의 POINT_RATE_PERCENT%, 원 단위 미만은 버린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return Math.floor((earnBase(order.amounts) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..51d600b
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,39 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+
+const example = (name) => JSON.parse(readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('O-1042의 적립 포인트는 237P (쿠폰, 배송비, 사용 포인트 제외)', () => {
+  assert.strictEqual(createOrder(example('O-1042')).points.earned, 237)
+})
+
+test('배송비는 적립 기준에 넣지 않는다 (쿠폰 없음, 배송비 있음)', () => {
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 100)
+})
+
+test('배송비 무료이고 쿠폰도 포인트도 없으면 상품 금액의 1%', () => {
+  const o = createOrder({ ...base, number: 'O-0004', lines: [{ sku: 'A', unitPrice: 31000, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 310)
+})
+
+test('배송비 무료에 쿠폰과 사용 포인트가 있으면 둘 다 뺀 금액의 1%', () => {
+  const o = createOrder({ ...base, number: 'O-0005', lines: [{ sku: 'A', unitPrice: 47310, qty: 1 }], coupon: { code: 'C', amount: 5000 }, pointsUsed: 2000 })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 403)
+})
+
+test('선물하기 적립도 같은 기준', () => {
+  const g = createGiftOrder({ ...example('G-0213') })
+  assert.strictEqual(g.points.earned, 218)
+})
+
+test('적립 포인트는 1P 미만을 버린다', () => {
+  const o = createOrder({ ...base, number: 'O-0006', lines: [{ sku: 'A', unitPrice: 31990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 319)
+})
