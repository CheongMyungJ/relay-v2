+import { CREDIT_NOTE_PREFIX } from '../config.js'
 import { assertDate } from '../format/date.js'
 import { percentOf, sumWon } from '../money.js'
 import { isTaxableLine } from './tax-type.js'
+import { lineVat } from './total.js'
 
 // 반품 전표. 발행된 청구서의 품목 일부(또는 전부)를 거래처가 돌려보낼 때 만든다.
 // 돌려주는 금액은 양수로 적는다. 분개에서 청구서와 반대 방향으로 쓴다(src/export/ledger.js).
@@ -87,7 +88,7 @@ export function creditTotals(note) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = sumWon(rows.map((r) => lineVat(r, note.zeroRated)))
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..7a92382 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -13,6 +13,12 @@ export function lineAmounts(invoice) {
   })
 }
 
+// 줄 하나의 부가세. 할인된 줄 금액(과세 줄만)에 매기고 원 단위 미만은 버린다
+export function lineVat(row, zeroRated = false) {
+  if (zeroRated || !row.taxable) return 0
+  return Math.floor((row.net * VAT_RATE_PERCENT) / 100)
+}
+
 // 청구서 합계
 //   subtotal: 할인 전 금액 합, discount: 할인 합, supply: 공급가액 합
 //   taxable / exempt: 공급가액 중 과세분 / 면세분, vat: 부가세, total: 청구 합계
@@ -23,6 +29,6 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = sumWon(rows.map((r) => lineVat(r, invoice.zeroRated)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..66de24e 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,25 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표의 부가세도 줄마다 원 단위 버림으로 합한다', () => {
+  const cn = note([
+    { sku: 'OF-1450', qty: 3 }, // 4350 -> 435
+    { sku: 'OF-1990', qty: 3 }, // 5970 - 300 = 5670 -> 567
+  ])
+  assert.strictEqual(cn.totals.vat, 435 + 567)
+  const odd = createCreditNote(
+    issueInvoice(
+      createInvoice({
+        customerId: 'C-1',
+        lines: [
+          { sku: 'A', name: 'A', unitPrice: 5, qty: 1 },
+          { sku: 'B', name: 'B', unitPrice: 5, qty: 1 },
+        ],
+      }),
+      { number: 'INV-0200', issueDate: '2026-09-01' },
+    ),
+    { number: 'CN-0002', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'A', qty: 1 }, { sku: 'B', qty: 1 }] },
+  )
+  assert.strictEqual(odd.totals.vat, 0) // 줄별 0 + 0 (합계 기준이면 1)
+})
diff --git a/base/test/total.test.js b/tree/test/total.test.js
index 5b9aafd..ce1cf6c 100644
--- a/base/test/total.test.js
+++ b/tree/test/total.test.js
@@ -60,3 +60,37 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 줄마다 원 단위 버림으로 계산해 합한다 (INV-2031)', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 536 + 633 + 325 + 837 + 310)
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인이 있는 줄은 할인 후 금액에 부가세를 매기고 버린다', () => {
+  const inv = draft([
+    { name: '커피믹스', unitPrice: 1999, qty: 3, discount: { percent: 10 } }, // 5997-600=5397 -> 539
+    { name: '종이컵', unitPrice: 1555, qty: 1, discount: { amount: 100 } }, // 1455 -> 145
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 5397 + 1455)
+  assert.strictEqual(t.vat, 539 + 145)
+})
+
+test('면세 줄은 부가세 0이고 영세율 청구서도 줄별 계산 뒤 0이다', () => {
+  const lines = [
+    { name: '볼펜', unitPrice: 999, qty: 1 },
+    { name: '도서', unitPrice: 18000, qty: 1, taxType: 'exempt' },
+  ]
+  assert.strictEqual(computeTotals(draft(lines)).vat, 99)
+  assert.strictEqual(computeTotals(draft(lines, { zeroRated: true })).vat, 0)
+})
