+// 품목 줄 하나의 부가세. 할인된 과세 줄 금액(net)에 매기고 원 단위 미만은 버린다.
+// 면세 줄과 영세율 청구서는 0원
+export function lineVat({ net, taxable }, zeroRated = false) {
+  if (zeroRated || !taxable) return 0
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
 // 청구서 합계
