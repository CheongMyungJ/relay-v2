diff --git a/base/test/pool.test.js b/tree/test/pool.test.js
index c22d51a..9400df9 100644
--- a/base/test/pool.test.js
+++ b/tree/test/pool.test.js
@@ -34,3 +34,25 @@ test('묶음마다 진행 알림', async () => {
 test('빈 목록', async () => {
   assert.deepStrictEqual(await runPool([], async () => 1, { concurrency: 4 }), [])
 })
+
+test('결과는 완료 순서가 아니라 입력 순서다', async () => {
+  const delays = [30, 5, 20, 1, 10]
+  const results = await runPool(
+    delays,
+    async (ms) => {
+      await new Promise((r) => setTimeout(r, ms))
+      return ms
+    },
+    { concurrency: 4 },
+  )
+  assert.deepStrictEqual(results, delays)
+})
+
+test('onChunk의 done은 완료한 작업 수를 센다', async () => {
+  const seen = []
+  await runPool([30, 5, 20, 1, 10], (ms) => new Promise((r) => setTimeout(() => r(ms), ms)), {
+    concurrency: 4,
+    onChunk: (p) => seen.push(p.done),
+  })
+  assert.deepStrictEqual(seen, [4, 5])
+})
