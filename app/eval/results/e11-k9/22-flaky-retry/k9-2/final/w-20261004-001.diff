diff --git a/tree/test/pool-order.test.js b/tree/test/pool-order.test.js
new file mode 100644
index 0000000..e0cdb63
--- /dev/null
+++ b/tree/test/pool-order.test.js
@@ -0,0 +1,16 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { runPool } from '../src/runner/pool.js'
+
+test('결과는 완료 순서가 아니라 입력 순서다', async () => {
+  const delays = [30, 1, 15, 5, 1, 20]
+  const results = await runPool(
+    delays.map((ms, i) => ({ ms, i })),
+    async ({ ms, i }) => {
+      await new Promise((r) => setTimeout(r, ms))
+      return i
+    },
+    { concurrency: 3 },
+  )
+  assert.deepStrictEqual(results, [0, 1, 2, 3, 4, 5])
+})
