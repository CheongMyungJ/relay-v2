diff --git a/base/test/archive.test.js b/tree/test/archive.test.js
index 44aa323..0a4173d 100644
--- a/base/test/archive.test.js
+++ b/tree/test/archive.test.js
@@ -93,3 +93,29 @@ test('짧은 꼬리표', () => {
   assert.strictEqual(stamp(1759197304120), 'mg5wnj94')
   assert.strictEqual(stamp(35.9), 'z')
 })
+
+test('같은 순간에 동시에 저장해도 임시 파일이 겹치지 않는다', async () => {
+  setNow(() => 1759197304120)
+  try {
+    const files = createFileStore({ latency: { baseMs: 1 } })
+    const reports = ['a', 'b', 'c'].map((id) => ({ reportId: `report-${id}`, period: '2026-09', tenant: id }))
+    await Promise.all(reports.map((r) => saveReport(files, r)))
+    for (const r of reports) assert.strictEqual((await loadReport(files, '2026-09', r.reportId)).tenant, r.tenant)
+    assert.deepStrictEqual(strayTemps(files, '2026-09'), [])
+  } finally {
+    resetNow()
+  }
+})
+
+test('같은 reportId를 같은 순간에 동시에 저장해도 실패하지 않는다', async () => {
+  setNow(() => 1759197304120)
+  try {
+    const files = createFileStore({ latency: { baseMs: 1 } })
+    const report = { reportId: 'report-a', period: '2026-09', tenant: 'a' }
+    await Promise.all([saveReport(files, report), saveReport(files, report)])
+    assert.strictEqual((await loadReport(files, '2026-09', 'report-a')).tenant, 'a')
+    assert.deepStrictEqual(strayTemps(files, '2026-09'), [])
+  } finally {
+    resetNow()
+  }
+})
