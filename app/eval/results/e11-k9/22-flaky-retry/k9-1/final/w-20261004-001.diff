diff --git a/tree/docs/knowledge/testing/flaky-test-policy.md b/tree/docs/knowledge/testing/flaky-test-policy.md
new file mode 100644
index 0000000..1b95a8b
--- /dev/null
+++ b/tree/docs/knowledge/testing/flaky-test-policy.md
@@ -0,0 +1,13 @@
+---
+kind: rule
+source: human
+---
+# flaky 시험은 재시도·skip·시간 제한 증가로 풀지 않고 원인을 고친다
+
+## 규칙
+- 간헐 실패하는 시험에 재시도, skip, 시간 제한 증가를 붙이는 것은 해결이 아니다. 하지 않는다.
+- 원인은 시험이 아니라 제품 코드에서 찾아 고친다.
+- 로컬 `npm test`는 지연이 0이라 순서·경합 버그를 가린다. 지연이 있는 `ci/` 시험(`npm run test:ci`)으로 확인한다.
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/runner/pool.js b/tree/src/runner/pool.js
index efefaae..e423150 100644
--- a/base/src/runner/pool.js
+++ b/tree/src/runner/pool.js
@@ -5,20 +5,22 @@
  * @param {T[]} items
  * @param {(item: T) => Promise<R>} worker
  * @param {{ concurrency?: number, onChunk?: (p: { start: number, size: number, done: number, total: number }) => void }} [o]
- * @returns {Promise<R[]>}
+ * @returns {Promise<R[]>} items와 같은 순서의 결과
  */
 export async function runPool(items, worker, o = {}) {
   const size = Math.max(1, o.concurrency ?? 1)
-  const results = []
+  const results = new Array(items.length)
+  let finished = 0
   for (let start = 0; start < items.length; start += size) {
     const chunk = items.slice(start, start + size)
     await Promise.all(
-      chunk.map(async (item) => {
-        const result = await worker(item)
-        results.push(result)
+      chunk.map(async (item, i) => {
+        // 끝나는 순서가 아니라 items 순서 자리에 넣는다 (collectResults가 인덱스로 짝짓는다)
+        results[start + i] = await worker(item)
+        finished++
       }),
     )
-    o.onChunk?.({ start, size: chunk.length, done: results.length, total: items.length })
+    o.onChunk?.({ start, size: chunk.length, done: finished, total: items.length })
   }
   return results
 }
