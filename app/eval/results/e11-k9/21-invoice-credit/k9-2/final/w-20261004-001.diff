diff --git a/tree/docs/knowledge/invoice/vat-per-line-floor.md b/tree/docs/knowledge/invoice/vat-per-line-floor.md
new file mode 100644
index 0000000..0dc5f88
--- /dev/null
+++ b/tree/docs/knowledge/invoice/vat-per-line-floor.md
@@ -0,0 +1,16 @@
+---
+kind: rule
+source: human
+---
+# 부가세는 품목 줄마다 원 단위 버림으로 계산해 합한다
+
+## 규칙
+- 부가세는 과세 줄마다 (할인 적용 후 줄 금액 × 세율)을 원 단위로 버림(`Math.floor`)해 구하고, 그 합을 부가세로 쓴다. 합계에서 다시 반올림하지 않는다.
+- 할인은 부가세 전에 줄마다 적용한다. 면세 줄은 부가세가 없고, 영세율은 부가세 0이다.
+- 예: INV-2031은 줄별 536+633+325+837+310 = 2,641원, 합계 29,079원(합계 기준 반올림이면 2,644원으로 어긋남). 회계팀 대조 기준이다.
+
+## 아직 규칙을 따르지 않는 곳
+- src/invoice/credit-note.js:90: 합계 기준 `Math.round`로 부가세를 계산해 같은 불일치가 생길 수 있다. 사람이 Work w-20261004-001의 범위에서 뺌(2026-10-04)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..34c9a51 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -23,6 +23,9 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 부가세는 과세 줄마다 (할인 적용 후 금액 × 세율)을 원 단위로 버림해 합한다
+  const vat = invoice.zeroRated
+    ? 0
+    : sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/total.test.js b/tree/test/total.test.js
index 5b9aafd..5af0776 100644
--- a/base/test/total.test.js
+++ b/tree/test/total.test.js
@@ -60,3 +60,52 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 줄마다 원 단위로 버림해 합한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1342, qty: 4 },
+    { name: 'B', unitPrice: 905, qty: 7 },
+    { name: 'C', unitPrice: 1085, qty: 3 },
+    { name: 'D', unitPrice: 1675, qty: 5 },
+    { name: 'E', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 536 + 633 + 325 + 837 + 310)
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('INV-2031 예제 파일의 합계는 29,079원', async () => {
+  const { readFile } = await import('node:fs/promises')
+  const data = JSON.parse(await readFile(new URL('../examples/INV-2031.json', import.meta.url), 'utf8'))
+  const t = computeTotals(draft(data.lines))
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인된 줄 금액에 대해 줄마다 부가세를 버림한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1999, qty: 1, discount: { percent: 10 } }, // 1999-200=1799 -> 179
+    { name: 'B', unitPrice: 1555, qty: 1, discount: { amount: 5 } }, // 1550 -> 155
+    { name: 'C', unitPrice: 109, qty: 1 }, // 10
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.vat, 179 + 155 + 10)
+})
+
+test('면세 줄은 부가세가 없고 과세 줄만 줄별 버림한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 109, qty: 1 },
+    { name: 'B', unitPrice: 109, qty: 1 },
+    { name: '책', unitPrice: 999, qty: 1, taxType: 'exempt' },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.vat, 20)
+  assert.strictEqual(t.exempt, 999)
+})
+
+test('영세율 청구서는 줄별 계산에서도 부가세 0', () => {
+  const inv = draft([{ name: 'A', unitPrice: 109, qty: 3 }], { zeroRated: true })
+  assert.strictEqual(computeTotals(inv).vat, 0)
+})
