diff --git a/tree/docs/knowledge/billing/vat-per-line-floor.md b/tree/docs/knowledge/billing/vat-per-line-floor.md
new file mode 100644
index 0000000..46f090b
--- /dev/null
+++ b/tree/docs/knowledge/billing/vat-per-line-floor.md
@@ -0,0 +1,17 @@
+---
+kind: rule
+source: human
+---
+# 부가세는 과세 줄마다 원 단위 버림 후 합산한다 (회계팀 기준)
+
+## 규칙
+- 부가세는 과세 품목 줄마다 (할인 적용 후 줄 금액 × 세율)을 원 단위로 버림(내림)하고, 그 합이 부가세다.
+- 합계(과세 공급가액 합)에 세율을 곱해 다시 반올림하거나 절사하지 않는다.
+- 할인은 부가세 전에 줄마다 적용한다. 면세 줄과 영세율(`zeroRated`) 문서는 부가세 0이다.
+- 예: INV-2031은 536+633+325+837+310 = 부가세 2,641원, 공급가액 26,438원, 합계 29,079원. 합계 기준 반올림은 2,644원으로 틀리다.
+
+## 아직 규칙을 따르지 않는 곳
+- src/invoice/credit-note.js:90: 합계 기준 `Math.round`로 부가세를 계산한다. 청구서와 반품 전표 부가세가 어긋날 수 있다. 사람이 Work w-20261004-001의 범위에서 뺌(2026-10-04)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..6d58156 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -23,6 +23,9 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 회계팀 기준: 과세 줄마다 (할인 후 금액 × 세율)을 원 단위 버림하고 그 합이 부가세
+  const vat = invoice.zeroRated
+    ? 0
+    : sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/total.test.js b/tree/test/total.test.js
index 5b9aafd..5e37ba3 100644
--- a/base/test/total.test.js
+++ b/tree/test/total.test.js
@@ -60,3 +60,30 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 과세 줄마다 원 단위 버림 후 합산한다', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 536 + 633 + 325 + 837 + 310)
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인이 있는 줄은 할인된 금액에 부가세를 매겨 버림한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1999, qty: 1, discount: { percent: 15 } },
+    { name: 'B', unitPrice: 999, qty: 1, discount: { amount: 4 } },
+  ])
+  const t = computeTotals(inv)
+  // A: 1999 - 300 = 1699 -> 169, B: 999 - 4 = 995 -> 99. 합계 기준 반올림(2694 -> 269)과 다르다
+  assert.strictEqual(t.supply, 2694)
+  assert.strictEqual(t.vat, 268)
+  assert.strictEqual(t.total, 2962)
+})
