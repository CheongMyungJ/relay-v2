+test('반품 전표의 부가세도 품목별 원 단위 버림 후 합산한다', () => {
+  const full = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 4 },
+        { sku: 'OF-0905', name: '네임펜 흑', unitPrice: 905, qty: 7 },
+        { sku: 'OF-1085', name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+        { sku: 'OF-1675', name: '수정테이프', unitPrice: 1675, qty: 5 },
+        { sku: 'OF-0345', name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+      ],
+    }),
+    { number: 'INV-2031', issueDate: '2026-09-14' },
+  )
+  const cn = createCreditNote(full, {
+    number: 'CN-0002',
+    issueDate: '2026-09-20',
+    reason: '전량 반품',
+    returns: full.lines.map((l) => ({ sku: l.sku, qty: l.qty })),
+  })
+  assert.strictEqual(cn.totals.vat, 2641)
+  assert.strictEqual(cn.totals.total, 29079)
+})
