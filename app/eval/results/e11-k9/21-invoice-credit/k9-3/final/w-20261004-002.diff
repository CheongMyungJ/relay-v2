 import assert from 'node:assert'
 import { creditNoteEntries, ledger } from '../src/export/ledger.js'
@@ -81,3 +82,24 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('부가세는 과세 줄마다 원 단위로 버림해 합한다 (CN-0112)', () => {
+  const read = (f) => JSON.parse(readFileSync(new URL(`../examples/${f}`, import.meta.url)))
+  const data = read('CN-0112.json')
+  const cn = createCreditNote(read('INV-2047.json'), data)
+  // 줄별 923 + 612 + 207 = 1,742 (합계 기준 반올림은 1,744)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('면세 줄은 부가세가 없고 영세율 전표의 부가세는 0이다', () => {
+  const cn = note([
+    { sku: 'OF-1450', qty: 3 },
+    { sku: 'BK-1800', qty: 1 },
+  ])
+  assert.strictEqual(cn.totals.vat, 435)
+  const zero = createCreditNote(
+    { ...inv, zeroRated: true },
+    { number: 'CN-0002', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'OF-1450', qty: 3 }] },
+  )
+  assert.strictEqual(zero.totals.vat, 0)
+})
