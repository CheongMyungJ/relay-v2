new file mode 100644
index 0000000..0f3153b
--- /dev/null
+++ b/tree/docs/knowledge/invoice/vat-per-line-floor.md
@@ -0,0 +1,16 @@
+---
+kind: rule
+source: human
+---
+# 부가세는 과세 줄마다 할인 후 금액에 원 단위 버림으로 계산해 합한다
+
+## 규칙
+- 부가세는 과세 품목 줄마다 할인 적용 후 줄 금액(net)에 세율을 곱해 원 단위 버림으로 계산하고, 그 합을 부가세로 쓴다 (회계팀 규칙).
+- 합계는 공급가액 + 부가세이며, 합계에서 다시 반올림하지 않는다.
+- 예: INV-2031은 공급가액 26,438원, 부가세 2,641원(536+633+325+837+310), 합계 29,079원이다.
+
+## 아직 규칙을 따르지 않는 곳
+- src/invoice/credit-note.js: 반품 전표 부가세(`creditTotals`)가 과세분 합에 `Math.round`를 한 번 적용한다. 사람이 Work w-20261004-001의 범위에서 뺌(2026-10-04)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..15b03e7 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -13,6 +13,11 @@ export function lineAmounts(invoice) {
   })
 }
 
+// 과세 줄 하나의 부가세. 공급가액 기준 원 단위 버림
+function lineVat(net) {
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
 // 청구서 합계
 //   subtotal: 할인 전 금액 합, discount: 할인 합, supply: 공급가액 합
 //   taxable / exempt: 공급가액 중 과세분 / 면세분, vat: 부가세, total: 청구 합계
@@ -23,6 +28,7 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 부가세는 과세 줄마다 할인 후 금액에 원 단위 버림으로 계산해 더한다 (회계팀 규칙)
+  const vat = invoice.zeroRated ? 0 : sumWon(rows.filter((r) => r.taxable).map((r) => lineVat(r.net)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/total.test.js b/tree/test/total.test.js
index 5b9aafd..1cdba53 100644
--- a/base/test/total.test.js
+++ b/tree/test/total.test.js
@@ -60,3 +60,42 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 과세 줄마다 원 단위 버림으로 계산해 더한다 (INV-2031)', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  // 536 + 633 + 325 + 837 + 310
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인이 있는 줄은 할인 적용 후 금액에 부가세를 매긴다', () => {
+  const inv = draft([
+    { name: '커피믹스', unitPrice: 2217, qty: 1, discount: { percent: 10 } },
+    { name: '종이컵', unitPrice: 2000, qty: 1, discount: { amount: 5 } },
+  ])
+  const t = computeTotals(inv)
+  // 두 줄 모두 할인 후 1,995원 → 줄별 부가세 199 + 199 (합계에 한 번 반올림하면 399)
+  assert.strictEqual(t.supply, 3990)
+  assert.strictEqual(t.vat, 398)
+  assert.strictEqual(t.total, 4388)
+})
+
+test('면세 줄과 영세율 청구서의 부가세는 0원이다', () => {
+  const mixed = draft([
+    { name: '핸드북', unitPrice: 18007, qty: 1, taxType: 'exempt' },
+    { name: '볼펜', unitPrice: 345, qty: 9 },
+  ])
+  assert.strictEqual(computeTotals(mixed).vat, 310)
+  const exemptOnly = draft([{ name: '핸드북', unitPrice: 18007, qty: 1, taxType: 'exempt' }])
+  assert.strictEqual(computeTotals(exemptOnly).vat, 0)
+  const zero = draft([{ name: '볼펜', unitPrice: 345, qty: 9 }], { zeroRated: true })
+  assert.strictEqual(computeTotals(zero).vat, 0)
+})
