diff --git a/tree/test/slow-success.test.js b/tree/test/slow-success.test.js
new file mode 100644
index 0000000..2732b6d
--- /dev/null
+++ b/tree/test/slow-success.test.js
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { loadConfig } from '../src/config/load.js'
+import { decide } from '../src/retry/policy.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+const delivered = (id, userId, orderNo) => ({
+  id, source: 'orders', type: 'order.delivered', userId, occurredAt: '2026-09-21T00:59:00Z', data: { orderNo },
+})
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+
+test('제한 시간보다 오래 걸렸어도 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1 }, options), { action: 'done' })
+})
+
+test('느리지만 성공한 메일은 한 번만 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 2500 } })
+  const [res] = (await notifier.handle({
+    id: 'ord-1', source: 'orders', type: 'order.shipped', userId: 'u-1', occurredAt: '2026-09-21T00:59:58Z',
+    data: { orderNo: 'A-1', carrier: 'CJ', trackingNo: '1' },
+  })).results.filter((r) => r.channel === 'mail')
+  assert.equal(res.status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance?.(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('실제로 실패한 메일은 여전히 재시도로 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 100, outcomes: [{ fail: 'transient' }] } })
+  await notifier.handle({
+    id: 'ord-2', source: 'orders', type: 'order.shipped', userId: 'u-1', occurredAt: '2026-09-21T00:59:58Z',
+    data: { orderNo: 'A-2', carrier: 'CJ', trackingNo: '2' },
+  })
+  assert.equal(notifier.retryQueue.size(), 1)
+  clock.set(clock.now() + 5000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('느리지만 성공한 요약 메일은 한 번만 보낸다', async () => {
+  const { notifier, clock, mail } = setup({
+    users: { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } },
+    mail: { latencyMs: 3500 },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('느리지만 성공한 푸시는 한 번만 보낸다', async () => {
+  const { notifier, clock, push } = setup({ push: { latencyMs: 2500 } })
+  await notifier.handle(shippedEvent({ id: 'ord-3', data: { orderNo: 'A-3', carrier: 'CJ', trackingNo: '3' } }))
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(push.sent.length, 1)
+})
