diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..3019d3f 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,116 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// ---- 경로별 "같은 날 같은 고객에게 한 통만" ----
+
+const mailsTo = (mail, to) => mail.sent.filter((m) => m.to === to)
+
+test('[첫 발송] 한 번 돌리면 사용자마다 한 통', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+})
+
+test('[느린 성공] 제한 시간(3000ms)을 넘겨 성공해도 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('[느린 성공이 반복] 두 번 연속 느려도 한 통', async () => {
+  const { notifier, clock, mail } = digestSetup({
+    mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }, { latencyMs: 3500 }, { latencyMs: 3500 }] },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+})
+
+test('[실패 후 재시도] 일시적 오류 뒤 재시도가 성공하면 한 통', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+})
+
+test('[스케줄러 재실행] 같은 기간을 다시 돌려도(재시작 등) 받은 사람에게는 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  clock.advance(5_000) // runId가 달라진다
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.sent, 0)
+  assert.equal(again.already, 1)
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+})
+
+test('[스케줄러 재실행] runId를 달리 줘서 두 번 돌려도 한 통', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+})
+
+test('[재발송] 발송이 실패한 요약은 다시 돌리면 나가고, 받은 사람은 건너뛴다', async () => {
+  const { notifier, clock, mail } = digestSetup({
+    mail: { latencyMs: 300, outcomes: [{}, { fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  await notifier.handle(delivered('ord-2001-delivered', 'u-2', 'B-2001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  assert.equal(first.sent, 1)
+  assert.equal(first.failed, 1)
+  assert.equal(mailsTo(mail, 'sam@example.com').length, 0)
+
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(second.sent, 1)
+  assert.equal(second.already, 1)
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+  assert.equal(mailsTo(mail, 'sam@example.com').length, 1)
+})
+
+test('[스케줄러 재실행] 최종 실패한 요약은 다음 tick에서 실패분만 다시 보내고, 3번까지만 돈다', async () => {
+  const { notifier, clock, mail } = digestSetup({
+    mail: { latencyMs: 300, outcomes: [{}, { fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  await notifier.handle(delivered('ord-2001-delivered', 'u-2', 'B-2001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(mailsTo(mail, 'sam@example.com').length, 0)
+
+  const second = await notifier.digest.tick()
+  assert.equal(second.sent, 1)
+  assert.equal(second.already, 1)
+  assert.equal(mailsTo(mail, 'mina@example.com').length, 1)
+  assert.equal(mailsTo(mail, 'sam@example.com').length, 1)
+  assert.equal(await notifier.digest.tick(), null)
+})
+
+test('[스케줄러 재실행] 영구 오류는 한 기간에 3번까지만 다시 돈다', async () => {
+  const { notifier, clock, mail } = digestSetup({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'permanent' }, { fail: 'permanent' }, { fail: 'permanent' }, { fail: 'permanent' }] },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  for (let i = 0; i < 3; i++) assert.equal((await notifier.digest.tick()).failed, 1)
+  assert.equal(await notifier.digest.tick(), null)
+  assert.equal(mail.calls.length, 3)
+})
