diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..8499d62
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { loadConfig } from '../src/config/load.js'
+import { decide } from '../src/retry/policy.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+// 제한 시간보다 오래 걸렸더라도 성공한 발송은 성공이다. 다시 보내면 같은 알림이 두 번 간다.
+test('제한 시간을 넘겨 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1 }, options), { action: 'done' })
+})
+
+test('느리게 성공한 메일과 푸시는 한 번만 발송된다', async () => {
+  const { notifier, clock, mail, push } = setup({ mail: { latencyMs: 3000 }, push: { latencyMs: 2500 } })
+  const res = await notifier.handle(shippedEvent())
+  assert.deepEqual(res.results.map((r) => r.status), ['sent', 'sent'])
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(push.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(push.calls.length, 1)
+})
+
+test('실제로 실패한 메일과 푸시는 재시도로 다시 발송된다', async () => {
+  const { notifier, clock, mail, push } = setup({
+    mail: { outcomes: [{ fail: 'timeout', latencyMs: 3000 }] },
+    push: { outcomes: [{ fail: 'transient' }] },
+  })
+  const res = await notifier.handle(shippedEvent())
+  assert.deepEqual(res.results.map((r) => r.status), ['retry-scheduled', 'retry-scheduled'])
+  clock.advance(notifier.config.retry.baseDelayMs)
+  assert.equal(await notifier.retryWorker.runDue(), 2)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(push.sent.length, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(push.calls.length, 2)
+})
+
+test('요약 메일도 느리게 성공하면 한 번만 발송된다', async () => {
+  const users = { 'u-1': { email: 'mina@example.com', pushTokens: ['tok-a'], locale: 'ko', digest: true } }
+  const { notifier, clock, mail } = setup({ users, mail: { latencyMs: 4000 } })
+  await notifier.handle({
+    id: 'ord-1001-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1',
+    occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1001' },
+  })
+  clock.set(Date.parse('2026-09-21T23:05:00Z'))
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+})
