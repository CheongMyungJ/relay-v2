+})
+
+test('[재실행] 같은 기간을 다른 실행으로 다시 돌려도 이미 보낸 요약은 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await collected()
+  await notifier.digest.tick()
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  const third = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.already, 1)
+  assert.equal(third.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[동시 실행] 같은 기간 실행이 겹쳐도 한 통만 나간다', async () => {
+  const { notifier, mail } = await collected()
+  await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'b' }),
+  ])
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[재시도] 실제로 발송에 실패한 요약은 다시 실행하면 다시 보낸다', async () => {
+  const { notifier, mail } = await collected({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'r1' })
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'r2' })
+  assert.equal(second.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[건너뛰기] 실행이 오류로 끝나면 다음 일정에서 같은 기간을 다시 보낸다', async () => {
+  const { notifier, mail } = await collected()
+  const original = notifier.preferences.get
+  let boom = true
+  notifier.preferences.get = (id) => {
+    if (boom) throw new Error('설정 저장소 오류')
+    return original(id)
+  }
+  await assert.rejects(() => notifier.digest.tick(), /설정 저장소 오류/)
+  boom = false
+  const summary = await notifier.digest.tick()
+  assert.equal(summary?.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[건너뛰기] 하루 동안 일정이 돌지 않아도 못 보낸 지난 기간을 모두 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001')) // 9/21
+  clock.set(Date.parse('2026-09-22T01:00:00Z'))
+  await notifier.handle(delivered('ord-1002-delivered', 'u-1', 'A-1002')) // 9/22
+  clock.set(Date.parse('2026-09-22T23:05:00Z')) // 9/22 요약 시각(9/21 기간)을 놓치고 9/23 아침에 처음 돈다
+  await notifier.digest.tick()
+  assert.equal(mail.sent.length, 2)
+  assert.deepEqual(mail.sent.map((m) => m.subject).sort(), ['2026-09-21 알림 요약 (1건)', '2026-09-22 알림 요약 (1건)'])
+})
+
+test('[일정] 요약이 아직 도는 중에 일정이 다시 불려도 겹쳐 보내지 않는다', async () => {
+  const { notifier, mail } = await collected()
+  const [a, b] = await Promise.all([notifier.digest.tick(), notifier.digest.tick()])
+  assert.equal([a, b].filter(Boolean).length, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+// --- 서버 두 대가 요약 발송 기록 하나를 같이 쓴다 ---
+
+async function twoServers(mailA = {}, mailB = {}) {
+  const sa = digestSetup({ mail: { latencyMs: 300, ...mailA } })
+  const ledger = sa.notifier.digest.ledger
+  const sb = setup({ users: DIGEST_USERS, mail: { latencyMs: 300, ...mailB }, push: { latencyMs: 60 }, digestLedger: ledger })
+  for (const s of [sa, sb]) {
+    await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+    s.clock.set(NEXT_MORNING)
+  }
+  return { a: sa, b: sb }
+}
+
+test('[서버 두 대] 두 서버가 같은 시각에 일정을 돌려도 한 통만 나간다', async () => {
+  const { a, b } = await twoServers()
+  await Promise.all([a.notifier.digest.tick(), b.notifier.digest.tick()])
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
+
+test('[서버 두 대] 한 서버가 보낸 뒤 다른 서버(배포 직후 재실행)가 돌려도 다시 보내지 않는다', async () => {
+  const { a, b } = await twoServers()
+  await a.notifier.digest.tick()
+  const again = await b.notifier.digest.tick()
+  assert.equal(again.already, 1)
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
+
+test('[서버 두 대] 한 서버의 발송이 실제로 실패하면 예약을 풀어 재시도로 다시 나간다', async () => {
+  const { a, b } = await twoServers({ outcomes: [{ fail: 'transient' }] })
+  const [ra, rb] = await Promise.all([a.notifier.digest.tick(), b.notifier.digest.tick()])
+  assert.equal(a.mail.calls.length, 2) // 첫 발송 실패 + 재시도
+  assert.equal(ra.sent, 1)
+  assert.equal(rb.busy, 1)
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
