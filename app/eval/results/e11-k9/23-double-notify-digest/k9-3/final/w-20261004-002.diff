diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..6aa6362 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,88 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+test('느리게 끝났어도 성공한 요약은 다시 보내지 않는다', async () => {
+  // 제한 시간(3000ms)을 넘겨 4초 만에 성공
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 4000 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('같은 날짜 요약을 다시 실행해도 이미 보낸 사용자에게는 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  clock.advance(60_000)
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(again.already, 1)
+  assert.equal(again.sent, 0)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('일시적 오류로 실제 실패한 요약은 재시도로 다시 보내고, 재실행으로도 한 통만 간다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  assert.equal(first.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(again.sent, 0)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('연결이 끊겨 못 보낸 요약은 재시도로 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  const original = mail.deliver
+  let reset = true
+  mail.deliver = async (m) => {
+    if (reset) {
+      reset = false
+      mail.calls.push({ to: m.to, subject: m.subject, at: clock.now() })
+      throw Object.assign(new Error('read ECONNRESET'), { code: 'ECONNRESET' })
+    }
+    return original(m)
+  }
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('응답이 늦어 timeout이 났어도 서버가 받은 요약은 다시 보내지 않는다', async () => {
+  // 가짜 전송은 timeout에도 메일을 내보낸다(서버는 받은 메일을 다 내보낸다)
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout', latencyMs: 4000 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  assert.equal(first.sent, 1)
+  assert.equal(first.failed, 0)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(notifier.digest.ledger.forUser('u-1').at(-1).unconfirmed, true)
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(again.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('일시적 오류 뒤 timeout이 나도 고객에게는 한 통만 간다', async () => {
+  const { notifier, clock, mail } = digestSetup({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { fail: 'timeout', latencyMs: 4000 }] },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(first.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
