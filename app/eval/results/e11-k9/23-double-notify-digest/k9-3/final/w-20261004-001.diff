diff --git a/tree/test/no-double-send.test.js b/tree/test/no-double-send.test.js
new file mode 100644
index 0000000..2f3f400
--- /dev/null
+++ b/tree/test/no-double-send.test.js
@@ -0,0 +1,69 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { setup, shippedEvent } from './helpers.js'
+
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: ['tok-a'], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const delivered = (id) => ({ id, source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } })
+
+// 제한 시간(기본 2000ms)보다 늦게 끝났어도 전송이 성공했으면 고객에게는 이미 간 것이다
+for (const channel of ['mail', 'push']) {
+  test(`${channel}: 느리게 성공한 발송은 재시도로 다시 보내지 않는다`, async () => {
+    const env = setup({ [channel]: { latencyMs: 2500 } })
+    const res = await env.notifier.handle(shippedEvent())
+    assert.equal(res.results.find((r) => r.channel === channel).status, 'sent')
+    assert.equal(env.notifier.retryQueue.size(), 0)
+    await env.clock.advance(120_000)
+    await env.notifier.retryWorker.runDue()
+    assert.equal(env[channel].sent.length, 1)
+  })
+
+  test(`${channel}: 실제로 실패한 발송은 재시도로 다시 보낸다`, async () => {
+    const env = setup({ [channel]: { outcomes: [{ fail: 'transient' }] } })
+    const res = await env.notifier.handle(shippedEvent())
+    assert.equal(res.results.find((r) => r.channel === channel).status, 'retry-scheduled')
+    await env.clock.advance(5000)
+    await env.notifier.retryWorker.runDue()
+    assert.equal(env[channel].sent.length, 1)
+    assert.equal(env[channel].calls.length, 2)
+  })
+}
+
+test('요약: 느리게 성공한 요약 메일은 다시 보내지 않는다', async () => {
+  const env = setup({ users: DIGEST_USERS, mail: { latencyMs: 3500 } })
+  await env.notifier.handle(delivered('d-1'))
+  env.clock.set(NEXT_MORNING)
+  const summary = await env.notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(env.mail.sent.length, 1)
+})
+
+test('요약: 같은 기간을 다시 돌려도 이미 보낸 요약은 다시 보내지 않는다', async () => {
+  const env = setup({ users: DIGEST_USERS })
+  await env.notifier.handle(delivered('d-1'))
+  env.clock.set(NEXT_MORNING)
+  await env.notifier.digest.run({ period: '2026-09-21' })
+  env.clock.advance(60_000)
+  const again = await env.notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.already, 1)
+  assert.equal(env.mail.sent.length, 1)
+})
+
+test('요약: 실제로 실패한 요약은 다시 보낸다', async () => {
+  const env = setup({ users: DIGEST_USERS, mail: { outcomes: [{ fail: 'transient' }] } })
+  await env.notifier.handle(delivered('d-1'))
+  env.clock.set(NEXT_MORNING)
+  const summary = await env.notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(env.mail.sent.length, 1)
+})
+
+test('나중에 다시 온 같은 이벤트는 중복으로 걸러 한 번만 보낸다', async () => {
+  const env = setup()
+  await env.notifier.handle(shippedEvent())
+  env.clock.advance(30_000)
+  const res = await env.notifier.handle(shippedEvent({ deliveryAttempt: 2 }))
+  assert.equal(res.status, 'duplicate')
+  assert.equal(env.mail.sent.length, 1)
+  assert.equal(env.push.sent.length, 1)
+})
