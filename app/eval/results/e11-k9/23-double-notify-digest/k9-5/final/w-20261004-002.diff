diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..0b58a6f 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,133 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// --- 같은 날 같은 고객에게 요약은 한 번만, 실패한 요약은 다시, 하루도 거르지 않는다 ---
+
+async function collectOne(opts) {
+  const ctx = digestSetup(opts)
+  await ctx.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  return ctx
+}
+
+test('느리게 성공한 요약은 성공으로 보고 다시 보내지 않는다 (예약 실행)', async () => {
+  const { notifier, clock, mail } = await collectOne({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('같은 기간을 다시 실행해도(실행 번호가 달라도) 이미 보낸 요약은 다시 보내지 않는다 (재실행)', async () => {
+  const { notifier, clock, mail } = await collectOne()
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  const third = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(first.sent, 1)
+  assert.equal(second.sent, 0)
+  assert.equal(second.already, 1)
+  assert.equal(third.sent, 0)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('느리게 성공한 뒤 재실행해도 한 통이다 (재실행 + 느린 성공)', async () => {
+  const { notifier, clock, mail } = await collectOne({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 5000 }] } })
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(mail.sent.length, 1)
+})
+
+test('같은 기간의 실행이 겹쳐도 한 통이다 (일정 + 수동 실행 동시)', async () => {
+  const { notifier, clock, mail } = await collectOne()
+  clock.set(NEXT_MORNING)
+  const results = await Promise.all([
+    notifier.digest.tick(),
+    notifier.digest.run({ period: '2026-09-21', runId: 'manual' }),
+    notifier.digest.tick(),
+  ])
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(results[0], results[1])
+  assert.equal(results[0], results[2])
+  assert.equal(results[0].sent, 1)
+})
+
+test('일시적 오류 뒤 느리게 성공해도 한 통이다 (재시도 경로)', async () => {
+  const { notifier, clock, mail } = await collectOne({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { latencyMs: 4000 }] },
+  })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('끝내 발송에 실패한 요약은 재실행하면 다시 나간다', async () => {
+  const { notifier, clock, mail } = await collectOne({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  const second = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(second.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('실행이 도중에 오류로 끝나도 다음 일정에서 그 날 요약을 보낸다 (하루 누락 없음)', async () => {
+  const { notifier, clock, mail } = await collectOne()
+  const realGet = notifier.preferences.get
+  let boom = true
+  notifier.preferences.get = (id) => {
+    if (boom) {
+      boom = false
+      throw new Error('설정 저장소 오류')
+    }
+    return realGet.call(notifier.preferences, id)
+  }
+  clock.set(NEXT_MORNING)
+  await assert.rejects(() => notifier.digest.tick(), /설정 저장소 오류/)
+  assert.equal(mail.sent.length, 0)
+  clock.advance(60_000)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary?.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  clock.advance(60_000)
+  assert.equal(await notifier.digest.tick(), null)
+})
+
+test('이틀 연속 일정이 돌면 날마다 요약이 한 통씩 나간다', async () => {
+  const { notifier, clock, mail } = await collectOne()
+  clock.set(NEXT_MORNING)
+  assert.equal((await notifier.digest.tick()).period, '2026-09-21')
+  await notifier.handle({ ...delivered('ord-1002-delivered', 'u-1', 'A-1002'), occurredAt: '2026-09-21T23:04:00Z' })
+  clock.set(Date.parse('2026-09-22T23:05:00Z'))
+  const next = await notifier.digest.tick()
+  assert.equal(next.period, '2026-09-22')
+  assert.equal(next.sent, 1)
+  assert.equal(mail.sent.length, 2)
+})
+
+test('발송에 실패한 요약은 다음 일정에서 다시 나가고, 보낸 뒤에는 더 나가지 않는다', async () => {
+  const { notifier, clock, mail } = await collectOne({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  clock.advance(60_000)
+  const second = await notifier.digest.tick()
+  assert.equal(second.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  clock.advance(60_000)
+  assert.equal(await notifier.digest.tick(), null)
+  assert.equal(mail.sent.length, 1)
+})
