diff --git a/tree/src/invoice/vat.js b/tree/src/invoice/vat.js
new file mode 100644
index 0000000..f9bda88
--- /dev/null
+++ b/tree/src/invoice/vat.js
@@ -0,0 +1,17 @@
+import { VAT_RATE_PERCENT } from '../config.js'
+import { assertWon } from '../money.js'
+
+// 회계팀 규칙: 부가세는 품목 줄마다 계산하고 원 단위 미만을 버린다. 합계에서 다시 반올림하지 않는다
+// net: 할인을 뺀 줄 공급가액(과세 품목만)
+export function lineVat(net) {
+  assertWon(net)
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
+// 줄별 부가세의 합. rows는 { net, taxable }. 영세율이면 0
+export function sumLineVat(rows, zeroRated) {
+  if (zeroRated) return 0
+  let vat = 0
+  for (const r of rows) if (r.taxable) vat += lineVat(r.net)
+  return vat
+}
diff --git a/tree/test/vat-per-line.test.js b/tree/test/vat-per-line.test.js
new file mode 100644
index 0000000..71e92d0
--- /dev/null
+++ b/tree/test/vat-per-line.test.js
@@ -0,0 +1,98 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createCreditNote } from '../src/invoice/credit-note.js'
+import { createInvoice, issueInvoice } from '../src/invoice/invoice.js'
+import { createQuote } from '../src/invoice/quote.js'
+import { computeTotals } from '../src/invoice/total.js'
+import { lineVat } from '../src/invoice/vat.js'
+
+// 회계팀 규칙: 부가세는 줄마다 원 단위 버림으로 계산하고 합산한다. 합계에서 다시 반올림하지 않는다
+
+const draft = (lines, extra = {}) => createInvoice({ customerId: 'C-1', lines, ...extra })
+
+test('lineVat은 원 단위 미만을 버린다', () => {
+  assert.strictEqual(lineVat(5360), 536)
+  assert.strictEqual(lineVat(6335), 633)
+  assert.strictEqual(lineVat(9), 0)
+})
+
+test('청구서 부가세는 줄별 버림의 합이다', () => {
+  // 줄별: 384 + 373 + 2893 = 3650 (총액 기준 반올림이면 3651)
+  const t = computeTotals(
+    draft([
+      { name: 'A', unitPrice: 3845 },
+      { name: 'B', unitPrice: 415, qty: 9 },
+      { name: 'C', unitPrice: 3215, qty: 9 },
+    ]),
+  )
+  assert.strictEqual(t.vat, 384 + 373 + 2893)
+  assert.strictEqual(t.total, t.supply + t.vat)
+})
+
+test('할인은 줄마다 부가세 전에 적용하고 할인된 금액에 부가세를 매긴다', () => {
+  // 박스테이프 10736 - 1500 = 9236 -> 923, 형광펜 12900 - 645 = 12255 -> 1225
+  const t = computeTotals(
+    draft([
+      { name: '박스테이프', unitPrice: 1342, qty: 8, discount: { amount: 1500 } },
+      { name: '형광펜', unitPrice: 2150, qty: 6, discount: { percent: 5 } },
+    ]),
+  )
+  assert.strictEqual(t.supply, 9236 + 12255)
+  assert.strictEqual(t.vat, 923 + 1225)
+})
+
+test('면세 줄과 영세율 청구서의 부가세는 0이다', () => {
+  const exempt = computeTotals(draft([{ name: '책', unitPrice: 16800, taxType: 'exempt' }]))
+  assert.strictEqual(exempt.vat, 0)
+  const zero = computeTotals(draft([{ name: 'A', unitPrice: 3845 }], { zeroRated: true }))
+  assert.strictEqual(zero.vat, 0)
+})
+
+test('견적서도 줄별 버림 규칙이다 (필드 모양 유지)', () => {
+  const q = createQuote({
+    number: 'Q-0457',
+    customerId: 'C-0388',
+    issueDate: '2026-10-06',
+    lines: [
+      { name: '네임펜', unitPrice: 905, qty: 11 },
+      { name: '전선 몰드', unitPrice: 1237, qty: 8, discount: { percent: 15 } },
+      { name: '클리어파일', unitPrice: 3215, qty: 3, discount: { amount: 777 } },
+      { name: '마우스패드', unitPrice: 2164, qty: 4 },
+      { name: '세무 가이드', unitPrice: 16800, taxType: 'exempt' },
+    ],
+  })
+  assert.deepStrictEqual(q.totals, { supply: 52691, taxable: 35891, exempt: 16800, vat: 995 + 841 + 886 + 865, total: 56278 })
+})
+
+test('견적서: 할인 전 금액이 아니라 할인된 줄에 부가세를 매긴다', () => {
+  // 줄 1000 - 1 = 999원 -> 99원 (할인 전 1000원 기준 100원에서 할인분 0원을 빼면 100원)
+  const q = createQuote({
+    number: 'Q-0001',
+    customerId: 'C-1',
+    issueDate: '2026-10-06',
+    lines: [{ name: 'a', unitPrice: 1000, discount: { amount: 1 } }],
+  })
+  assert.strictEqual(q.totals.vat, 99)
+})
+
+test('반품 전표도 줄별 버림 규칙이다', () => {
+  const inv = issueInvoice(
+    draft([
+      { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 8, discount: { amount: 1500 } },
+      { sku: 'OF-2150', name: '형광펜', unitPrice: 2150, qty: 6, discount: { percent: 5 } },
+      { sku: 'OF-0415', name: '지우개', unitPrice: 415, qty: 9 },
+    ]),
+    { number: 'INV-2047', issueDate: '2026-09-24' },
+  )
+  const cn = createCreditNote(inv, {
+    number: 'CN-0112',
+    issueDate: '2026-10-06',
+    reason: '파손',
+    returns: [
+      { sku: 'OF-1342', qty: 8 },
+      { sku: 'OF-2150', qty: 3 },
+      { sku: 'OF-0415', qty: 5 },
+    ],
+  })
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 923 + 612 + 207, total: 19180 })
+})
