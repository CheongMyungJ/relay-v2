diff --git a/tree/src/invoice/vat.js b/tree/src/invoice/vat.js
new file mode 100644
index 0000000..0b12c6a
--- /dev/null
+++ b/tree/src/invoice/vat.js
@@ -0,0 +1,15 @@
+import { VAT_RATE_PERCENT } from '../config.js'
+import { assertWon, sumWon } from '../money.js'
+
+// 부가세는 과세 품목 줄마다 할인된 줄 금액(net)에 세율을 곱해 원 단위 미만을 버리고, 그 합을 문서의 부가세로 쓴다
+// (회계팀 규칙). 면세 줄과 영세율 문서의 부가세는 0이다
+export function lineVat(net, { taxable = true, zeroRated = false } = {}) {
+  assertWon(net)
+  if (!taxable || zeroRated) return 0
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
+// rows: [{ net, taxable }] 줄별 부가세의 합
+export function sumLineVat(rows, { zeroRated = false } = {}) {
+  return sumWon(rows.map((r) => lineVat(r.net, { taxable: r.taxable, zeroRated })))
+}
