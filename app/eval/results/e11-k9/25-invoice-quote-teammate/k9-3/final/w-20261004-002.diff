+  // 줄별 공급가액 9,236 / 6,127 / 2,075 → 923 + 612 + 207 (합계에서 반올림하면 1,744)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('면세 줄이 섞인 반품 전표는 과세 줄만 줄별 버림한다', () => {
+  const cn = note([
