@@ -81,3 +82,40 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세는 과세 줄마다 버림한 합이다', () => {
+  const invoice = {
+    status: 'issued',
+    number: 'INV-0200',
+    customerId: 'C-0412',
+    issueDate: '2026-09-01',
+    zeroRated: false,
+    lines: [
+      { sku: 'A-1', name: 'A', unitPrice: 105, qty: 1, taxType: 'taxable' },
+      { sku: 'A-2', name: 'B', unitPrice: 105, qty: 1, taxType: 'taxable' },
+      { sku: 'E-1', name: '면세', unitPrice: 999, qty: 1, taxType: 'exempt' },
+    ],
+  }
+  const make = (extra = {}) =>
+    createCreditNote({ ...invoice, ...extra }, {
+      number: 'CN-0200',
+      issueDate: '2026-09-10',
+      reason: '파손',
+      returns: [{ sku: 'A-1', qty: 1 }, { sku: 'A-2', qty: 1 }, { sku: 'E-1', qty: 1 }],
+    })
+  // 줄별 버림 10 + 10 = 20 (합계 기준 반올림이면 21)
+  assert.deepStrictEqual(make().totals, { supply: 1209, taxable: 210, exempt: 999, vat: 20, total: 1229 })
+  assert.strictEqual(make({ zeroRated: true }).totals.vat, 0)
+})
+
+test('CN-0112 부가세는 줄별 버림 합이다', () => {
+  const invoice = JSON.parse(readFileSync('examples/INV-2047.json', 'utf8'))
+  const data = JSON.parse(readFileSync('examples/CN-0112.json', 'utf8'))
+  const cn = createCreditNote(invoice, data)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('저장된 totals가 있으면 다시 계산하지 않는다', () => {
+  const stored = { totals: { supply: 1, taxable: 1, exempt: 0, vat: 9, total: 10 }, lines: [], zeroRated: false }
+  assert.deepStrictEqual(creditNoteTotals(stored), stored.totals)
+})
