diff --git a/tree/test/vat-rule.test.js b/tree/test/vat-rule.test.js
new file mode 100644
index 0000000..c397c5b
--- /dev/null
+++ b/tree/test/vat-rule.test.js
@@ -0,0 +1,89 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createCreditNote } from '../src/invoice/credit-note.js'
+import { createInvoice } from '../src/invoice/invoice.js'
+import { createQuote } from '../src/invoice/quote.js'
+import { computeTotals } from '../src/invoice/total.js'
+
+const example = (name) => JSON.parse(readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+
+// 회계팀 규정: 할인은 줄마다 부가세 전에, 부가세는 할인된 과세 줄 금액에 줄마다 원 단위 버림, 합계에서 다시 반올림하지 않는다
+const discounted = [
+  { sku: 'A', name: 'A', unitPrice: 1337, qty: 3, discount: { percent: 10 } }, // net 3610(반올림 할인 401) → 361
+  { sku: 'B', name: 'B', unitPrice: 999, qty: 1 }, // 99
+  { sku: 'C', name: 'C', unitPrice: 5555, qty: 1, taxType: 'exempt' }, // 면세 0
+]
+
+test('청구서: 할인된 과세 줄 금액에 줄별 버림 부가세', () => {
+  const t = computeTotals(createInvoice({ customerId: 'C-1', lines: discounted }))
+  assert.strictEqual(t.vat, 361 + 99)
+  assert.strictEqual(t.total, t.supply + 460)
+})
+
+test('견적: 할인된 과세 줄 금액에 줄별 버림 부가세', () => {
+  const q = createQuote({ number: 'Q-0900', customerId: 'C-1', issueDate: '2026-10-01', lines: discounted })
+  assert.strictEqual(q.totals.vat, 361 + 99)
+  assert.strictEqual(q.totals.total, q.totals.supply + 460)
+})
+
+test('반품 전표: 할인된 과세 줄 금액에 줄별 버림 부가세', () => {
+  const inv = { ...createInvoice({ customerId: 'C-1', lines: discounted }), number: 'INV-0900', status: 'issued', issueDate: '2026-09-01' }
+  const cn = createCreditNote(inv, {
+    number: 'CN-0900',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: discounted.map((l) => ({ sku: l.sku, qty: l.qty })),
+  })
+  assert.strictEqual(cn.totals.vat, 361 + 99)
+})
+
+test('영세율은 부가세 0', () => {
+  const lines = discounted.map((l) => ({ ...l }))
+  assert.strictEqual(computeTotals(createInvoice({ customerId: 'C-1', lines, zeroRated: true })).vat, 0)
+  assert.strictEqual(
+    createQuote({ number: 'Q-0901', customerId: 'C-1', issueDate: '2026-10-01', lines, zeroRated: true }).totals.vat,
+    0,
+  )
+})
+
+test('INV-2031 예시: 공급가액 26,438 부가세 2,641 합계 29,079', () => {
+  const t = computeTotals(createInvoice(example('INV-2031')))
+  assert.deepStrictEqual([t.supply, t.vat, t.total], [26438, 2641, 29079])
+})
+
+test('Q-0457 예시: 공급가액 52,691 부가세 3,587 합계 56,278', () => {
+  const t = createQuote(example('Q-0457')).totals
+  assert.deepStrictEqual([t.supply, t.vat, t.total], [52691, 3587, 56278])
+})
+
+test('CN-0112 예시(INV-2047): 공급가액 17,438 부가세 1,742 합계 19,180', () => {
+  const { number, issueDate, reason, returns } = example('CN-0112')
+  const t = createCreditNote(example('INV-2047'), { number, issueDate, reason, returns }).totals
+  assert.deepStrictEqual([t.supply, t.vat, t.total], [17438, 1742, 19180])
+})
+
+test('반품 전표: 영세율 청구서의 반품은 부가세 0', () => {
+  const inv = {
+    ...createInvoice({ customerId: 'C-1', lines: discounted, zeroRated: true }),
+    number: 'INV-0901',
+    status: 'issued',
+    issueDate: '2026-09-01',
+  }
+  const cn = createCreditNote(inv, {
+    number: 'CN-0901',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: discounted.map((l) => ({ sku: l.sku, qty: l.qty })),
+  })
+  assert.strictEqual(cn.totals.vat, 0)
+  assert.strictEqual(cn.totals.total, cn.totals.supply)
+})
+
+test('면세 줄만 있는 청구서·견적은 부가세 0', () => {
+  const lines = [{ sku: 'C', name: 'C', unitPrice: 5555, qty: 3, taxType: 'exempt' }]
+  const t = computeTotals(createInvoice({ customerId: 'C-1', lines }))
+  assert.deepStrictEqual([t.vat, t.total], [0, t.supply])
+  const q = createQuote({ number: 'Q-0902', customerId: 'C-1', issueDate: '2026-10-01', lines }).totals
+  assert.deepStrictEqual([q.vat, q.total], [0, q.supply])
+})
