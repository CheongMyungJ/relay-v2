diff --git a/tree/src/invoice/vat.js b/tree/src/invoice/vat.js
new file mode 100644
index 0000000..b605e75
--- /dev/null
+++ b/tree/src/invoice/vat.js
@@ -0,0 +1,15 @@
+import { VAT_RATE_PERCENT } from '../config.js'
+import { assertWon, sumWon } from '../money.js'
+
+// 과세 줄 하나의 부가세. 할인한 뒤 공급가액에 매기고 원 단위로 내린다(회계팀 방식)
+export function lineVat(net) {
+  assertWon(net)
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
+// 줄마다 낸 부가세의 합. 합계에서 다시 반올림하지 않는다. 영세율이면 0
+// rows: [{ net, taxable }]
+export function sumLineVat(rows, zeroRated) {
+  if (zeroRated) return 0
+  return sumWon(rows.filter((r) => r.taxable).map((r) => lineVat(r.net)))
+}
