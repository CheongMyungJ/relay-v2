diff --git a/tree/src/invoice/vat.js b/tree/src/invoice/vat.js
new file mode 100644
index 0000000..61e3036
--- /dev/null
+++ b/tree/src/invoice/vat.js
@@ -0,0 +1,14 @@
+import { VAT_RATE_PERCENT } from '../config.js'
+import { assertWon, sumWon } from '../money.js'
+
+// 과세 줄 하나의 부가세. 할인된 줄 공급가액의 10%를 원 단위로 내린다
+export function lineVat(net, zeroRated = false) {
+  assertWon(net)
+  if (zeroRated) return 0
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
+// 과세 줄들의 부가세 합. 줄마다 내림한 값을 더하고, 합계에서 다시 반올림하지 않는다
+export function sumLineVat(nets, zeroRated = false) {
+  return sumWon(nets.map((net) => lineVat(net, zeroRated)))
+}
