+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { earnPoints } from '../src/points/earn.js'
+
+test('O-1042: 배송비를 뺀 23,770원 기준으로 237P', () => {
+  const input = JSON.parse(fs.readFileSync(new URL('../examples/O-1042.json', import.meta.url), 'utf8'))
+  const o = createOrder(input)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비가 무료인 주문도 상품금액 - 쿠폰 - 사용 포인트 기준', () => {
+  const amounts = { goods: 40000, coupon: 2000, shipping: 0, pointsUsed: 1000, total: 37000 }
+  assert.strictEqual(earnPoints({ amounts }), 370)
+})
+
+test('적립 포인트의 소수점은 버린다', () => {
+  const amounts = { goods: 26770, coupon: 3000, shipping: 0, pointsUsed: 0, total: 23770 }
+  assert.strictEqual(earnPoints({ amounts }), 237)
+})
+
+test('배송비는 적립 기준에서 제외한다', () => {
+  const amounts = { goods: 10000, coupon: 0, shipping: 3000, pointsUsed: 0, total: 13000 }
+  assert.strictEqual(earnPoints({ amounts }), 100)
+})
