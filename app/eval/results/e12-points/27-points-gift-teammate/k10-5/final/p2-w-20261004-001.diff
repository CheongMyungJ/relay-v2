+---
+kind: rule
+source: investigation
+anchor: earnPoints
+---
+# 적립 예정 포인트는 (상품 금액 − 쿠폰 − 사용 포인트)의 1%를 원 단위로 내림한다
+
+## 규칙
+- 적립 기준 금액은 `goods − coupon − pointsUsed`이고 배송비는 뺀다.
+- 적립률(`POINT_RATE_PERCENT`, 1%)을 곱한 값은 원 단위로 내림한다. 반올림하지 않는다.
+- 근거는 고객센터 계산 O-1042 = 237P 한 건이다 (상품 28,270 − 쿠폰 3,000 − 포인트 1,500 = 23,770, 1% = 237.7 → 237).
+- 공용 `percentOf`(src/money.js)는 반올림이며 환불 회수도 쓰므로 고치지 않고, 계산은 `src/points/earn.js` 안에서 한다.
+- 선물하기 적립(`giftPoints`, src/gift/gift-points.js)도 `earnPoints`를 그대로 쓴다. 적립 기준과 내림을 한 곳에 둔다. 근거는 고객센터 기준 G-0213 = 218P (상품 24,860 − 쿠폰 2,000 − 포인트 1,000 = 21,860, 1% = 218.6 → 218).
+
+## 아직 규칙을 따르지 않는 곳
+- src/orders/refund.js:34: 부분 환불 회수가 `percentOf(refundGoods)` 반올림이라 새 적립 규칙과 1P 어긋날 수 있다. (Work w-20261004-001)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
+- 2026-10-04 src/gift/gift-points.js를 규칙대로 고침 (Work w-20261004-001)
diff --git a/base/src/gift/gift-points.js b/tree/src/gift/gift-points.js
index 31d9ca8..95a1c3e 100644
--- a/base/src/gift/gift-points.js
+++ b/tree/src/gift/gift-points.js
@@ -1,7 +1,6 @@
-import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { earnPoints } from '../points/earn.js'
 
-/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다) */
+/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다). 일반 주문과 같은 적립 기준을 쓴다 */
 export function giftPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnPoints(order)
 }
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..2562186 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. (상품 금액 - 쿠폰 - 사용 포인트)의 POINT_RATE_PERCENT%를 원 단위로 내림한다. 배송비는 뺀다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
