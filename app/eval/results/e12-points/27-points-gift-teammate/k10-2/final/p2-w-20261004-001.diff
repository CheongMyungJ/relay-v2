diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..53c5010 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,6 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 결제 금액의 POINT_RATE_PERCENT%, 원 단위 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return Math.floor(((order.amounts.total - order.amounts.shipping) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/base/test/gift.test.js b/tree/test/gift.test.js
index 898969e..a19d05a 100644
--- a/base/test/gift.test.js
+++ b/tree/test/gift.test.js
@@ -21,3 +21,24 @@ test('메시지 카드는 60자까지', () => {
 test('받는 사람 전화번호 형식', () => {
   assert.throws(() => createGiftOrder({ ...base, number: 'G-0003', recipient: { name: '김하늘', phone: '01012345678' } }), /010-0000-0000/)
 })
+
+test('선물하기 적립 포인트는 배송비를 뺀 결제 금액을 기준으로 한다 (G-0213)', () => {
+  const g = createGiftOrder({
+    customerId: 'U-08871',
+    number: 'G-0213',
+    recipient: { name: '한서윤', phone: '010-4821-3307' },
+    message: '이사 축하해! 맛있게 먹어',
+    lines: [{ sku: 'HN-0120', unitPrice: 15900, qty: 1 }, { sku: 'JM-0332', unitPrice: 4480, qty: 2 }],
+    coupon: { code: 'GIFT2000', amount: 2000 },
+    pointsUsed: 1000,
+    pointBalance: 6210,
+  })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 218)
+})
+
+test('선물하기 적립 포인트는 원 단위 버림이다 (배송비 0원, 350.5P)', () => {
+  const g = createGiftOrder({ ...base, number: 'G-0004', lines: [{ sku: 'A', unitPrice: 35050 }] })
+  assert.strictEqual(g.amounts.shipping, 0)
+  assert.strictEqual(g.points.earned, 350)
+})
