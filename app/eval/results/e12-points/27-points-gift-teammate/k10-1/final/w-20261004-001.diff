+---
+kind: rule
+source: human
+anchor: earnPoints
+---
+# 적립 포인트는 배송비를 뺀, 쿠폰·포인트 차감 후 상품 금액의 적립률을 원 단위 버림으로 계산한다
+
+## 규칙
+- 적립 기준 금액 = 상품 금액(goods) − 쿠폰 할인 − 사용 포인트. 배송비는 넣지 않는다.
+- 적립 포인트 = 기준 금액 × POINT_RATE_PERCENT% 를 원 단위 미만 버림 (`floorPercentOf`). 예: O-1042는 (28,270 − 3,000 − 1,500) = 23,770원의 1% = 237.7 → 237P.
+- 이미 적립된 주문은 저장된 `points.earned`를 그대로 쓰고 다시 계산하지 않는다.
+
+## 아직 규칙을 따르지 않는 곳
+- src/gift/gift-points.js: 결제 금액(total)의 반올림 `percentOf`로 계산. 사람이 Work w-20261004-001의 범위에서 뺌(2026-10-04)
+- src/orders/refund.js:34: 부분 환불 포인트 회수가 `percentOf(refundGoods)` 반올림, 쿠폰·포인트 차감 전 금액 기준. 적립 기준과 달라 적립보다 많거나 적게 회수될 수 있음
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/money.js b/tree/src/money.js
index 4ce3f7b..cea0b8f 100644
--- a/base/src/money.js
+++ b/tree/src/money.js
@@ -14,6 +14,11 @@ export function percentOf(amount, percent) {
   return Math.round((amount * percent) / 100)
 }
 
+/** 금액의 percent%. 원 단위 미만을 버린다 */
+export function floorPercentOf(amount, percent) {
+  return Math.floor((amount * percent) / 100)
+}
+
 /** 10원 단위 버림 */
 export function floorTen(amount) {
   return Math.floor(amount / 10) * 10
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..4460a00 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,8 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀, 쿠폰·포인트 사용 차감 후 상품 금액의 POINT_RATE_PERCENT%, 원 단위 미만 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return floorPercentOf(goods - coupon - pointsUsed, POINT_RATE_PERCENT)
 }
