+
+/** 적립 기준 금액. 상품 금액 - 쿠폰 할인 - 사용 포인트 (배송비 제외) */
+export function earnBase({ goods, coupon, pointsUsed }) {
+  return goods - coupon - pointsUsed
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..b7c8de5
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,28 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+
+test('적립 기준 금액은 배송비를 뺀다', () => {
+  const o = createOrder({ ...base, number: 'O-0010', lines: [{ sku: 'A', unitPrice: 10000, qty: 2 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 200)
+})
+
+test('적립 포인트는 소수점을 버린다', () => {
+  const o = createOrder({ ...base, number: 'O-0011', lines: [{ sku: 'A', unitPrice: 12999, qty: 2 }] })
+  assert.strictEqual(o.points.earned, 259)
+})
+
+test('O-1042: 쿠폰과 사용 포인트를 빼고 배송비는 뺀 23,770원의 1% = 237P', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [{ sku: 'TE', unitPrice: 8900, qty: 2 }, { sku: 'SN', unitPrice: 3490, qty: 3 }],
+    coupon: { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 },
+    pointsUsed: 1500,
+  })
+  assert.strictEqual(o.amounts.total, 26770)
+  assert.strictEqual(o.points.earned, 237)
+})
diff --git a/tree/test/refund-points.test.js b/tree/test/refund-points.test.js
new file mode 100644
index 0000000..8f7434d
--- /dev/null
+++ b/tree/test/refund-points.test.js
@@ -0,0 +1,40 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { cancelOrder, createRefund } from '../src/orders/refund.js'
+
+const o = createOrder({
+  customerId: 'U-1',
+  orderedAt: '2026-10-01T10:00:00+09:00',
+  number: 'O-1042',
+  lines: [{ sku: 'TE', unitPrice: 8900, qty: 2 }, { sku: 'SN', unitPrice: 3490, qty: 3 }],
+  coupon: { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 },
+  pointsUsed: 1500,
+})
+
+test('부분 환불 회수는 쿠폰·사용 포인트를 상품 금액 비율로 나눠 뺀 금액의 1%를 버림한다', () => {
+  // 3490 * 23770 / 28270 = 2934.6 → 29P
+  assert.strictEqual(createRefund(o, { number: 'R-0001', items: [{ sku: 'SN', qty: 1 }] }).pointsRecovered, 29)
+})
+
+test('쿠폰·포인트가 없으면 환불 상품 금액의 1%를 버림한다', () => {
+  const p = createOrder({ customerId: 'U-1', orderedAt: o.orderedAt, number: 'O-0020', lines: [{ sku: 'A', unitPrice: 3490, qty: 10 }] })
+  assert.strictEqual(createRefund(p, { number: 'R-0002', items: [{ sku: 'A', qty: 1 }] }).pointsRecovered, 34)
+})
+
+test('나눠 환불한 회수 합계가 적립액을 넘지 않는다', () => {
+  const plans = [
+    [['SN', 1], ['SN', 1], ['SN', 1], ['TE', 1]],
+    [['TE', 1], ['SN', 1], ['SN', 1], ['SN', 1]],
+  ]
+  for (const plan of plans) {
+    let sum = 0
+    const already = []
+    for (const [sku, qty] of plan) {
+      sum += createRefund(o, { number: 'R-0003', items: [{ sku, qty }], alreadyRefunded: already }).pointsRecovered
+      already.push({ sku, qty })
+    }
+    assert.ok(sum <= o.points.earned, `${sum} > ${o.points.earned}`)
+  }
+  assert.strictEqual(cancelOrder(o).pointsRecovered, 237)
+})
