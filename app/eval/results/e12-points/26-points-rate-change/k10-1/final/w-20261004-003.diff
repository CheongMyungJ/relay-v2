+++ b/tree/src/points/earn.js
@@ -1,7 +1,12 @@
-import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { EARN_RATE_PERCENT } from '../config.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액. 상품 − 쿠폰 − 사용 포인트(배송비 제외) */
+export function earnBase(order) {
+  const a = order.amounts
+  return a.goods - a.coupon - a.pointsUsed
+}
+
+/** 주문의 적립 포인트. 기준 금액의 EARN_RATE_PERCENT%, 1P 미만 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return Math.floor((earnBase(order) * EARN_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..c828f95
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,27 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { earnBase, earnPoints } from '../src/points/earn.js'
+import { cancelOrder } from '../src/orders/refund.js'
+import { receiptLines } from '../src/format/receipt.js'
+import { giftPoints } from '../src/gift/gift-points.js'
+
+const o1107 = JSON.parse(readFileSync(new URL('../examples/O-1107.json', import.meta.url), 'utf8'))
+
+test('O-1107: (상품 − 쿠폰 − 사용 포인트) 24,330의 2%, 배송비 제외, 1P 미만 버림 = 486P', () => {
+  const o = createOrder(o1107)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(earnBase(o), 24330)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('선물하기도 같은 기준이다', () => {
+  assert.strictEqual(giftPoints(createOrder(o1107)), 486)
+})
+
+test('이미 저장된 points.earned는 다시 계산하지 않고 저장된 값을 쓴다', () => {
+  const stored = { ...createOrder(o1107), points: { used: 1020, earned: 243 } }
+  assert.strictEqual(cancelOrder(stored).pointsRecovered, 243)
+  assert.ok(receiptLines(stored).some((l) => l.includes('243')))
+})
