@@ -1,6 +1,7 @@
-import { POINT_RATE_PERCENT, REFUND_NUMBER } from '../config.js'
+import { REFUND_NUMBER } from '../config.js'
 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { earnBase, pointsForBase } from '../points/earn.js'
+import { sumWon } from '../money.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
@@ -26,12 +27,23 @@ export function createRefund(order, input) {
   const remainingGoods = order.amounts.goods - refundedBefore - refundGoods
   if (remainingGoods < order.amounts.coupon + order.amounts.pointsUsed)
     throw new Error('남은 상품 금액이 쿠폰 할인과 사용 포인트보다 적다. 전체 취소로 처리한다')
+  // 회수 포인트: (환불 전 적립) − (남은 상품 기준 금액의 적립, 버림). 쿠폰과 사용 포인트는 남은 주문에 남는다.
+  // 첫 환불의 환불 전 적립은 저장된 points.earned이고, 이미 환불한 줄이 있으면 앞 환불이 저장값과의 차이를
+  // 이미 회수했으므로 환불 전 상품 기준으로 계산한다. 그래야 나눠 환불한 합이 earned − 최종 남은 적립이 된다.
+  const { coupon, pointsUsed } = order.amounts
+  const goodsBefore = order.amounts.goods - refundedBefore
+  const pointsBefore =
+    refundedBefore === 0
+      ? order.points.earned
+      : pointsForBase(earnBase({ goods: goodsBefore, coupon, pointsUsed }))
+  const pointsRecovered =
+    pointsBefore - pointsForBase(earnBase({ goods: remainingGoods, coupon, pointsUsed }))
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered,
   }
 }
 
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..758457c 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -5,3 +5,13 @@ import { percentOf } from '../money.js'
 export function earnPoints(order) {
   return percentOf(order.amounts.total, POINT_RATE_PERCENT)
 }
+
+/** 적립 기준 금액. 상품 금액 − 쿠폰 − 사용 포인트(배송비는 넣지 않는다) */
+export function earnBase({ goods, coupon, pointsUsed }) {
+  return goods - coupon - pointsUsed
+}
+
+/** 기준 금액의 POINT_RATE_PERCENT%를 원 단위로 버림한 포인트 */
+export function pointsForBase(base) {
+  return Math.floor((base * POINT_RATE_PERCENT) / 100)
+}
diff --git a/tree/test/refund-points.test.js b/tree/test/refund-points.test.js
new file mode 100644
index 0000000..9592adf
--- /dev/null
+++ b/tree/test/refund-points.test.js
@@ -0,0 +1,93 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createRefund } from '../src/orders/refund.js'
+
+const read = (f) => JSON.parse(fs.readFileSync(new URL(`../examples/${f}`, import.meta.url), 'utf8'))
+
+test('R-0311: 회수 포인트는 환불 전후 적립(버림)의 차이다 (403 − 271 = 132)', () => {
+  const r = createRefund(read('O-1077.json'), read('R-0311.json'))
+  assert.strictEqual(r.pointsRecovered, 132)
+  assert.strictEqual(r.refundAmount, 13130)
+})
+
+test('나눠서 환불한 회수 포인트의 합은 전체 환불의 회수 포인트와 같다', () => {
+  const order = {
+    number: 'O-0200',
+    lines: [
+      { sku: 'A', name: 'A', unitPrice: 1990, qty: 3 },
+      { sku: 'B', name: 'B', unitPrice: 4990, qty: 1 },
+      { sku: 'C', name: 'C', unitPrice: 3330, qty: 2 },
+    ],
+    coupon: null,
+    amounts: { goods: 17620, coupon: 0, shipping: 3000, pointsUsed: 0, total: 20620 },
+    points: { used: 0, earned: 176 },
+  }
+  const all = createRefund(order, {
+    number: 'R-0200',
+    items: [{ sku: 'A', qty: 3 }, { sku: 'B', qty: 1 }, { sku: 'C', qty: 2 }],
+  })
+  const first = createRefund(order, { number: 'R-0201', items: [{ sku: 'A', qty: 1 }] })
+  const second = createRefund(order, {
+    number: 'R-0202',
+    items: [{ sku: 'C', qty: 2 }],
+    alreadyRefunded: [{ sku: 'A', qty: 1 }],
+  })
+  const third = createRefund(order, {
+    number: 'R-0203',
+    items: [{ sku: 'A', qty: 2 }, { sku: 'B', qty: 1 }],
+    alreadyRefunded: [{ sku: 'A', qty: 1 }, { sku: 'C', qty: 2 }],
+  })
+  assert.strictEqual(all.pointsRecovered, 176)
+  assert.strictEqual(first.pointsRecovered + second.pointsRecovered + third.pointsRecovered, all.pointsRecovered)
+})
+
+test('저장된 earned가 재계산값과 달라도 나눠 환불한 합은 earned − 최종 남은 적립이다', () => {
+  const order = {
+    number: 'O-0201',
+    lines: [
+      { sku: 'A', name: 'A', unitPrice: 1990, qty: 3 },
+      { sku: 'B', name: 'B', unitPrice: 4990, qty: 1 },
+    ],
+    coupon: null,
+    amounts: { goods: 10960, coupon: 0, shipping: 3000, pointsUsed: 0, total: 13960 },
+    points: { used: 0, earned: 140 }, // 옛 기준(배송비 포함 반올림)으로 저장된 값
+  }
+  const first = createRefund(order, { number: 'R-0210', items: [{ sku: 'A', qty: 1 }] })
+  const second = createRefund(order, {
+    number: 'R-0211',
+    items: [{ sku: 'B', qty: 1 }],
+    alreadyRefunded: [{ sku: 'A', qty: 1 }],
+  })
+  assert.strictEqual(first.pointsRecovered, 140 - 89) // 남은 8970원 → 89P
+  assert.strictEqual(second.pointsRecovered, 89 - 39) // 남은 3980원 → 39P
+  const rest = createRefund(order, {
+    number: 'R-0212',
+    items: [{ sku: 'A', qty: 2 }],
+    alreadyRefunded: [{ sku: 'A', qty: 1 }, { sku: 'B', qty: 1 }],
+  })
+  assert.strictEqual(first.pointsRecovered + second.pointsRecovered + rest.pointsRecovered, 140)
+})
+
+test('쿠폰과 사용 포인트가 있는 주문도 나눠 환불한 합은 earned − 최종 남은 적립이다', () => {
+  const order = {
+    number: 'O-0202',
+    lines: [
+      { sku: 'A', name: 'A', unitPrice: 4000, qty: 1 },
+      { sku: 'B', name: 'B', unitPrice: 5000, qty: 1 },
+      { sku: 'C', name: 'C', unitPrice: 11000, qty: 1 },
+    ],
+    coupon: null,
+    amounts: { goods: 20000, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 13000 },
+    points: { used: 2000, earned: 130 },
+  }
+  const first = createRefund(order, { number: 'R-0220', items: [{ sku: 'A', qty: 1 }] })
+  const second = createRefund(order, {
+    number: 'R-0221',
+    items: [{ sku: 'B', qty: 1 }],
+    alreadyRefunded: [{ sku: 'A', qty: 1 }],
+  })
+  assert.strictEqual(first.pointsRecovered, 130 - 90) // 남은 16000 − 7000 = 9000 → 90P
+  assert.strictEqual(second.pointsRecovered, 90 - 40) // 남은 11000 − 7000 = 4000 → 40P
+  assert.strictEqual(first.pointsRecovered + second.pointsRecovered, 130 - 40)
+})
