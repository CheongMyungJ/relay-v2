+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const example = JSON.parse(readFileSync(new URL('../examples/O-1107.json', import.meta.url)))
+
+test('O-1107: 기준 24,330원(배송비 제외)의 2%를 버림해 486P 적립한다', () => {
+  assert.strictEqual(createOrder(example).points.earned, 486)
+})
+
+test('부분 환불 회수는 이번 적립률 변경과 상관없이 기존 계산(1%)을 유지한다', () => {
+  const order = {
+    number: 'O-0100',
+    lines: [{ sku: 'B', unitPrice: 10000, qty: 1 }, { sku: 'A', unitPrice: 40000, qty: 1 }],
+    amounts: { goods: 50000, coupon: 0, shipping: 0, pointsUsed: 0, total: 50000 },
+    points: { used: 0, earned: 500 },
+  }
+  assert.strictEqual(createRefund(order, { number: 'R-0001', items: [{ sku: 'B', qty: 1 }] }).pointsRecovered, 100)
+})
