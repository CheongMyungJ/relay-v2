diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..2ed5ae1 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,18 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액: 상품 금액 − 쿠폰 − 사용 포인트. 배송비는 넣지 않는다 */
+export function earnBase(goods, coupon, pointsUsed) {
+  return goods - coupon - pointsUsed
+}
+
+/** 적립 기준 금액의 POINT_RATE_PERCENT%를 원 단위로 버림한 포인트 */
+export function pointsForBase(base) {
+  return floorPercentOf(base, POINT_RATE_PERCENT)
+}
+
+/** 주문의 적립 포인트. 주문 적립, 선물 적립, 환불 회수가 모두 이 기준을 쓴다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const a = order.amounts
+  return pointsForBase(earnBase(a.goods, a.coupon, a.pointsUsed))
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..0b04245
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,68 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund, cancelOrder } from '../src/orders/refund.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+const gift = { ...base, recipient: { name: '김하늘', phone: '010-1234-5678' } }
+
+test('O-1042: 배송비를 빼고 버림하면 237P', () => {
+  const input = JSON.parse(fs.readFileSync(new URL('../examples/O-1042.json', import.meta.url), 'utf8'))
+  const o = createOrder(input)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비가 있는 주문과 없는 주문 모두 적립 기준에 배송비가 들어가지 않는다', () => {
+  const withShip = createOrder({ ...base, number: 'O-0010', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(withShip.amounts.shipping, 3000)
+  assert.strictEqual(withShip.points.earned, 100)
+  const free = createOrder({ ...base, number: 'O-0011', lines: [{ sku: 'A', unitPrice: 30000, qty: 1 }] })
+  assert.strictEqual(free.amounts.shipping, 0)
+  assert.strictEqual(free.points.earned, 300)
+})
+
+test('쿠폰과 사용 포인트는 적립 기준에서 뺀다', () => {
+  const o = createOrder({
+    ...base, number: 'O-0012', lines: [{ sku: 'A', unitPrice: 20000, qty: 2 }],
+    coupon: { code: 'C', amount: 3000 }, pointsUsed: 1000,
+  })
+  assert.strictEqual(o.points.earned, 360)
+})
+
+test('1% 계산에 소수점이 생기면 버림한다', () => {
+  const o = createOrder({ ...base, number: 'O-0013', lines: [{ sku: 'A', unitPrice: 39999, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 399)
+  const g = createGiftOrder({ ...gift, number: 'G-0010', lines: [{ sku: 'A', unitPrice: 39990, qty: 1 }] })
+  assert.strictEqual(g.points.earned, 399)
+})
+
+test('선물 적립도 배송비를 빼고 버림한다', () => {
+  const g = createGiftOrder({ ...gift, number: 'G-0011', lines: [{ sku: 'A', unitPrice: 15950, qty: 1 }], pointsUsed: 1000 })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 149)
+})
+
+test('부분 환불 회수 포인트는 같은 기준이고, 나눠 환불한 합이 전체 적립과 같다', () => {
+  const o = createOrder({
+    ...base, number: 'O-0014',
+    lines: [{ sku: 'A', unitPrice: 12345, qty: 1 }, { sku: 'B', unitPrice: 9999, qty: 1 }, { sku: 'C', unitPrice: 7777, qty: 1 }],
+    coupon: { code: 'C', amount: 1000 }, pointsUsed: 1000,
+  })
+  assert.strictEqual(o.points.earned, 281) // (30121 - 1000 - 1000) * 1%
+  const r1 = createRefund(o, { number: 'R-0001', items: [{ sku: 'A', qty: 1 }] })
+  const r2 = createRefund(o, { number: 'R-0002', items: [{ sku: 'B', qty: 1 }], alreadyRefunded: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r1.pointsRecovered, 124) // 281 - 157
+  assert.strictEqual(r2.pointsRecovered, 100) // 157 - 57
+  assert.strictEqual(r1.pointsRecovered + r2.pointsRecovered, o.points.earned - 57) // 남은 C 몫(57P)은 전체 취소 때 회수
+})
+
+test('배송비가 있는 주문의 환불 회수 포인트에도 배송비가 들어가지 않는다', () => {
+  const o = createOrder({ ...base, number: 'O-0015', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }, { sku: 'B', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  const r = createRefund(o, { number: 'R-0003', items: [{ sku: 'B', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 100)
+  assert.strictEqual(cancelOrder(o).pointsRecovered, o.points.earned)
+})
