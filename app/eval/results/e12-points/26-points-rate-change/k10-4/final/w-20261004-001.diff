@@ -1,7 +1,12 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { percentOfFloor } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 대상 금액: 상품 금액 − 쿠폰 할인 − 사용한 포인트. 배송비는 뺀다 */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 주문의 적립 포인트. 적립 대상 금액의 POINT_RATE_PERCENT%, 1P 미만 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return percentOfFloor(earnBase(order.amounts), POINT_RATE_PERCENT)
 }
diff --git a/tree/test/points-earn.test.js b/tree/test/points-earn.test.js
new file mode 100644
index 0000000..282f75b
--- /dev/null
+++ b/tree/test/points-earn.test.js
@@ -0,0 +1,60 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const input = {
+  number: 'O-0200',
+  customerId: 'U-1',
+  lines: [
+    { sku: 'A', unitPrice: 8900, qty: 2 },
+    { sku: 'B', unitPrice: 3490, qty: 3 },
+  ],
+  coupon: { code: 'C', amount: 3000, minGoods: 20000 },
+  pointsUsed: 1500,
+}
+
+test('배송비가 붙는 주문: 배송비는 적립 금액에 들어가지 않고 1P 미만은 버린다 (O-1042 → 237P)', () => {
+  const o = createOrder(input)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('무료 배송 주문: 상품 − 쿠폰 − 사용 포인트의 1%', () => {
+  const o = createOrder({ ...input, lines: [{ sku: 'A', unitPrice: 40000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 355)
+})
+
+test('1P 미만은 반올림이 아니라 버림 (23,790원 → 237P, 반올림이면 238P)', () => {
+  const o = createOrder({ ...input, pointsUsed: 1480 })
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('선물하기 적립도 같은 기준 (G-0213 → 218P)', () => {
+  const g = createGiftOrder({
+    number: 'G-0213',
+    customerId: 'U-1',
+    recipient: { name: '한서윤', phone: '010-4821-3307' },
+    lines: [
+      { sku: 'H', unitPrice: 15900, qty: 1 },
+      { sku: 'J', unitPrice: 4480, qty: 2 },
+    ],
+    coupon: { code: 'G', amount: 2000 },
+    pointsUsed: 1000,
+  })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 218)
+})
+
+test('환불 회수 포인트는 1P 미만 버림 (R-0311 환불 13,130원 → 131P)', () => {
+  const order = {
+    number: 'O-1077',
+    lines: [{ sku: 'SP', unitPrice: 6565, qty: 2 }, { sku: 'X', unitPrice: 34180, qty: 1 }],
+    amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+    points: { used: 2000, earned: 403 },
+  }
+  assert.strictEqual(createRefund(order, { number: 'R-0311', items: [{ sku: 'SP', qty: 2 }] }).pointsRecovered, 131)
+  assert.strictEqual(createRefund(order, { number: 'R-0312', items: [{ sku: 'SP', qty: 1 }] }).pointsRecovered, 65)
+})
