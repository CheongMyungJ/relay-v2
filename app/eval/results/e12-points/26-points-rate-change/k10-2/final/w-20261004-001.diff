diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..4b2da70 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,8 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. (상품 금액 - 쿠폰 할인 - 사용 포인트)의 POINT_RATE_PERCENT%, 소수점 버림. 배송비는 뺀다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return floorPercentOf(goods - coupon - pointsUsed, POINT_RATE_PERCENT)
 }
diff --git a/base/test/order.test.js b/tree/test/order.test.js
index 48f4762..e8d89de 100644
--- a/base/test/order.test.js
+++ b/tree/test/order.test.js
@@ -29,3 +29,42 @@ test('적립 포인트를 주문에 저장한다', () => {
 test('주문 번호 형식', () => {
   assert.throws(() => createOrder({ ...base, number: 'O-12', lines: [{ sku: 'A', unitPrice: 1000 }] }), /O-0000/)
 })
+
+const earn = (o) => createOrder({ ...base, number: 'O-0003', ...o }).points.earned
+
+test('적립: 배송비는 적립 기준 금액에 넣지 않는다 (배송비 있는 주문)', () => {
+  // 상품 20,000 → 배송비 3,000, 결제 23,000. 적립은 20,000의 1%
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 200)
+})
+
+test('적립: 배송비 없는 주문', () => {
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 40000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 0)
+  assert.strictEqual(o.points.earned, 400)
+})
+
+test('적립: 쿠폰 할인과 사용 포인트를 뺀 상품 금액 기준', () => {
+  const lines = [{ sku: 'A', unitPrice: 50000, qty: 1 }]
+  assert.strictEqual(earn({ lines, coupon: { code: 'C', amount: 5000 } }), 450)
+  assert.strictEqual(earn({ lines, pointsUsed: 2000 }), 480)
+  assert.strictEqual(earn({ lines, coupon: { code: 'C', amount: 5000 }, pointsUsed: 2000 }), 430)
+})
+
+test('적립: 소수점은 버린다', () => {
+  // 29,990원 → 299.9 → 299 (반올림이면 300)
+  assert.strictEqual(earn({ lines: [{ sku: 'A', unitPrice: 29990, qty: 1 }] }), 299)
+})
+
+test('적립: O-1042는 237P', () => {
+  const o = createOrder({
+    ...base,
+    number: 'O-1042',
+    lines: [{ sku: 'A', unitPrice: 8900, qty: 2 }, { sku: 'B', unitPrice: 3490, qty: 3 }],
+    coupon: { code: 'AUTUMN3000', amount: 3000, minGoods: 20000 },
+    pointsUsed: 1500,
+    pointBalance: 4820,
+  })
+  assert.strictEqual(o.points.earned, 237)
+})
diff --git a/base/test/refund.test.js b/tree/test/refund.test.js
index de6f8a4..bdbeb4c 100644
--- a/base/test/refund.test.js
+++ b/tree/test/refund.test.js
@@ -30,3 +30,36 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+test('부분 환불 회수: 환불 상품 금액의 1%를 버린다', () => {
+  const o = { ...order, lines: [{ sku: 'A', name: 'A', unitPrice: 2999, qty: 10 }], amounts: { goods: 29990, coupon: 0, shipping: 3000, pointsUsed: 0, total: 32990 }, points: { used: 0, earned: 299 } }
+  const r = createRefund(o, { number: 'R-0003', items: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 29) // 29.99 → 29
+})
+
+test('부분 환불 회수: 나눠 환불해도 회수 합이 적립을 넘지 않는다', () => {
+  // 쿠폰·포인트 없음, 상품 3×9,999 = 29,997 → 적립 floor(299.97) = 299. 줄 하나씩 모두 환불하면 99+99+99 = 297
+  const o = {
+    number: 'O-0200',
+    lines: [{ sku: 'A', name: 'A', unitPrice: 9999, qty: 3 }],
+    amounts: { goods: 29997, coupon: 0, shipping: 3000, pointsUsed: 0, total: 32997 },
+    points: { used: 0, earned: 299 },
+  }
+  let sum = 0
+  for (let i = 0; i < 3; i++) {
+    const r = createRefund(o, { number: 'R-0004', items: [{ sku: 'A', qty: 1 }], alreadyRefunded: i ? [{ sku: 'A', qty: i }] : [] })
+    sum += r.pointsRecovered
+  }
+  assert.strictEqual(sum, 297)
+  assert.ok(sum <= o.points.earned, `${sum} > ${o.points.earned}`)
+})
+
+test('부분 환불 회수: 쿠폰·포인트가 있으면 남은 상품 금액이 모자라는 환불은 전체 취소로 보낸다', () => {
+  const o = {
+    number: 'O-0201',
+    lines: [{ sku: 'A', name: 'A', unitPrice: 9999, qty: 3 }],
+    amounts: { goods: 29997, coupon: 1000, shipping: 3000, pointsUsed: 1000, total: 30997 },
+    points: { used: 1000, earned: 279 },
+  }
+  assert.throws(() => createRefund(o, { number: 'R-0005', items: [{ sku: 'A', qty: 1 }], alreadyRefunded: [{ sku: 'A', qty: 2 }] }), /전체 취소/)
+})
