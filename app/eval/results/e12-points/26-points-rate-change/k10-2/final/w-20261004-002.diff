--- a/base/src/money.js
+++ b/tree/src/money.js
@@ -14,6 +14,11 @@ export function percentOf(amount, percent) {
   return Math.round((amount * percent) / 100)
 }
 
+/** 금액의 percent%. 원 단위로 버림한다 */
+export function floorPercentOf(amount, percent) {
+  return Math.floor((amount * percent) / 100)
+}
+
 /** 10원 단위 버림 */
 export function floorTen(amount) {
   return Math.floor(amount / 10) * 10
diff --git a/base/src/orders/refund.js b/tree/src/orders/refund.js
index 7d4f479..01ac563 100644
--- a/base/src/orders/refund.js
+++ b/tree/src/orders/refund.js
@@ -1,10 +1,12 @@
 import { POINT_RATE_PERCENT, REFUND_NUMBER } from '../config.js'
 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { floorPercentOf, sumWon } from '../money.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
 //   쿠폰 할인과 사용한 포인트는 남은 주문에 그대로 둔다. 남은 상품 금액이 그보다 적어지면 전체 취소로 한다.
+//   회수 포인트 = 회수 전 적립 − 남은 상품으로 다시 계산한 적립(버림). 첫 환불은 저장된 적립에서 시작하고,
+//   이전에 부분 환불한 수량이 있으면 그때 남은 상품으로 계산한 적립에서 시작해 회수 합이 저장된 적립을 넘지 않게 한다.
 // - 전체 취소(cancelOrder): 결제 금액을 모두 돌려주고, 적립 포인트를 모두 회수하고, 사용한 포인트를 돌려준다.
 
 export function createRefund(order, input) {
@@ -26,12 +28,16 @@ export function createRefund(order, input) {
   const remainingGoods = order.amounts.goods - refundedBefore - refundGoods
   if (remainingGoods < order.amounts.coupon + order.amounts.pointsUsed)
     throw new Error('남은 상품 금액이 쿠폰 할인과 사용 포인트보다 적다. 전체 취소로 처리한다')
+  const earnedOn = (goods) =>
+    floorPercentOf(goods - order.amounts.coupon - order.amounts.pointsUsed, POINT_RATE_PERCENT)
+  const earnedBefore = refundedBefore > 0 ? earnedOn(order.amounts.goods - refundedBefore) : order.points.earned
+  const pointsRecovered = Math.max(0, Math.min(earnedBefore, order.points.earned) - earnedOn(remainingGoods))
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered,
   }
 }
 
diff --git a/base/test/refund.test.js b/tree/test/refund.test.js
index de6f8a4..4ae6d0a 100644
--- a/base/test/refund.test.js
+++ b/tree/test/refund.test.js
@@ -30,3 +30,36 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+// O-1077 / R-0311: 저장된 적립 403P, 남은 상품 34,180 − 쿠폰 5,000 − 사용 포인트 2,000 = 27,180 → 271P
+const order1077 = {
+  number: 'O-1077',
+  customerId: 'U-11853',
+  lines: [
+    { sku: 'KT-2290', name: '스테인리스 밀폐용기 3종', unitPrice: 12900, qty: 2 },
+    { sku: 'TW-0838', name: '순면 행주 5장', unitPrice: 8380, qty: 1 },
+    { sku: 'SP-0656', name: '실리콘 주걱 세트', unitPrice: 6565, qty: 2 },
+  ],
+  coupon: { code: 'WELCOME5000', amount: 5000, minGoods: 30000 },
+  amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+  points: { used: 2000, earned: 403 },
+}
+
+test('부분 환불 회수 포인트 = 저장된 적립 − 남은 상품으로 다시 계산한 적립(버림): R-0311은 132P', () => {
+  const r = createRefund(order1077, { number: 'R-0311', items: [{ sku: 'SP-0656', qty: 2 }] })
+  assert.strictEqual(r.refundAmount, 13130)
+  assert.strictEqual(r.pointsRecovered, 132)
+})
+
+test('이전 부분 환불이 있어도 남은 상품 기준으로 계산하고 회수 합이 적립을 넘지 않는다', () => {
+  const first = createRefund(order1077, { number: 'R-0311', items: [{ sku: 'SP-0656', qty: 1 }] })
+  // 남은 40,745 − 7,000 = 33,745 → 337P
+  assert.strictEqual(first.pointsRecovered, 403 - 337)
+  const second = createRefund(order1077, {
+    number: 'R-0312',
+    items: [{ sku: 'SP-0656', qty: 1 }],
+    alreadyRefunded: [{ sku: 'SP-0656', qty: 1 }],
+  })
+  assert.strictEqual(first.pointsRecovered + second.pointsRecovered, 132)
+  assert.ok(first.pointsRecovered + second.pointsRecovered <= order1077.points.earned)
+})
