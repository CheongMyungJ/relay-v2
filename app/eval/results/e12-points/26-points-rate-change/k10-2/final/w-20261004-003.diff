diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..0b8f641 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,13 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액에서 적립 포인트를 구한다. 기준 금액 = 상품 − 쿠폰 − 사용 포인트(배송비 제외), 적립률% 버림 */
+export function earnFromBasis(goods, coupon, pointsUsed, ratePercent = POINT_RATE_PERCENT) {
+  return floorPercentOf(Math.max(goods - coupon - pointsUsed, 0), ratePercent)
+}
+
+/** 주문의 적립 포인트. (상품 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%, 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return earnFromBasis(goods, coupon, pointsUsed)
 }
diff --git a/tree/test/earn-rate.test.js b/tree/test/earn-rate.test.js
new file mode 100644
index 0000000..e8bc432
--- /dev/null
+++ b/tree/test/earn-rate.test.js
@@ -0,0 +1,45 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createRefund, cancelOrder } from '../src/orders/refund.js'
+import { POINT_RATE_PERCENT } from '../src/config.js'
+
+const load = (n) => JSON.parse(readFileSync(new URL(`../examples/${n}.json`, import.meta.url), 'utf8'))
+
+test('적립률 설정값은 2', () => {
+  assert.strictEqual(POINT_RATE_PERCENT, 2)
+})
+
+test('O-1107: 상품 − 쿠폰 − 사용 포인트의 2% 버림 = 486P (배송비 제외)', () => {
+  assert.strictEqual(createOrder(load('O-1107')).points.earned, 486)
+})
+
+test('O-1042: 상품 − 쿠폰 − 사용 포인트 기준 버림', () => {
+  const o = createOrder(load('O-1042'))
+  assert.strictEqual(o.points.earned, Math.floor(((o.amounts.goods - o.amounts.coupon - o.amounts.pointsUsed) * 2) / 100))
+})
+
+test('부분 환불 회수 = 저장된 적립 − 남은 상품 재계산 적립', () => {
+  // 새 주문(2%): 저장 806, 남은 상품 34,180 − 5,000 − 2,000 = 27,180 → 543, 회수 263
+  const o = { ...load('O-1077'), points: { used: 2000, earned: 806, ratePercent: 2 } }
+  assert.strictEqual(createRefund(o, load('R-0311')).pointsRecovered, 263)
+})
+
+test('적립률이 저장되지 않은 옛 주문(1%)은 옛 적립률로 회수를 맞춘다', () => {
+  // 저장 403, 남은 27,180의 1% = 271, 회수 132 (적립률이 바뀌어도 저장된 적립을 넘지 않는다)
+  const r = createRefund(load('O-1077'), load('R-0311'))
+  assert.strictEqual(r.pointsRecovered, 132)
+})
+
+test('여러 번 부분 환불해도 회수 합이 저장된 적립을 넘지 않는다', () => {
+  const o = { ...load('O-1077'), points: { used: 2000, earned: 806, ratePercent: 2 } }
+  const r1 = createRefund(o, { number: 'R-0001', items: [{ sku: 'SP-0656', qty: 2 }] })
+  const r2 = createRefund(o, { number: 'R-0002', items: [{ sku: 'TW-0838', qty: 1 }], alreadyRefunded: [{ sku: 'SP-0656', qty: 2 }] })
+  assert.ok(r1.pointsRecovered + r2.pointsRecovered <= 806)
+})
+
+test('이미 저장된 적립은 다시 계산하지 않고 전체 취소는 저장값 그대로 회수', () => {
+  const o = load('O-1077')
+  assert.strictEqual(cancelOrder(o).pointsRecovered, 403)
+})
