diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..a9899dc 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,79 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// ---- 같은 날짜 요약은 고객에게 한 번만 ----
+
+async function collected(opts) {
+  const ctx = digestSetup(opts)
+  await ctx.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  ctx.clock.set(NEXT_MORNING)
+  return ctx
+}
+
+test('[중복 방지/느린 성공] 제한 시간(3초)보다 오래 걸려도 성공한 요약은 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await collected({ mail: { outcomes: [{ latencyMs: 3500 }] } })
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+  assert.equal(notifier.metrics.counter('digest.slow'), 1)
+})
+
+test('[중복 방지/재실행] 같은 날짜를 다른 실행(재기동, 수동 재실행)으로 다시 돌려도 한 통만 나간다', async () => {
+  const { notifier, mail } = await collected()
+  await notifier.digest.tick()
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'after-restart' })
+  assert.equal(again.sent, 0)
+  assert.equal(again.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[중복 방지/동시 실행] 같은 날짜 실행이 동시에 둘 돌아도 한 통만 나간다', async () => {
+  const { notifier, mail } = await collected()
+  const [a, b] = await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'server-a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'server-b' }),
+  ])
+  assert.equal(a.sent + b.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[재시도 유지/시간 초과 실패] 어댑터가 시간 초과 오류로 실패한 요약은 다시 보내 한 통이 도착한다', async () => {
+  const { notifier, mail } = await collected({ mail: { outcomes: [{ fail: 'timeout', latencyMs: 3500 }] } })
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'sent'])
+})
+
+test('[재시도 유지/실패 뒤 재실행] 못 보낸 요약은 다음 실행에서 다시 보낸다', async () => {
+  const { notifier, mail } = await collected({
+    config: { digest: { maxAttempts: 1 } },
+    mail: { outcomes: [{ fail: 'transient' }] },
+  })
+  assert.equal((await notifier.digest.tick()).failed, 1)
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'rerun' })
+  assert.equal(again.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[재시도 유지/준비 단계 오류] 보내기 전에 오류가 나도 키를 놓아 다음 실행에서 다시 보낸다', async () => {
+  const { notifier, mail } = await collected()
+  const original = notifier.digest.inbox?.itemsFor
+  assert.ok(original, 'notifier.digest.inbox를 쓸 수 없음')
+  let broken = true
+  notifier.digest.inbox.itemsFor = (...args) => {
+    if (broken) throw new Error('boom')
+    return original.apply(notifier.digest.inbox, args)
+  }
+  assert.equal((await notifier.digest.run({ period: '2026-09-21', runId: 'r1' })).sent, 0)
+  assert.equal(mail.calls.length, 0)
+  broken = false
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'r2' })
+  assert.equal(again.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
