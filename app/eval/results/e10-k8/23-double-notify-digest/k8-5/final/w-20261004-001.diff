diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..76411b6
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { loadConfig } from '../src/config/load.js'
+import { decide } from '../src/retry/policy.js'
+import { shippedEvent, setup } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: ['tok-a'], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const digestEvent = () => ({ id: 'ord-1-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } })
+
+test('제한 시간을 넘겨 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1 }, options), { action: 'done' })
+})
+
+test('느리지만 성공한 메일은 재시도 없이 한 번만 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 2500 } })
+  const [res] = (await notifier.handle(shippedEvent())).results.filter((r) => r.channel === 'mail')
+  assert.equal(res.status, 'sent')
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(notifier.retryQueue.size(), 0)
+})
+
+test('느리지만 성공한 푸시는 재시도 없이 한 번만 보낸다', async () => {
+  const { notifier, clock, push } = setup({ push: { latencyMs: 2500 } })
+  const [res] = (await notifier.handle(shippedEvent())).results.filter((r) => r.channel === 'push')
+  assert.equal(res.status, 'sent')
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(push.calls.length, 1)
+  assert.equal(notifier.retryQueue.size(), 0)
+})
+
+test('실제로 시간 초과로 실패한 푸시는 재시도로 다시 보낸다', async () => {
+  const { notifier, clock, push } = setup({ push: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(shippedEvent())
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(push.calls.length, 2)
+})
+
+test('실제로 시간 초과로 실패한 메일은 재시도로 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(shippedEvent())
+  assert.equal(notifier.retryQueue.size(), 1)
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('느리지만 성공한 요약 메일은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { latencyMs: 3500 } })
+  await notifier.handle(digestEvent())
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('요약 메일이 실제로 시간 초과로 실패하면 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(digestEvent())
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
