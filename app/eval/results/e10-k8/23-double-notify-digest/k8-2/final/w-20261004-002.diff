diff --git a/tree/test/no-double-send.test.js b/tree/test/no-double-send.test.js
new file mode 100644
index 0000000..7bffa04
--- /dev/null
+++ b/tree/test/no-double-send.test.js
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { setup } from './helpers.js'
+
+const USERS = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const event = { id: 'ord-1001-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1001' } }
+
+async function ready(mail) {
+  const ctx = setup({ users: USERS, mail })
+  await ctx.notifier.handle(event)
+  ctx.clock.set(NEXT_MORNING)
+  return ctx
+}
+
+test('제한 시간보다 느리게 성공한 요약은 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await ready({ latencyMs: 3500 })
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+})
+
+test('같은 기간 요약을 다시 실행해도 이미 보낸 요약은 보내지 않는다', async () => {
+  const { notifier, mail } = await ready({ latencyMs: 300 })
+  await notifier.digest.run({ period: '2026-09-21' })
+  const second = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(mail.sent.length, 1)
+  assert.equal(second.already, 1)
+  assert.equal(second.sent, 0)
+})
+
+test('실제 오류(소켓 시간 초과)로 실패한 요약은 재시도해서 전달한다', async () => {
+  const { notifier, mail } = await ready({ latencyMs: 300, outcomes: [{ fail: 'timeout' }, { fail: 'transient' }] })
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'retry', 'sent'])
+})
+
+test('느리게 성공한 요약은 같은 기간을 다시 실행해도 한 통만 나간다', async () => {
+  const { notifier, mail } = await ready({ latencyMs: 3500 })
+  await notifier.digest.run({ period: '2026-09-21' })
+  const second = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(second.already, 1)
+  assert.equal(second.sent, 0)
+})
