diff --git a/tree/src/digest/timing.js b/tree/src/digest/timing.js
new file mode 100644
index 0000000..bcce6b6
--- /dev/null
+++ b/tree/src/digest/timing.js
@@ -0,0 +1,16 @@
+// 요약 발송 한 건이 걸린 시간 재기.
+// 느린 발송은 elapsedMs 지표로만 드러낸다. 성공한 발송을 시간 초과로 바꾸면 다시 보내 중복된다.
+
+/**
+ * fn을 부르고 걸린 시간을 잰다. 느려도 성공한 결과는 버리지 않는다.
+ * @template T
+ * @param {{ now(): number }} clock
+ * @param {() => Promise<T>} fn
+ * @returns {Promise<{ value: T, elapsedMs: number }>}
+ */
+export async function withTiming(clock, fn) {
+  const started = clock.now()
+  const value = await fn()
+  const elapsedMs = clock.now() - started
+  return { value, elapsedMs }
+}
