diff --git a/tree/test/no-double-send.test.js b/tree/test/no-double-send.test.js
new file mode 100644
index 0000000..5b52663
--- /dev/null
+++ b/tree/test/no-double-send.test.js
@@ -0,0 +1,95 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { decide } from '../src/retry/policy.js'
+import { digestKey } from '../src/digest/key.js'
+import { loadConfig } from '../src/config/load.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+test('느리지만 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1000 }, options), { action: 'done' })
+})
+
+test('메일이 느리게 성공해도 한 번만 발송한다', async () => {
+  const { notifier, mail, clock } = setup({ mail: { outcomes: [{ latencyMs: 3000 }] } })
+  const [res] = (await notifier.handle(shippedEvent())).results.filter((r) => r.channel === 'mail')
+  assert.equal(res.status, 'sent')
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(notifier.retryQueue.size(), 0)
+})
+
+test('푸시가 느리게 성공해도 한 번만 발송한다', async () => {
+  const { notifier, push, clock } = setup({ push: { outcomes: [{ latencyMs: 3000 }] } })
+  await notifier.handle(shippedEvent())
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(push.sent.length, 1)
+})
+
+test('실제로 실패한 메일은 재시도해서 전달된다', async () => {
+  const { notifier, mail, clock } = setup({ mail: { outcomes: [{ fail: 'transient' }] } })
+  await notifier.handle(shippedEvent())
+  assert.equal(mail.sent.length, 0)
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('시간 초과로 실패한 메일은 재시도해서 전달된다', async () => {
+  const { notifier, mail, clock } = setup({ mail: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(shippedEvent())
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const delivered = { id: 'd-1', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } }
+
+test('요약 메일이 느리게 성공해도 한 번만 발송한다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { outcomes: [{ latencyMs: 5000 }] } })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('같은 기간 요약을 다시 돌려도 이미 보낸 사람에게는 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'a' })
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'b' })
+  assert.equal(again.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약이 실제로 실패하면 다시 보내 전달된다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 2)
+})
+
+test('느리면서 실제로 실패한 요약도 다시 보내 전달된다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { outcomes: [{ fail: 'transient', latencyMs: 5000 }] } })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약 키에는 runId가 들어가지 않는다', () => {
+  assert.equal(digestKey({ userId: 'u-1', period: '2026-09-21', runId: 'a' }), digestKey({ userId: 'u-1', period: '2026-09-21', runId: 'b' }))
+})
