diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..3e03b39 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,68 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// --- 같은 기간의 요약은 어떤 경로로든 고객에게 한 번만 전달된다 ---
+
+test('[최초 발송] 제한 시간을 넘겨 늦게 성공한 요약은 성공이고 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('[재시도] 실제 실패 뒤 재시도가 늦게 성공해도 한 번만 전달된다', async () => {
+  const { notifier, clock, mail } = digestSetup({
+    mail: { outcomes: [{ fail: 'timeout', latencyMs: 3500 }, { latencyMs: 3500 }] },
+  })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'sent'])
+})
+
+test('[재실행] 같은 기간을 다른 runId로 다시 돌려도 이미 보낸 요약은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(first.sent, 1)
+  assert.equal(second.sent, 0)
+  assert.equal(second.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[재실행] 실제로 실패해 포기한 요약은 다음 실행에서 다시 보내고 결국 한 번 전달된다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'permanent' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(second.sent, 1)
+  const third = await notifier.digest.run({ period: '2026-09-21', runId: 'run-c' })
+  assert.equal(third.sent, 0)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[재실행] 같은 기간의 실행이 겹쳐도 보내는 중인 요약은 한 번만 전달된다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ latencyMs: 500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const [a, b] = await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-b' }),
+  ])
+  assert.equal(a.sent + b.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
