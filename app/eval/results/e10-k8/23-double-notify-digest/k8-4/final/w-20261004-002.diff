diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..1f78036 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,65 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// 같은 날 같은 요약이 두 통 이상 나가던 경우
+
+test('느리지만 성공한 요약은 재발송하지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 5000 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('같은 기간을 다시 실행해도(runId가 달라도) 이미 보낸 요약은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  const other = await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  assert.equal(again.already, 1)
+  assert.equal(other.already, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('실패한 요약은 재실행에서 다시 보내 한 번 전달된다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  const rerun = await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  assert.equal(rerun.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'manual-2' })
+  assert.equal(mail.sent.length, 1)
+})
+
+test('실제로 실패한 요약만 재시도하고 결국 한 번 전달된다 (느린 실패 포함)', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'transient', latencyMs: 5000 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('겹쳐 도는 두 실행이 같은 요약을 동시에 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const [a, b] = await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-b' }),
+  ])
+  assert.equal(a.sent + b.sent, 1)
+  assert.equal(a.already + b.already, 1)
+  assert.equal(mail.calls.length, 1)
+})
