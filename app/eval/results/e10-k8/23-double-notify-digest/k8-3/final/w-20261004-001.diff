@@ -118,3 +118,35 @@ test('탈퇴한 사용자의 재시도는 버린다', async () => {
   assert.equal(notifier.health().retryQueue.size, 0)
   assert.equal(notifier.preferences.get('u-1').email, null)
 })
+
+test('느리게 성공한 메일은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ latencyMs: 2500 }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(notifier.config.retry.maxDelayMs)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('시간 초과로 실제 실패한 메일은 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ fail: 'timeout', latencyMs: 2500 }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'retry-scheduled')
+  clock.advance(notifier.config.retry.baseDelayMs)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('느리게 성공한 푸시는 다시 보내지 않는다', async () => {
