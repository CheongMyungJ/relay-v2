diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..5a6c711 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,103 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// --- 같은 기간 요약은 고객에게 한 번만 간다 ---
+
+async function collectOne(notifier) {
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+}
+const toMina = (mail) => mail.sent.filter((m) => m.to === 'mina@example.com').length
+
+test('재시도 경로: 느리게 성공한 요약은 실패로 보지 않아 한 통만 간다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(toMina(mail), 1)
+})
+
+test('재시도 경로: 연이어 느려도 세 통이 가지 않는다', async () => {
+  const slow = { latencyMs: 3500 }
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [slow, slow, slow] } })
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(toMina(mail), 1)
+})
+
+test('수동 재실행 경로: 같은 기간을 다시 돌려도 이미 보낸 요약은 다시 가지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  const withId = await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  assert.equal(again.already, 1)
+  assert.equal(withId.already, 1)
+  assert.equal(toMina(mail), 1)
+})
+
+test('스케줄러 재실행 경로: 일정이 새로 시작되어(lastPeriod 초기화) 같은 기간을 다시 돌려도 한 통이다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  const { createDigestScheduler } = await import('../src/digest/scheduler.js')
+  const fresh = createDigestScheduler({
+    clock,
+    config: notifier.config,
+    runner: { run: (args) => notifier.digest.run(args) },
+    inbox: notifier.digest.inbox,
+    logger: { info() {}, warn() {}, error() {} },
+  })
+  const summary = await fresh.tick()
+  assert.equal(summary.already, 1)
+  assert.equal(toMina(mail), 1)
+})
+
+test('동시 실행 경로: 같은 기간 요약이 겹쳐 돌아도 한 통이다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  const [a, b] = await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'r-a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'r-b' }),
+  ])
+  assert.equal(a.sent + b.sent, 1)
+  assert.equal(toMina(mail), 1)
+})
+
+test('실패한 요약은 다시 보내고 건너뛰지 않는다: 일시 오류 뒤 재시도로 한 통', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'transient' }, { fail: 'timeout' }] } })
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 3)
+  assert.equal(toMina(mail), 1)
+})
+
+test('실패한 요약은 다시 보내고 건너뛰지 않는다: 모두 실패한 실행 뒤 재실행하면 보낸다', async () => {
+  const f = { fail: 'transient' }
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [f, f, f] } })
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(toMina(mail), 0)
+  const second = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(second.sent, 1)
+  assert.equal(toMina(mail), 1)
+})
+
+test('실제 시간 초과 실패는 계속 재시도한다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'timeout' }] } })
+  await collectOne(notifier)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+})
