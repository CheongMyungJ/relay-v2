+// 품목 줄의 부가세. 할인된 줄 금액(공급가액)에 매겨 원 단위로 버림한다.
+// 면세 줄과 영세율 청구서·반품 전표는 0이다
+export function lineVat(net, { taxable, zeroRated }) {
+  if (!taxable || zeroRated) return 0
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
 // 청구서 합계
