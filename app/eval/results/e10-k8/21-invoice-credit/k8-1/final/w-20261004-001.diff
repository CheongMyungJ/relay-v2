   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 줄마다 원 단위 버림으로 계산해 합한다 (INV-2031)', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.taxable, 26438)
+  assert.strictEqual(t.vat, 2641) // 536+633+325+837+310, 합계 재반올림(2,644) 아님
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인이 있는 줄은 할인된 줄 금액에 부가세를 매겨 버림한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1055, qty: 3, discount: { percent: 10 } }, // 3165-317=2848 -> 284
+    { name: 'B', unitPrice: 999, qty: 1, discount: { amount: 100 } }, // 899 -> 89
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 3747)
+  assert.strictEqual(t.vat, 373)
+  assert.strictEqual(t.total, 4120)
+})
+
+test('면세 줄과 영세율 청구서의 부가세는 0', () => {
+  const mixed = draft([
+    { name: 'C', unitPrice: 105, qty: 1 },
+    { name: 'D', unitPrice: 5555, qty: 1, taxType: 'exempt' },
+  ])
+  assert.strictEqual(computeTotals(mixed).vat, 10)
+  const zero = draft([{ name: 'E', unitPrice: 105, qty: 1 }], { zeroRated: true })
+  assert.strictEqual(computeTotals(zero).vat, 0)
+})
