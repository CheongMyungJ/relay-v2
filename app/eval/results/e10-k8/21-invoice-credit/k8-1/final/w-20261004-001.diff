diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..d098e3a 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -13,6 +13,13 @@ export function lineAmounts(invoice) {
   })
 }
 
+// 품목 줄의 부가세. 할인된 줄 금액(공급가액)에 세율을 곱해 원 단위로 버린다.
+// 면세 줄과 영세율 청구서는 0
+export function lineVat(row, zeroRated) {
+  if (zeroRated || !row.taxable) return 0
+  return Math.floor((row.net * VAT_RATE_PERCENT) / 100)
+}
+
 // 청구서 합계
 //   subtotal: 할인 전 금액 합, discount: 할인 합, supply: 공급가액 합
 //   taxable / exempt: 공급가액 중 과세분 / 면세분, vat: 부가세, total: 청구 합계
@@ -23,6 +30,7 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 줄마다 버림한 부가세를 더한다. 합계에서 다시 반올림하지 않는다
+  const vat = sumWon(rows.map((r) => lineVat(r, invoice.zeroRated)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..11dfce7 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,52 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표의 부가세도 줄마다 원 단위 버림으로 계산해 합한다', () => {
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'A-1', name: 'A', unitPrice: 105, qty: 1 },
+        { sku: 'B-1', name: 'B', unitPrice: 105, qty: 1 },
+      ],
+    }),
+    { number: 'INV-0101', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(inv2, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [{ sku: 'A-1', qty: 1 }, { sku: 'B-1', qty: 1 }],
+  })
+  assert.strictEqual(cn.totals.vat, 20) // 합계 반올림이면 21
+  assert.strictEqual(cn.totals.total, 230)
+})
+
+test('반품 전표: 할인 줄은 할인된 줄 금액에, 면세 줄은 0으로 부가세를 계산한다', () => {
+  const cn = note([
+    { sku: 'OF-1990', qty: 2 }, // 3980-200=3780 -> 378
+    { sku: 'BK-1800', qty: 1 }, // 면세
+  ])
+  assert.strictEqual(cn.totals.vat, 378)
+  assert.strictEqual(cn.totals.total, 3780 + 18000 + 378)
+})
+
+test('영세율 청구서의 반품 전표 부가세는 0', () => {
+  const zero = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      zeroRated: true,
+      lines: [{ sku: 'Z-1', name: 'Z', unitPrice: 105, qty: 2 }],
+    }),
+    { number: 'INV-0102', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(zero, {
+    number: 'CN-0003',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [{ sku: 'Z-1', qty: 1 }],
+  })
+  assert.strictEqual(cn.totals.vat, 0)
+  assert.strictEqual(cn.totals.total, 105)
+})
diff --git a/base/test/total.test.js b/tree/test/total.test.js
