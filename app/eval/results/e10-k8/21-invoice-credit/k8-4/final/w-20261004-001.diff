diff --git a/base/src/money.js b/tree/src/money.js
index 0bdef2d..9c7dd1a 100644
--- a/base/src/money.js
+++ b/tree/src/money.js
@@ -34,6 +34,12 @@ export function percentOf(amount, percent) {
   return Math.round((amount * percent) / 100)
 }
 
+// amount의 percent%를 원 단위로 버림 (부가세: 회계팀 규칙)
+export function floorPercentOf(amount, percent) {
+  assertWon(amount)
+  return Math.floor((amount * percent) / 100)
+}
