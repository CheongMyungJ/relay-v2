diff --git a/tree/src/invoice/vat.js b/tree/src/invoice/vat.js
new file mode 100644
index 0000000..d9080d6
--- /dev/null
+++ b/tree/src/invoice/vat.js
@@ -0,0 +1,11 @@
+import { VAT_RATE_PERCENT } from '../config.js'
+import { assertWon, sumWon } from '../money.js'
+
+// 부가세. 과세 품목 줄마다 공급가액(할인 적용 후)에 세율을 매겨 원 단위로 버리고, 그 합을 쓴다.
+// 합계에서 다시 반올림하지 않는다(회계팀 방식). 영세율이면 0
+export function computeVat(rows, zeroRated) {
+  if (zeroRated) return 0
+  return sumWon(
+    rows.filter((r) => r.taxable).map((r) => Math.floor((assertWon(r.net) * VAT_RATE_PERCENT) / 100)),
+  )
+}
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..618ff58 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,39 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표의 부가세는 줄마다 원 단위로 버린 값의 합', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'OF-0905', name: '네임펜 흑', unitPrice: 905, qty: 7 },
+        { sku: 'OF-1085', name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+        { sku: 'OF-0345', name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+      ],
+    }),
+    { number: 'INV-0200', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(invoice, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [
+      { sku: 'OF-0905', qty: 7 },
+      { sku: 'OF-1085', qty: 3 },
+      { sku: 'OF-0345', qty: 9 },
+    ],
+  })
+  // 633 + 325 + 310 = 1268 (합계 12,695에서 한 번 반올림하면 1270)
+  assert.strictEqual(cn.totals.supply, 12695)
+  assert.strictEqual(cn.totals.vat, 1268)
+})
+
+test('영세율 반품 전표의 부가세는 0', () => {
+  const zr = issueInvoice(
+    createInvoice({ customerId: 'C-1', zeroRated: true, lines: [{ sku: 'T-1', name: '토너', unitPrice: 48001, qty: 2 }] }),
+    { number: 'INV-0201', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(zr, { number: 'CN-0003', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'T-1', qty: 1 }] })
+  assert.strictEqual(cn.totals.vat, 0)
+})
