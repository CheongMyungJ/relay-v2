+import { readFileSync } from 'node:fs'
 import { test } from 'node:test'
 import assert from 'node:assert'
 import { creditNoteEntries, ledger } from '../src/export/ledger.js'
@@ -81,3 +82,55 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+// 줄 금액이 10원 단위가 아니고 할인이 있는 청구서: 합계 반올림과 줄별 버림이 달라진다
+const oddInv = (zeroRated = false) =>
+  issueInvoice(
+    createInvoice({
+      customerId: 'C-0388',
+      zeroRated,
+      lines: [
+        { sku: 'A-1', name: 'A', unitPrice: 905, qty: 7 },
+        { sku: 'A-2', name: 'B', unitPrice: 1085, qty: 3, discount: { amount: 500 } },
+        { sku: 'A-3', name: 'C', unitPrice: 345, qty: 9 },
+        { sku: 'A-4', name: '면세', unitPrice: 777, qty: 3, taxType: 'exempt' },
+      ],
+    }),
+    { number: 'INV-0200', issueDate: '2026-09-01' },
+  )
+const oddNote = (invoice) =>
+  createCreditNote(invoice, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '착오',
+    returns: [
+      { sku: 'A-1', qty: 7 },
+      { sku: 'A-2', qty: 3 },
+      { sku: 'A-3', qty: 9 },
+      { sku: 'A-4', qty: 1 },
+    ],
+  })
+
+test('반품 전표 부가세는 과세 줄마다 버림한 값의 합이다', () => {
+  // 줄별: floor(633.5)=633, floor(275.5)=275, floor(310.5)=310 → 1218 (합계 반올림이면 1219)
+  const cn = oddNote(oddInv())
+  assert.deepStrictEqual(cn.totals, { supply: 12972, taxable: 12195, exempt: 777, vat: 1218, total: 14190 })
+})
+
+test('영세율 청구서의 반품 전표 부가세는 0이다', () => {
+  const cn = oddNote(oddInv(true))
+  assert.strictEqual(cn.totals.vat, 0)
+  assert.strictEqual(cn.totals.total, cn.totals.supply)
+})
+
+test('저장된 totals가 있으면 그대로 돌려준다', () => {
+  const cn = oddNote(oddInv())
+  const stored = { ...cn, totals: { supply: 1, taxable: 1, exempt: 0, vat: 0, total: 1 } }
+  assert.deepStrictEqual(creditNoteTotals(stored), stored.totals)
+})
+
+test('CN-0112 예시: 부가세는 줄별 버림 합 1742원, 합계 19180원이다', () => {
+  const read = (name) => JSON.parse(readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+  const cn = createCreditNote(read('INV-2047'), read('CN-0112'))
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
