   assert.deepStrictEqual(await runPool([], async () => 1, { concurrency: 4 }), [])
 })
+
+test('결과는 끝난 순서가 아니라 입력 순서다', async () => {
+  const delays = [20, 1, 10, 2]
+  const results = await runPool(
+    delays,
+    async (ms) => {
+      await new Promise((r) => setTimeout(r, ms))
+      return ms
+    },
+    { concurrency: 4 },
+  )
+  assert.deepStrictEqual(results, delays)
+})
