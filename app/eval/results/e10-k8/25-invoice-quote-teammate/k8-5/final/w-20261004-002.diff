diff --git a/base/src/invoice/credit-note.js b/tree/src/invoice/credit-note.js
index 6e6fe7d..70b6490 100644
--- a/base/src/invoice/credit-note.js
+++ b/tree/src/invoice/credit-note.js
@@ -80,6 +80,16 @@ export function creditLineAmounts(note) {
   })
 }
 
+// 한 줄의 부가세. 과세 줄의 공급가액에 원 단위 버림. 면세 줄은 0
+export function lineVat(row) {
+  return row.taxable ? Math.floor((row.net * VAT_RATE_PERCENT) / 100) : 0
+}
+
+// 줄마다 버림한 부가세의 합. 합계에서 다시 반올림하지 않는다
+export function sumLineVat(rows) {
+  return sumWon(rows.map(lineVat))
+}
+
 // 반품 전표의 돌려주는 금액
 //   supply: 공급가액, taxable / exempt: 과세분 / 면세분, vat: 부가세, total: 돌려주는 합계
 export function creditTotals(note) {
@@ -87,7 +97,7 @@ export function creditTotals(note) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = note.zeroRated ? 0 : sumLineVat(rows)
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..cb5d254 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,35 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세는 줄마다 원 단위 버림으로 구해 합산한다 (CN-0112)', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-0388',
+      lines: [
+        { sku: 'OF-0415', name: '지우개', unitPrice: 415, qty: 9 },
+        { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 8, discount: { amount: 1500 } },
+        { sku: 'OF-2150', name: '형광펜 5색', unitPrice: 2150, qty: 6, discount: { percent: 5 } },
+      ],
+    }),
+    { number: 'INV-2047', issueDate: '2026-09-24' },
+  )
+  const cn = createCreditNote(invoice, {
+    number: 'CN-0112',
+    issueDate: '2026-10-06',
+    reason: '파손',
+    returns: [
+      { sku: 'OF-1342', qty: 8 },
+      { sku: 'OF-2150', qty: 3 },
+      { sku: 'OF-0415', qty: 5 },
+    ],
+  })
+  // 줄별 공급가액 9236 / 6127 / 2075 -> 부가세 923 + 612 + 207
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('저장된 totals가 있으면 creditNoteTotals는 재계산하지 않는다', () => {
+  const stored = { supply: 1, taxable: 1, exempt: 0, vat: 9, total: 10 }
+  const cn = { ...note([{ sku: 'OF-1450', qty: 4 }]), totals: stored }
+  assert.strictEqual(creditNoteTotals(cn), stored)
+})
