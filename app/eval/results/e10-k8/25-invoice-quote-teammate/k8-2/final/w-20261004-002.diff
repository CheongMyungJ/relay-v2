@@ -1,7 +1,8 @@
-import { CREDIT_NOTE_PREFIX, VAT_RATE_PERCENT } from '../config.js'
+import { CREDIT_NOTE_PREFIX } from '../config.js'
 import { assertDate } from '../format/date.js'
 import { percentOf, sumWon } from '../money.js'
 import { isTaxableLine } from './tax-type.js'
+import { lineVatSum } from './total.js'
 
 // 반품 전표. 발행된 청구서의 품목 일부(또는 전부)를 거래처가 돌려보낼 때 만든다.
 // 돌려주는 금액은 양수로 적는다. 분개에서 청구서와 반대 방향으로 쓴다(src/export/ledger.js).
@@ -87,7 +88,7 @@ export function creditTotals(note) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = lineVatSum(rows, note.zeroRated)
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..50c563f 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -26,3 +26,10 @@ export function computeTotals(invoice) {
   const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
+
+// 부가세: 과세 줄마다 할인된 줄 금액에 세율을 곱해 원 단위 미만을 버리고 그 합을 쓴다(회계팀 규정).
+// rows는 { net, taxable } 목록. 영세율이면 0
+export function lineVatSum(rows, zeroRated) {
+  if (zeroRated) return 0
+  return sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
+}
