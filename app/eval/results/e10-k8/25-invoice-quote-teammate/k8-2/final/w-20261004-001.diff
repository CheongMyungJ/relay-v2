+// 부가세. 과세 줄마다 할인된 줄 금액에 세율을 곱해 원 단위 미만을 버리고, 그 합을 쓴다
+// (회계팀 규정. 합계에서 다시 반올림하지 않는다). 영세율이면 0
+export function lineVatSum(rows, zeroRated) {
+  if (zeroRated) return 0
+  return sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
+}
+
 // 청구서 합계
 //   subtotal: 할인 전 금액 합, discount: 할인 합, supply: 공급가액 합
 //   taxable / exempt: 공급가액 중 과세분 / 면세분, vat: 부가세, total: 청구 합계
@@ -23,6 +30,6 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = lineVatSum(rows, invoice.zeroRated)
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/tree/test/vat-per-line.test.js b/tree/test/vat-per-line.test.js
new file mode 100644
index 0000000..4934cbb
--- /dev/null
+++ b/tree/test/vat-per-line.test.js
@@ -0,0 +1,93 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoice/invoice.js'
+import { computeTotals } from '../src/invoice/total.js'
+import { createCreditNote, creditNoteTotals } from '../src/invoice/credit-note.js'
+import { createQuote, quoteTotals } from '../src/invoice/quote.js'
+
+// 부가세: 할인된 줄 금액(과세 줄만)에 줄마다 매겨 원 단위 미만을 버리고 합한다 (회계팀 규정)
+const discounted = [
+  { sku: 'A-1', name: 'A', unitPrice: 1234, qty: 3, discount: { percent: 10 } }, // 3702-370=3332 -> 333
+  { sku: 'B-1', name: 'B', unitPrice: 999, qty: 1, discount: { amount: 100 } }, // 899 -> 89
+]
+const quoteOf = (lines, extra = {}) =>
+  createQuote({ number: 'Q-0500', customerId: 'C-1', issueDate: '2026-10-01', lines, ...extra })
+
+test('INV-2031: 줄별 버림 합 부가세 2,641원, 합계 29,079원', () => {
+  const ex = JSON.parse(readFileSync(new URL('../examples/INV-2031.json', import.meta.url)))
+  const t = computeTotals(createInvoice({ customerId: ex.customerId, lines: ex.lines }))
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인이 있는 줄은 할인된 금액에 부가세가 매겨진다', () => {
+  const t = computeTotals(createInvoice({ customerId: 'C-1', lines: discounted }))
+  assert.strictEqual(t.supply, 4231)
+  assert.strictEqual(t.vat, 422) // 333 + 89 (전체에 한 번 반올림하면 423)
+  assert.strictEqual(t.total, 4653)
+})
+
+test('면세 줄과 영세율 청구서의 부가세는 0', () => {
+  const exempt = computeTotals(createInvoice({
+    customerId: 'C-1',
+    lines: [{ name: '책', unitPrice: 18000, qty: 1, taxType: 'exempt' }],
+  }))
+  assert.strictEqual(exempt.vat, 0)
+  const zero = computeTotals(createInvoice({ customerId: 'C-1', lines: discounted, zeroRated: true }))
+  assert.strictEqual(zero.vat, 0)
+  assert.strictEqual(quoteOf(discounted, { zeroRated: true }).totals.vat, 0)
+})
+
+test('반품 전표도 줄별 버림 합 부가세 (할인 줄 포함)', () => {
+  const inv = issueInvoice(createInvoice({ customerId: 'C-1', lines: discounted }), {
+    number: 'INV-3000',
+    issueDate: '2026-10-01',
+  })
+  const cn = createCreditNote(inv, {
+    number: 'CN-0500',
+    issueDate: '2026-10-02',
+    reason: '반품',
+    returns: [{ sku: 'A-1', qty: 2 }, { sku: 'B-1', qty: 1 }],
+  })
+  // A: 2468-247=2221 -> 222, B: 899 -> 89
+  assert.strictEqual(cn.totals.supply, 3120)
+  assert.strictEqual(cn.totals.vat, 311) // 전체에 한 번 반올림하면 312
+  assert.strictEqual(cn.totals.total, 3431)
+})
+
+test('견적도 줄별 버림 합 부가세 (할인 줄 포함)', () => {
+  const t = quoteOf(discounted).totals
+  assert.strictEqual(t.vat, 422)
+  assert.strictEqual(t.total, 4653)
+})
+
+test('같은 청구 줄이면 청구서와 견적의 부가세가 같다', () => {
+  const ex = JSON.parse(readFileSync(new URL('../examples/INV-2031.json', import.meta.url)))
+  for (const lines of [ex.lines, discounted]) {
+    const inv = computeTotals(createInvoice({ customerId: 'C-1', lines }))
+    const q = quoteTotals(quoteOf(lines))
+    assert.strictEqual(q.vat, inv.vat)
+    assert.strictEqual(q.total, inv.total)
+  }
+})
+
+test('발행된 청구서는 저장된 합계를 쓴다', () => {
+  const inv = issueInvoice(createInvoice({ customerId: 'C-1', lines: discounted }), { number: 'INV-3001', issueDate: '2026-10-01' })
+  const stored = { ...inv, totals: { ...inv.totals, vat: 999, total: 5230 } }
+  assert.strictEqual(invoiceTotals(stored).total, 5230)
+})
+
+test('저장된 totals가 있는 반품 전표는 다시 계산하지 않는다', () => {
+  const inv = issueInvoice(createInvoice({ customerId: 'C-1', lines: discounted }), { number: 'INV-3002', issueDate: '2026-10-01' })
+  const cn = createCreditNote(inv, {
+    number: 'CN-0501',
+    issueDate: '2026-10-02',
+    reason: '반품',
+    returns: [{ sku: 'A-1', qty: 2 }],
+  })
+  const stored = { ...cn, totals: { ...cn.totals, vat: 999, total: 3219 } }
+  assert.strictEqual(creditNoteTotals(stored).vat, 999)
+  assert.strictEqual(creditNoteTotals(stored).total, 3219)
+})
