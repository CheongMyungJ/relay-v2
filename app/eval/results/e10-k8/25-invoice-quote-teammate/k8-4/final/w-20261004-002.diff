+---
+kind: rule
+source: human
+anchor: computeTotals
+---
+# 청구서 부가세는 과세 줄마다 원 단위 버림으로 계산해 합한다
+
+## 규칙
+- 청구서 부가세는 과세 품목 줄마다 (할인 후 공급가액 × 세율)을 원 단위 버림으로 계산하고 그 합을 쓴다. 합계에서 다시 반올림하지 않는다 (회계팀 규정).
+- 할인은 부가세 전에 줄마다 적용하고, 부가세는 할인된 줄 금액에 매긴다.
+- 면세 줄과 영세율(`zeroRated`) 청구서의 부가세는 0이다.
+- 예: INV-2031 줄별 부가세 536+633+325+837+310 = 2,641원, 합계 29,079원 (합계 기준 반올림이면 29,082원으로 틀림).
+- 발행된 청구서는 재계산하지 않고 저장된 `totals`를 쓴다.
+- 반품 전표도 같은 규칙이다: 반품 줄마다 (할인 후 공급가액 × 세율)을 버림해 합한다. 예: CN-0112 줄별 923+612+207 = 1,742원, 환불 합계 19,180원 (합계 기준 반올림이면 19,182원으로 틀림). 이미 만든 반품 전표는 저장된 `totals`를 쓴다.
+
+## 아직 규칙을 따르지 않는 곳
+- src/invoice/quote.js: 견적 부가세가 별도 계산이며 합계 기준 반올림이다. 이번 Work에서는 비목표라 그대로 둠
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
+- 2026-10-04 반품 전표(src/invoice/credit-note.js creditTotals)에도 적용, 아직 따르지 않는 곳에서 뺌 (Work w-20261004-002)
diff --git a/base/src/invoice/credit-note.js b/tree/src/invoice/credit-note.js
index 6e6fe7d..785e449 100644
--- a/base/src/invoice/credit-note.js
+++ b/tree/src/invoice/credit-note.js
@@ -87,7 +87,10 @@ export function creditTotals(note) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 부가세는 과세 줄마다 원 단위 버림으로 계산해 합한다(합계에서 다시 반올림하지 않는다)
+  const vat = note.zeroRated
+    ? 0
+    : sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..7a7c40f 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,36 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 부가세는 줄마다 원 단위 버림으로 계산해 합한다', () => {
+  const invoice = {
+    number: 'INV-2047',
+    customerId: 'C-0388',
+    issueDate: '2026-09-24',
+    status: 'issued',
+    zeroRated: false,
+    lines: [
+      { sku: 'OF-0415', name: '지우개', unitPrice: 415, qty: 9, taxType: 'taxable' },
+      { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 8, taxType: 'taxable', discount: { amount: 1500 } },
+      { sku: 'OF-2150', name: '형광펜 5색', unitPrice: 2150, qty: 6, taxType: 'taxable', discount: { percent: 5 } },
+    ],
+  }
+  const cn = createCreditNote(invoice, {
+    number: 'CN-0112',
+    issueDate: '2026-10-06',
+    reason: '파손 및 주문 착오',
+    returns: [
+      { sku: 'OF-1342', qty: 8 },
+      { sku: 'OF-2150', qty: 3 },
+      { sku: 'OF-0415', qty: 5 },
+    ],
+  })
+  // 줄별 부가세 923 + 612 + 207 = 1,742 (합계 기준 반올림이면 1,744)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('영세율 반품 전표의 부가세는 0이다', () => {
+  const zero = { ...inv, zeroRated: true }
+  const cn = createCreditNote(zero, { number: 'CN-0002', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'OF-1450', qty: 3 }] })
+  assert.strictEqual(cn.totals.vat, 0)
+})
