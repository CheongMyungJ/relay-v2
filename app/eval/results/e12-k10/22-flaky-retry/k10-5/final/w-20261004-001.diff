+++ b/tree/test/archive.test.js
@@ -93,3 +93,23 @@ test('짧은 꼬리표', () => {
   assert.strictEqual(stamp(1759197304120), 'mg5wnj94')
   assert.strictEqual(stamp(35.9), 'z')
 })
+
+test('같은 시각에 동시에 저장해도 임시 파일이 겹치지 않는다', async () => {
+  const files = createFileStore({ latency: { baseMs: 2 } })
+  setNow(() => 1759197304120)
+  const reports = [1, 2, 3, 4].map((n) => report(n, `tenant-${n}`))
+  await Promise.all(reports.map((r) => saveReport(files, r)))
+  for (const r of reports) {
+    assert.strictEqual((await loadReport(files, r.period, r.reportId)).tenant, r.tenant)
+  }
+  assert.deepStrictEqual(strayTemps(files, reports[0].period), [])
+})
+
+test('같은 보고서를 같은 시각에 동시에 저장해도 임시 파일이 겹치지 않는다', async () => {
+  const files = createFileStore({ latency: { baseMs: 2 } })
+  setNow(() => 1759197304120)
+  const r = report(1, 'tenant-1')
+  await Promise.all([saveReport(files, r), saveReport(files, r)])
+  assert.strictEqual((await loadReport(files, r.period, r.reportId)).tenant, 'tenant-1')
+  assert.deepStrictEqual(strayTemps(files, r.period), [])
+})
