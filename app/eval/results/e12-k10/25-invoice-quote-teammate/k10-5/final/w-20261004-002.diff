 import { CREDIT_NOTE_PREFIX, VAT_RATE_PERCENT } from '../config.js'
 import { assertDate } from '../format/date.js'
-import { percentOf, sumWon } from '../money.js'
+import { percentOf, percentOfFloor, sumWon } from '../money.js'
 import { isTaxableLine } from './tax-type.js'
 
 // 반품 전표. 발행된 청구서의 품목 일부(또는 전부)를 거래처가 돌려보낼 때 만든다.
@@ -87,7 +87,10 @@ export function creditTotals(note) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 부가세는 과세 줄마다 원 단위로 버림해 합산한다(합계에서 다시 반올림하지 않는다)
+  const vat = note.zeroRated
+    ? 0
+    : sumWon(rows.filter((r) => r.taxable).map((r) => percentOfFloor(r.net, VAT_RATE_PERCENT)))
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
diff --git a/base/src/money.js b/tree/src/money.js
index 0bdef2d..873a2c5 100644
--- a/base/src/money.js
+++ b/tree/src/money.js
@@ -34,6 +34,15 @@ export function percentOf(amount, percent) {
   return Math.round((amount * percent) / 100)
 }
 
+// amount의 percent%를 원 단위로 버림 (부가세 계산용)
+export function percentOfFloor(amount, percent) {
+  assertWon(amount)
+  if (typeof percent !== 'number' || percent < 0 || percent > 100) {
+    throw new RangeError(`비율은 0~100이어야 한다: ${percent}`)
+  }
+  return Math.floor((amount * percent) / 100)
+}
