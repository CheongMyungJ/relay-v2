@@ -81,3 +81,27 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세도 줄마다 원 단위 버림 후 합산한다', () => {
+  const odd = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 4 },
+        { sku: 'OF-0905', name: '네임펜 흑', unitPrice: 905, qty: 7 },
+      ],
+    }),
+    { number: 'INV-0101', issueDate: '2026-09-01' },
+  )
+  const n = createCreditNote(odd, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [
+      { sku: 'OF-1342', qty: 4 },
+      { sku: 'OF-0905', qty: 7 },
+    ],
+  })
+  // 5368 -> 536(버림), 6335 -> 633(버림). 합계에서 한 번에 반올림하면 1170
+  assert.strictEqual(n.totals.vat, 536 + 633)
+})
