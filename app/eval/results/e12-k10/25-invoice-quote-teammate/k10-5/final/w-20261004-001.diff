+      { name: 'B', unitPrice: 1342, qty: 4, discount: { amount: 100 } },
+    ],
+  })
+  // A: 3255 - 326 = 2929 -> 292, B: 5368 - 100 = 5268 -> 526
+  assert.strictEqual(q.totals.supply, 2929 + 5268)
+  assert.strictEqual(q.totals.vat, 292 + 526)
+})
