diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..d180898 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,40 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('CN-0112: 부가세는 과세 줄마다 원 단위 버림 후 합산', () => {
+  const invoice = {
+    number: 'INV-2047',
+    customerId: 'C-0388',
+    issueDate: '2026-09-24',
+    zeroRated: false,
+    status: 'issued',
+    lines: [
+      { sku: 'OF-0415', name: '지우개', unitPrice: 415, qty: 9, taxType: 'taxable' },
+      { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 8, taxType: 'taxable', discount: { amount: 1500 } },
+      { sku: 'OF-2150', name: '형광펜 5색', unitPrice: 2150, qty: 6, taxType: 'taxable', discount: { percent: 5 } },
+    ],
+  }
+  const cn = createCreditNote(invoice, {
+    number: 'CN-0112',
+    issueDate: '2026-10-06',
+    reason: '파손 및 주문 착오',
+    returns: [
+      { sku: 'OF-1342', qty: 8 },
+      { sku: 'OF-2150', qty: 3 },
+      { sku: 'OF-0415', qty: 5 },
+    ],
+  })
+  // 줄별 공급가액 9236, 6127, 2075 -> 부가세 923 + 612 + 207 = 1742 (합계 반올림이면 1744)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('면세 줄은 부가세 0, 영세율 전표는 부가세 0', () => {
+  const cn = note([
+    { sku: 'OF-1990', qty: 3 },
+    { sku: 'BK-1800', qty: 1 },
+  ])
+  assert.strictEqual(cn.totals.vat, 567)
+  assert.strictEqual(cn.totals.exempt, 18000)
+  assert.strictEqual(creditNoteTotals({ ...cn, totals: undefined, zeroRated: true }).vat, 0)
+})
