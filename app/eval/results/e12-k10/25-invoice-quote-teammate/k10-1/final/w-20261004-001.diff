+// 부가세. 과세 줄마다 공급가액의 percent%를 원 단위로 버림해 더한다(회계팀 규정). 합계에서 다시 반올림하지 않는다
+export function vatOfLines(nets, percent) {
+  let vat = 0
+  for (const net of nets) vat += Math.floor((assertWon(net) * percent) / 100)
+  return vat
+}
