diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..1e9df23 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,29 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세는 과세 줄마다 원 단위 버림으로 더한다', () => {
+  const cn = {
+    zeroRated: false,
+    lines: [
+      { sku: 'A', taxType: 'taxable', unitPrice: 105, qty: 1, origQty: 1 },
+      { sku: 'B', taxType: 'taxable', unitPrice: 105, qty: 1, origQty: 1 },
+    ],
+  }
+  // 줄별 버림: 10 + 10 = 20 (합계 210의 반올림은 21)
+  assert.deepStrictEqual(creditNoteTotals({ ...cn, totals: undefined }), { supply: 210, taxable: 210, exempt: 0, vat: 20, total: 230 })
+})
+
+test('저장된 totals가 있으면 그대로 돌려준다', () => {
+  const totals = { supply: 1, taxable: 1, exempt: 0, vat: 9, total: 10 }
+  assert.strictEqual(creditNoteTotals({ lines: [], totals }), totals)
+})
+
+test('반품 전표의 면세 줄은 부가세에서 빠지고 영세율은 부가세 0이다', () => {
+  const lines = [
+    { sku: 'A', taxType: 'taxable', unitPrice: 105, qty: 1, origQty: 1 },
+    { sku: 'B', taxType: 'exempt', unitPrice: 1000, qty: 1, origQty: 1 },
+  ]
+  assert.deepStrictEqual(creditNoteTotals({ zeroRated: false, lines }), { supply: 1105, taxable: 105, exempt: 1000, vat: 10, total: 1115 })
+  assert.deepStrictEqual(creditNoteTotals({ zeroRated: true, lines }), { supply: 1105, taxable: 105, exempt: 1000, vat: 0, total: 1105 })
+})
