   assertWon(amount)
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..7638da0 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,37 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세는 돌려받는 과세 줄마다 공급가액 × 10% 원 단위 버림의 합', () => {
+  const cn = note([
+    { sku: 'OF-1450', qty: 3 }, // 4350 -> 435
+    { sku: 'OF-1990', qty: 2 }, // 3980-200=3780 -> 378
+    { sku: 'BK-1800', qty: 1 }, // 면세 -> 0
+  ])
+  assert.strictEqual(cn.totals.vat, 435 + 378)
+  assert.strictEqual(cn.totals.total, cn.totals.supply + 813)
+  const odd = createCreditNote(
+    issueInvoice(
+      createInvoice({
+        customerId: 'C-1',
+        lines: [
+          { sku: 'A', name: 'A', unitPrice: 345, qty: 9 },
+          { sku: 'B', name: 'B', unitPrice: 905, qty: 7 },
+        ],
+      }),
+      { number: 'INV-0200', issueDate: '2026-09-01' },
+    ),
+    { number: 'CN-0002', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'A', qty: 9 }, { sku: 'B', qty: 7 }] },
+  )
+  assert.strictEqual(odd.totals.vat, 310 + 633) // 합계에서 한 번 반올림하면 944
+})
+
+test('영세율 반품 전표의 부가세는 0', () => {
+  const zr = issueInvoice(
+    createInvoice({ customerId: 'C-1', zeroRated: true, lines: [{ sku: 'T', name: '토너', unitPrice: 48000, qty: 2 }] }),
+    { number: 'INV-0300', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(zr, { number: 'CN-0003', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'T', qty: 1 }] })
+  assert.strictEqual(cn.totals.vat, 0)
+  assert.strictEqual(cn.totals.total, 48000)
+})
