diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..59d36b9
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,71 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { decide } from '../src/retry/policy.js'
+import { loadConfig } from '../src/config/load.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+// 서울 9월 21일 오전 10시에 받은 알림은 다음 날 아침 요약에 들어간다
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const delivered = { id: 'ord-1-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } }
+
+test('제한 시간을 넘겨도 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1000 }, options), { action: 'done' })
+})
+
+test('느리게 성공한 메일은 한 번만 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 3000 }, push: { latencyMs: 0 } })
+  const [res] = (await notifier.handle(shippedEvent())).results.filter((r) => r.channel === 'mail')
+  assert.equal(res.status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('느리게 성공한 푸시는 한 번만 보낸다', async () => {
+  const { notifier, clock, push } = setup({ mail: { latencyMs: 0 }, push: { latencyMs: 3000 } })
+  const [res] = (await notifier.handle(shippedEvent())).results.filter((r) => r.channel === 'push')
+  assert.equal(res.status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(push.sent.length, 1)
+  assert.equal(push.calls.length, 1)
+})
+
+test('느리게 성공한 요약 메일은 한 번만 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { latencyMs: 4000 } })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(notifier.metrics.counter('digest.send.slow'), 1)
+})
+
+test('실제로 실패한 발송은 다시 보내 결국 전달된다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 100, outcomes: [{ fail: 'transient' }, { fail: 'timeout', latencyMs: 3000 }] }, push: { latencyMs: 0 } })
+  await notifier.handle(shippedEvent())
+  for (let i = 0; i < 3; i++) {
+    clock.advance(70_000)
+    await notifier.retryWorker.runDue()
+  }
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(notifier.deliveryLog.latest('ord-1001-shipped').mail, 'sent')
+})
+
+test('실제로 실패한 요약 메일은 다시 보내 결국 전달된다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { latencyMs: 100, outcomes: [{ fail: 'timeout', latencyMs: 4000 }] } })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
