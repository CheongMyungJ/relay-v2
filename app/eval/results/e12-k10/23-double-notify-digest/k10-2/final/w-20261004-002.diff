diff --git a/tree/src/digest/sent-store.js b/tree/src/digest/sent-store.js
new file mode 100644
index 0000000..1b3e3de
--- /dev/null
+++ b/tree/src/digest/sent-store.js
@@ -0,0 +1,32 @@
+// 보낸 요약의 키 저장소. 서버가 여러 대여도 같은 요약을 한 번만 보내려면 모든 서버가 같은 저장소를 써야 한다.
+// 운영에서는 서버들이 같이 쓰는 DB로 바꿔 끼운다. 모든 메서드는 Promise를 돌려주는 계약이다.
+//   - reserve(key): 아직 보내지 않았고 다른 실행이 보내는 중도 아니면 키를 잡고 true. 검사와 잡기는 한 번에(원자적) 일어나야 한다
+//     (DB라면 유니크 키 insert나 SET NX 같은 조건부 쓰기). 잡은 키는 leaseMs 뒤 풀려, 죽은 서버가 키를 영원히 쥐지 않는다
+//   - release(key): 발송에 실패했을 때 잡은 키를 놓는다
+//   - markSent(key): 보냈다고 남긴다(ttlMs 동안)
+//   - has(key): 이미 보냈는지
+import { createTtlStore } from '../dedupe/store.js'
+
+export function createMemorySentStore({ clock, ttlMs, leaseMs = 10 * 60 * 1000 }) {
+  const sent = createTtlStore({ clock, ttlMs })
+  const leases = createTtlStore({ clock, ttlMs: leaseMs })
+
+  return {
+    async reserve(key) {
+      // 검사와 잡기 사이에 await가 없어 한 프로세스 안에서는 원자적이다
+      if (sent.has(key) || leases.has(key)) return false
+      leases.add(key)
+      return true
+    },
+    async release(key) {
+      leases.delete(key)
+    },
+    async markSent(key) {
+      sent.add(key)
+      leases.delete(key)
+    },
+    async has(key) {
+      return sent.has(key)
+    },
+  }
+}
