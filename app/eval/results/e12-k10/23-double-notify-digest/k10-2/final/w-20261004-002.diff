+})
+
+// ---- 서버 두 대: 같은 시계, 따로 도는 notifier 두 개가 보낸 요약 저장소를 공유한다 ----
+
+function twoServers({ sharedStore = true, mailA = {}, mailB = {} } = {}) {
+  const clock = createVirtualClock(START)
+  const config = { digest: { ledgerTtlMs: 3 * 24 * 60 * 60 * 1000 } }
+  const store = createMemorySentStore({ clock, ttlMs: config.digest.ledgerTtlMs })
+  const server = (mail) => {
+    const transports = {
+      mail: createFakeMailTransport({ clock, latencyMs: 300, ...mail }),
+      push: createFakePushTransport({ clock, latencyMs: 60 }),
+    }
+    const digestSentStore = sharedStore ? store : createMemorySentStore({ clock, ttlMs: config.digest.ledgerTtlMs })
+    const notifier = createNotifier({ clock, transports, preferences: DIGEST_USERS, digestSentStore })
+    return { notifier, mail: transports.mail }
+  }
+  return { clock, a: server(mailA), b: server(mailB) }
+}
+
+async function collect(servers) {
+  // 서버마다 같은 알림을 요약함에 담는다(이벤트가 어느 서버로 오든 요약 대상은 같다)
+  for (const s of servers) await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+}
+
+test('서버 두 대가 같은 기간 요약을 동시에 돌려도 한 통만 보낸다', async () => {
+  const { clock, a, b } = twoServers()
+  await collect([a, b])
+  clock.set(NEXT_MORNING)
+  const [ra, rb] = await Promise.all([
+    a.notifier.digest.run({ period: '2026-09-21', runId: 'server-a' }),
+    b.notifier.digest.run({ period: '2026-09-21', runId: 'server-b' }),
+  ])
+  assert.equal(ra.sent + rb.sent, 1)
+  assert.equal(ra.already + rb.already, 1)
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
+
+test('서버 A가 보낸 뒤 서버 B가 나중에 돌려도 보내지 않는다', async () => {
+  const { clock, a, b } = twoServers()
+  await collect([a, b])
+  clock.set(NEXT_MORNING)
+  assert.equal((await a.notifier.digest.run({ period: '2026-09-21' })).sent, 1)
+  const later = await b.notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(later.sent, 0)
+  assert.equal(later.already, 1)
+  assert.equal(b.mail.calls.length, 0)
+})
+
+test('서버 A가 실제로 못 보낸 요약은 서버 B가 다시 보낸다', async () => {
+  const { clock, a, b } = twoServers({ mailA: { outcomes: [{ fail: 'permanent' }] } })
+  await collect([a, b])
+  clock.set(NEXT_MORNING)
+  const first = await a.notifier.digest.run({ period: '2026-09-21', runId: 'server-a' })
+  assert.equal(first.failed, 1)
+  const second = await b.notifier.digest.run({ period: '2026-09-21', runId: 'server-b' })
+  assert.equal(second.sent, 1)
+  assert.equal(b.mail.sent.length, 1)
+})
+
+test('저장소를 공유하지 않으면 서버 두 대가 각각 보낸다(공유가 필요한 까닭)', async () => {
+  const { clock, a, b } = twoServers({ sharedStore: false })
+  await collect([a, b])
+  clock.set(NEXT_MORNING)
+  await Promise.all([a.notifier.digest.run({ period: '2026-09-21' }), b.notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 2)
+})
