diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..9648f3a 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,34 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+test('제한 시간을 넘겨 성공한 요약은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('같은 기간 요약을 다시 실행해도 이미 보낸 사용자에게는 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21' })
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.already, 1)
+  assert.equal(again.sent, 0)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약 발송이 실제로 시간 초과로 실패하면 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout', latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
diff --git a/base/test/notifier.test.js b/tree/test/notifier.test.js
index 5e1f54a..d26b945 100644
--- a/base/test/notifier.test.js
+++ b/tree/test/notifier.test.js
@@ -118,3 +118,24 @@ test('탈퇴한 사용자의 재시도는 버린다', async () => {
   assert.equal(notifier.health().retryQueue.size, 0)
   assert.equal(notifier.preferences.get('u-1').email, null)
 })
+
+test('제한 시간보다 늦게 끝났어도 성공한 발송은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ latencyMs: 2500 }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.deliveryLog.latest('ord-1001-shipped'), { mail: 'sent', push: 'sent' })
+})
+
+test('실제로 시간 초과로 실패한 메일은 재시도로 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ fail: 'timeout', latencyMs: 2500 }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'retry-scheduled')
+  assert.equal(mail.sent.length, 0)
+  clock.advance(notifier.config.retry.baseDelayMs)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
