   return {
     has: (key) => sentKeys.has(key),
+    /** 옛 키 형식(digest:기간:runId:사용자)으로 이미 보낸 기록이 있는지. 배포 전 코드가 남긴 기록을 알아보려고 둔다 */
+    hasLegacy(period, userId) {
+      const head = `digest:${period}:`
+      const tail = `:${userId}`
