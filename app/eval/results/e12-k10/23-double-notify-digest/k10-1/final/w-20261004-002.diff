diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..4324a68 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,87 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// ---- 중복 발송 경로별 "한 번만 전달" 시험 ----
+
+async function collectOne(opts) {
+  const s = digestSetup(opts)
+  await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  s.clock.set(NEXT_MORNING)
+  return s
+}
+
+test('중복 방지(최초 발송): 제한 시간보다 느리게 성공한 요약도 한 통만 나간다', async () => {
+  const { notifier, mail } = await collectOne({ mail: { latencyMs: 4000 } }) // sendTimeoutMs 3000 초과
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+})
+
+test('중복 방지(재시도): 느린 성공이 계속돼도 세 통이 되지 않는다', async () => {
+  const { notifier, mail } = await collectOne({
+    mail: { latencyMs: 4000, outcomes: [{ latencyMs: 4000 }, { latencyMs: 4000 }, { latencyMs: 4000 }] },
+  })
+  await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('중복 방지(재시도): 실패 뒤 재시도로 요약이 결국 한 통 전달된다', async () => {
+  const { notifier, mail } = await collectOne({ mail: { outcomes: [{ fail: 'transient' }, { fail: 'timeout' }] } })
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+})
+
+test('중복 방지(스케줄러 재실행): 같은 기간을 다시 run해도(재시작 등) 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await collectOne({})
+  await notifier.digest.tick()
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  const manual = await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  assert.equal(mail.sent.length, 1)
+  assert.equal(again.already, 1)
+  assert.equal(manual.sent, 0)
+})
+
+test('중복 방지(겹치는 실행): 동시에 두 번 run해도 한 통만 나간다', async () => {
+  const { notifier, mail } = await collectOne({})
+  await Promise.all([notifier.digest.run({ period: '2026-09-21' }), notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(mail.sent.length, 1)
+})
+
+test('중복 방지: 한 실행이 실패해도 다른 실행이 못 보낸 요약을 다시 보낸다', async () => {
+  const { notifier, mail } = await collectOne({ mail: { outcomes: [{ fail: 'permanent' }] } })
+  const first = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(first.failed, 1)
+  const second = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(second.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('중복 방지(서버 둘): 같은 발송 기록을 같이 쓰는 두 서버가 동시에 돌아도 한 통만 나간다', async () => {
+  const a = await collectOne({})
+  const b = await collectOne({})
+  // 운영처럼 두 서버가 한 발송 기록을 같이 쓰게 한다
+  const shared = a.notifier.digest.ledger
+  for (const name of ['has', 'hasLegacy', 'claim', 'release', 'markSent']) b.notifier.digest.ledger[name] = shared[name]
+  await Promise.all([a.notifier.digest.run({ period: '2026-09-21' }), b.notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
+
+test('중복 방지(배포일): 옛 키 형식으로 이미 보낸 요약은 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await collectOne({})
+  notifier.digest.ledger.markSent('digest:2026-09-21:2026-09-21@2026-09-21T23:05:00.000Z:u-1', { period: '2026-09-21', userId: 'u-1' })
+  const summary = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(mail.sent.length, 0)
+  assert.equal(summary.already, 1)
+})
+
+test('중복 방지: 보내다 실패하면 선점이 풀려 다음 실행이 다시 보낼 수 있다', async () => {
+  const { notifier, mail } = await collectOne({ mail: { outcomes: [{ fail: 'permanent' }] } })
+  await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(notifier.digest.ledger.claim('digest:2026-09-21:u-1'), true)
+  assert.equal(mail.sent.length, 0)
+})
