diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..a419b9e 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,125 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// ---- 같은 날 같은 고객에게 요약은 한 번만 (경로별) ----
+
+async function collectedSetup(opts) {
+  const s = digestSetup(opts)
+  await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  return s
+}
+
+test('[최초 발송] 성공했지만 제한 시간(3초)을 넘긴 발송은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('[재시도] 재시도 뒤 성공이 느려도 한 번만 받는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { latencyMs: 4000 }] },
+  })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(summary.sent, 1)
+})
+
+test('[재시도] 실제로 실패한 발송(시간 초과 포함)은 다시 보내고, 성공하면 멈춘다', async () => {
+  const { notifier, clock, mail } = await collectedSetup({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'timeout', latencyMs: 3500 }, { fail: 'transient' }] },
+  })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'retry', 'sent'])
+})
+
+test('[재시도] 시도를 모두 실패하면 포기하고 보낸 것으로 치지 않는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 0)
+  assert.equal(summary.failed, 1)
+})
+
+test('[실패 뒤 재실행] 못 보낸 요약은 같은 기간을 다시 실행하면 보내진다', async () => {
+  const { notifier, clock, mail } = await collectedSetup({
+    mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }, { fail: 'transient' }, { fail: 'transient' }] },
+  })
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(mail.sent.length, 0)
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[수동 재실행] 같은 기간을 다시 실행해도 이미 받은 고객에게는 보내지 않는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup()
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  clock.advance(60_000)
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.already, 1)
+  assert.equal(again.sent, 0)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[스케줄러 재실행] 재시작해 일정 상태를 잃은 스케줄러가 돌아도 한 번만 받는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup()
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  // 다른 서버/재시작 흉내: 같은 발송 기록을 쓰는 새 스케줄러
+  const { createDigestScheduler } = await import('../src/digest/scheduler.js')
+  const fresh = createDigestScheduler({
+    clock, config: notifier.config, inbox: notifier.digest.inbox,
+    runner: { run: (args) => notifier.digest.run(args) },
+    logger: { info() {}, warn() {}, error() {} },
+  })
+  clock.advance(120_000)
+  const summary = await fresh.tick()
+  assert.equal(summary.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[중복 실행] 같은 기간 실행이 동시에 두 번 돌아도 한 번만 받는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup()
+  clock.set(NEXT_MORNING)
+  const [a, b] = await Promise.all([notifier.digest.run({ period: '2026-09-21' }), notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(mail.sent.length, 1)
+  assert.equal(a.sent + b.sent, 1)
+})
+
+test('[중복 실행] 동시 실행 중 첫 발송이 실패해도 재시도로 보내져 한 번만 받는다', async () => {
+  const { notifier, clock, mail } = await collectedSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }] } })
+  clock.set(NEXT_MORNING)
+  await Promise.all([notifier.digest.run({ period: '2026-09-21' }), notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[중복 실행] 메시지를 만들다 실패한 요약은 보낸 권리를 놓아, 같은 기간을 다시 실행하면 보내진다', async () => {
+  const { notifier, clock, mail } = await collectedSetup()
+  clock.set(NEXT_MORNING)
+  const itemsFor = notifier.digest.inbox.itemsFor
+  notifier.digest.inbox.itemsFor = () => { throw new Error('boom') }
+  const first = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  notifier.digest.inbox.itemsFor = itemsFor
+  const again = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(again.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
