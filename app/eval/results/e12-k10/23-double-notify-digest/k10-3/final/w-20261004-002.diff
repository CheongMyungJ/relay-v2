 // 요약 발송 한 건의 제한 시간.
 // 요약은 아침에 한꺼번에 수천 통을 보내므로, 한 사람에게 오래 걸리면 뒤 사람들의 요약이 모두 밀린다.
-import { SendTimeoutError } from '../adapters/errors.js'
 
 /**
- * fn을 부르고 걸린 시간을 잰다. 제한 시간을 넘기면 시간 초과로 본다.
+ * fn을 부르고 걸린 시간을 잰다.
+ * fn이 오류를 던지면 그대로 던진다(어댑터가 던지는 시간 초과 오류는 실패로 다룬다).
+ * fn이 성공했으면 제한 시간을 넘겼어도 오류로 바꾸지 않는다. 이미 접수된 요약을 다시 보내면 중복이다.
+ * 넘긴 사실은 overrun으로만 알린다.
