diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..84ca015
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { SendError } from '../src/adapters/errors.js'
+import { loadConfig } from '../src/config/load.js'
+import { decide } from '../src/retry/policy.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+test('제한 시간보다 오래 걸렸어도 성공했으면 끝', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1000 }, options), { action: 'done' })
+})
+
+test('느리게 성공한 메일은 한 번만 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 3000 } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'sent')
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(notifier.retryQueue.size(), 0)
+})
+
+test('실제로 실패한 메일은 재시도로 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 300, outcomes: [{ fail: 'transient' }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'retry-scheduled')
+  clock.advance(120_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약: 느리게 성공한 메일은 다시 보내지 않는다', async () => {
+  const users = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+  const { notifier, clock, mail } = setup({ users, mail: { latencyMs: 5000 } })
+  await notifier.handle({ id: 'ord-1', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } })
+  clock.set(Date.parse('2026-09-21T23:05:00Z'))
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('요약: 오래 걸려 실패한 메일은 재시도로 다시 보낸다', async () => {
+  const users = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+  const { notifier, clock, mail } = setup({ users, mail: { latencyMs: 5000, outcomes: [{ fail: 'transient' }] } })
+  await notifier.handle({ id: 'ord-1', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } })
+  clock.set(Date.parse('2026-09-21T23:05:00Z'))
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
