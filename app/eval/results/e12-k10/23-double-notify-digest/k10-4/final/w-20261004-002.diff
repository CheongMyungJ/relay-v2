+// 요약 발송 선점 저장소. 서버가 여러 대이거나 재시작해도 한 통만 가게 하려면 서버들이 같이 쓰는 곳에 둬야 한다.
+// 운영에서는 DB의 유니크 키나 Redis의 SET NX 같은 것으로 이 인터페이스를 구현해 createNotifier({ digestClaims })로 넣는다.
+// 여기서는 메모리 구현만 둔다(한 프로세스 안, 또는 시험에서 서버 여러 대가 하나를 나눠 쓰는 경우).
+//
+// 인터페이스(값을 돌려주는 메서드는 Promise여도 된다):
+//   claim(key, ttlMs) → boolean  키가 없을 때만 선점하고 true. 이미 선점됐거나 보냈으면 false. 확인과 선점이 한 번에 이뤄져야 한다
+//   confirm(key, ttlMs)          보냈다고 표시한다(선점보다 길게 남긴다)
+//   release(key)                 선점을 푼다. 보내지 못했을 때 다시 시도할 수 있게 한다
+
+export function createMemoryClaimStore({ clock }) {
+  const entries = new Map() // key → { sent, expiresAt }
+
+  function live(key) {
+    const entry = entries.get(key)
+    if (!entry) return null
+    if (entry.expiresAt <= clock.now()) {
+      entries.delete(key)
+      return null
+    }
+    return entry
+  }
+
+  return {
+    claim(key, ttlMs) {
+      if (live(key)) return false
+      entries.set(key, { sent: false, expiresAt: clock.now() + ttlMs })
+      return true
+    },
+    confirm(key, ttlMs) {
+      entries.set(key, { sent: true, expiresAt: clock.now() + ttlMs })
+    },
+    release(key) {
+      // 이미 보낸 것으로 표시된 키는 풀지 않는다
+      if (live(key)?.sent === false) entries.delete(key)
+    },
+    isSent: (key) => live(key)?.sent === true,
+  }
+}
