diff --git a/tree/test/digest-claims.test.js b/tree/test/digest-claims.test.js
new file mode 100644
index 0000000..2b2de6c
--- /dev/null
+++ b/tree/test/digest-claims.test.js
@@ -0,0 +1,79 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { createFakeMailTransport } from '../src/adapters/fake-transports.js'
+import { createVirtualClock } from '../src/clock.js'
+import { createMemoryClaimStore } from '../src/digest/claims.js'
+import { createNotifier } from '../src/notifier.js'
+
+const USERS = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const event = { id: 'ord-1', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } }
+
+// 서버 한 대. 요약함은 서버마다 따로 있고 선점 저장소와 시계만 같이 쓴다
+async function server({ clock, claims, mail = {} }) {
+  const transport = createFakeMailTransport({ clock, latencyMs: 300, ...mail })
+  const notifier = createNotifier({ clock, transports: { mail: transport }, preferences: USERS, digestClaims: claims })
+  await notifier.handle(event)
+  return { notifier, mail: transport }
+}
+
+function world() {
+  const clock = createVirtualClock('2026-09-21T01:00:00Z')
+  return { clock, claims: createMemoryClaimStore({ clock }), later: () => clock.set(NEXT_MORNING) }
+}
+
+test('서버 두 대가 같은 요약을 동시에 돌려도 한 통만 간다', async () => {
+  const w = world()
+  const a = await server(w)
+  const b = await server(w)
+  w.later()
+  const [ra, rb] = await Promise.all([a.notifier.digest.tick(), b.notifier.digest.tick()])
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+  assert.equal(ra.sent + rb.sent, 1)
+  assert.equal(ra.already + rb.already, 1)
+})
+
+test('서버 두 대가 수십 분 간격으로 돌려도 한 통만 간다', async () => {
+  const w = world()
+  const a = await server(w)
+  const b = await server(w)
+  w.later()
+  await a.notifier.digest.tick()
+  w.clock.advance(40 * 60_000) // 선점 기간(10분)이 지난 뒤에도 보냈다는 표시는 남는다
+  await b.notifier.digest.tick()
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
+
+test('재시작한 서버(새 프로세스)도 이미 보낸 요약을 다시 보내지 않는다', async () => {
+  const w = world()
+  const before = await server(w)
+  const after = await server(w) // 배포 뒤 새 프로세스: 일정 상태(lastPeriod)가 비어 있다
+  w.later()
+  await before.notifier.digest.tick()
+  await after.notifier.digest.tick()
+  assert.equal(before.mail.sent.length + after.mail.sent.length, 1)
+})
+
+test('발송에 실패한 서버는 선점을 풀어, 다른 서버나 다음 일정이 다시 보낸다', async () => {
+  const w = world()
+  const fail = { fail: 'transient' }
+  const a = await server({ ...w, mail: { outcomes: [fail, fail, fail] } })
+  const b = await server(w)
+  w.later()
+  const first = await a.notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(a.mail.sent.length, 0)
+  const second = await b.notifier.digest.tick()
+  assert.equal(second.sent, 1)
+  assert.equal(b.mail.sent.length, 1)
+})
+
+test('보내던 서버가 죽으면 선점 기간이 지난 뒤 다른 서버가 보낸다', async () => {
+  const w = world()
+  const b = await server(w)
+  w.later()
+  assert.equal(await w.claims.claim('digest:2026-09-21:u-1', 10 * 60_000), true) // 다른 서버가 선점하고 죽음
+  assert.equal((await b.notifier.digest.run({ period: '2026-09-21' })).already, 1)
+  w.clock.advance(11 * 60_000)
+  assert.equal((await b.notifier.digest.run({ period: '2026-09-21' })).sent, 1)
+})
diff --git a/tree/test/digest-duplicate.test.js b/tree/test/digest-duplicate.test.js
new file mode 100644
index 0000000..9223f88
--- /dev/null
+++ b/tree/test/digest-duplicate.test.js
@@ -0,0 +1,87 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { createVirtualClock } from '../src/clock.js'
+import { createDigestScheduler } from '../src/digest/scheduler.js'
+import { setup } from './helpers.js'
+
+const USERS = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const event = { id: 'ord-1', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' } }
+
+async function ready(opts = {}) {
+  const ctx = setup({ users: USERS, ...opts })
+  await ctx.notifier.handle(event)
+  ctx.clock.set(NEXT_MORNING)
+  return ctx
+}
+
+test('제한 시간보다 느리게 성공한 요약은 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await ready({ mail: { latencyMs: 5000 } })
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+})
+
+test('같은 기간의 요약을 다시 실행해도 이미 보낸 사람에게는 보내지 않는다', async () => {
+  const { notifier, mail } = await ready()
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(mail.sent.length, 1)
+  assert.equal(second.already, 1)
+})
+
+test('발송이 끝내 실패한 요약은 다음 일정에서 다시 보낸다', async () => {
+  const fail = { fail: 'transient' }
+  const { notifier, clock, mail } = await ready({ mail: { latencyMs: 300, outcomes: [fail, fail, fail] } })
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  clock.advance(60_000)
+  const second = await notifier.digest.tick()
+  assert.equal(second.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  clock.advance(60_000)
+  assert.equal(await notifier.digest.tick(), null)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('일정이 하루를 놓쳐도 건너뛴 날의 요약을 보낸다', async () => {
+  const { notifier, clock, mail } = await ready()
+  await notifier.digest.tick()
+  await notifier.handle({ ...event, id: 'ord-2', receivedAt: undefined, data: { orderNo: 'A-2' } })
+  clock.set(Date.parse('2026-09-23T23:05:00Z')) // 22일 요약 시각(22일 23:05Z)을 놓침
+  await notifier.digest.tick()
+  const periods = mail.sent.map((m) => m.headers['X-Notify-Digest'])
+  assert.deepEqual(periods, ['2026-09-21/u-1', '2026-09-22/u-1'])
+})
+
+test('요약 발송 중 예외가 나도 그 날은 다음 일정에서 다시 시도한다', async () => {
+  const clock = createVirtualClock(NEXT_MORNING)
+  const config = { digest: { tzOffsetMinutes: 540, hour: 8, keepDays: 7 } }
+  const inbox = { dropBefore: () => 0 }
+  const logger = { info() {} }
+  const periods = []
+  let boom = true
+  const runner = { run: async ({ period }) => { periods.push(period); if (boom) { boom = false; throw new Error('db down') } return { period, failed: 0 } } }
+  const scheduler = createDigestScheduler({ clock, config, runner, inbox, logger })
+  await assert.rejects(scheduler.tick())
+  assert.equal((await scheduler.tick()).period, '2026-09-21')
+  assert.deepEqual(periods, ['2026-09-21', '2026-09-21'])
+})
+
+test('계속 예외가 나는 기간은 maxAttempts회까지만 다시 돌고 뒤 기간은 막지 않는다', async () => {
+  const clock = createVirtualClock(NEXT_MORNING)
+  const config = { digest: { tzOffsetMinutes: 540, hour: 8, keepDays: 7, maxAttempts: 2 } }
+  const inbox = { dropBefore: () => 0 }
+  const logger = { info() {} }
+  const periods = []
+  const runner = { run: async ({ period }) => { periods.push(period); if (period === '2026-09-21') throw new Error('db down'); return { period, failed: 0 } } }
+  const scheduler = createDigestScheduler({ clock, config, runner, inbox, logger })
+  await assert.rejects(scheduler.tick()) // 21일 첫 시도
+  clock.set(Date.parse('2026-09-22T23:05:00Z'))
+  const second = await scheduler.tick() // 21일 두 번째 시도(포기)와 22일
+  assert.equal(second.period, '2026-09-22')
+  assert.equal(await scheduler.tick(), null) // 더 돌지 않는다
+  assert.deepEqual(periods, ['2026-09-21', '2026-09-21', '2026-09-22'])
+})
