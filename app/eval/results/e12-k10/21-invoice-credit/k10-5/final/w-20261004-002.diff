@@ -0,0 +1,20 @@
+---
+kind: rule
+source: human
+anchor: sumLineVat
+---
+# 부가세는 과세 줄마다 원 단위 버림하고 그 합이 부가세다
+
+## 규칙
+- 청구서 부가세는 과세 품목 줄마다 (할인 후 줄 금액 × 세율)을 원 단위로 버림하고, 그 합이 청구서 부가세다. 합계에서 다시 반올림하지 않는다 (회계팀 규정). 예: INV-2031은 536+633+325+837+310 = 2,641원.
+- 할인은 부가세 전에 줄마다 적용하고, 부가세는 할인된 줄 금액에 매긴다.
+- 면세 품목과 영세율(`zeroRated`)은 부가세 0원이다.
+- 반품 전표 부가세(`creditTotals`)도 같은 규칙을 쓴다.
+- 예: CN-0112(INV-2047 반품)는 923+612+207 = 1,742원, 환불 합계 19,180원이다. 합계에서 한 번 반올림하면 19,182원이라 어긋난다.
+
+## 아직 규칙을 따르지 않는 곳
+- `src/invoice/credit-note.js`: 반품 전표 부가세를 같은 파일의 `sumCreditLineVat`로 따로 계산한다. 계산(줄마다 버림)은 규칙대로이나 청구서 쪽 계산과 한 곳으로 합쳐지지 않았다. 앞 Work(w-20261004-001)의 `sumLineVat`가 기준 브랜치에 아직 없어 이름 충돌을 피한 것이다. 머지 뒤 합쳐야 한다 (Work w-20261004-002)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
+- 2026-10-04 반품 전표 부가세를 줄마다 버림으로 고침, CN-0112 예 추가 (Work w-20261004-002)
diff --git a/base/src/invoice/credit-note.js b/tree/src/invoice/credit-note.js
index 6e6fe7d..5f41d21 100644
--- a/base/src/invoice/credit-note.js
+++ b/tree/src/invoice/credit-note.js
@@ -80,6 +80,17 @@ export function creditLineAmounts(note) {
   })
 }
 
+// 부가세. 돌려받는 과세 줄마다 (공급가액 × 세율)을 원 단위로 버림하고 그 합을 쓴다. 합계에서 다시 반올림하지 않는다
+// 면세 줄과 영세율 전표는 0원
+function sumCreditLineVat(rows, zeroRated) {
+  if (zeroRated) return 0
+  let vat = 0
+  for (const r of rows) {
+    if (r.taxable) vat += Math.floor((r.net * VAT_RATE_PERCENT) / 100)
+  }
+  return vat
+}
+
 // 반품 전표의 돌려주는 금액
 //   supply: 공급가액, taxable / exempt: 과세분 / 면세분, vat: 부가세, total: 돌려주는 합계
 export function creditTotals(note) {
@@ -87,7 +98,7 @@ export function creditTotals(note) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = note.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = sumCreditLineVat(rows, note.zeroRated)
   return { supply, taxable, exempt, vat, total: supply + vat }
 }
 
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
