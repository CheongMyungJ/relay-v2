+import { readFileSync } from 'node:fs'
 import { test } from 'node:test'
 import assert from 'node:assert'
 import { creditNoteEntries, ledger } from '../src/export/ledger.js'
@@ -81,3 +82,72 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+const readExample = (name) => JSON.parse(readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+
+test('CN-0112 환불 합계는 19,180원이다', () => {
+  const cn = createCreditNote(readExample('INV-2047'), readExample('CN-0112'))
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('반품 부가세는 과세 줄마다 버림한 값의 합이고 합계에서 다시 반올림하지 않는다', () => {
+  const invoice = {
+    number: 'INV-0200',
+    status: 'issued',
+    customerId: 'C-1',
+    zeroRated: false,
+    lines: [
+      { sku: 'A-1', name: 'A', unitPrice: 19, qty: 1, taxType: 'taxable' },
+      { sku: 'B-1', name: 'B', unitPrice: 19, qty: 1, taxType: 'taxable' },
+    ],
+  }
+  const cn = createCreditNote(invoice, {
+    number: 'CN-0200',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [
+      { sku: 'A-1', qty: 1 },
+      { sku: 'B-1', qty: 1 },
+    ],
+  })
+  // 줄마다 floor(1.9) = 1, 합 2원 (합계 38원에서 한 번 반올림하면 4원)
+  assert.strictEqual(cn.totals.vat, 2)
+  assert.strictEqual(cn.totals.total, 40)
+})
+
+test('반품 부가세: 일부 수량, 비율 할인, 금액 할인, 면세, 영세율', () => {
+  const invoice = {
+    number: 'INV-0201',
+    status: 'issued',
+    customerId: 'C-1',
+    zeroRated: false,
+    lines: [
+      { sku: 'P-1', name: '일부', unitPrice: 1234, qty: 5, taxType: 'taxable' },
+      { sku: 'R-1', name: '비율', unitPrice: 2150, qty: 6, taxType: 'taxable', discount: { percent: 5 } },
+      { sku: 'M-1', name: '금액', unitPrice: 1342, qty: 8, taxType: 'taxable', discount: { amount: 1500 } },
+      { sku: 'E-1', name: '면세', unitPrice: 5000, qty: 2, taxType: 'exempt' },
+    ],
+  }
+  const data = {
+    number: 'CN-0201',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [
+      { sku: 'P-1', qty: 3 },
+      { sku: 'R-1', qty: 3 },
+      { sku: 'M-1', qty: 3 },
+      { sku: 'E-1', qty: 1 },
+    ],
+  }
+  const cn = createCreditNote(invoice, data)
+  // 일부 3702 -> 370, 비율 6450-323=6127 -> 612, 금액 4026-563(=round(1500*3/8))=3463 -> 346, 면세 0
+  assert.strictEqual(returnedDiscount(cn.lines[2]), 563)
+  assert.strictEqual(cn.totals.taxable, 3702 + 6127 + 3463)
+  assert.strictEqual(cn.totals.exempt, 5000)
+  assert.strictEqual(cn.totals.vat, 370 + 612 + 346)
+  assert.strictEqual(cn.totals.total, cn.totals.supply + cn.totals.vat)
+
+  const zero = createCreditNote({ ...invoice, zeroRated: true }, data)
+  assert.strictEqual(zero.totals.vat, 0)
+  assert.strictEqual(zero.totals.total, zero.totals.supply)
+})
