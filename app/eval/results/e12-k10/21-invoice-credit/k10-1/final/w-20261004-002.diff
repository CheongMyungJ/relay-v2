+import { readFileSync } from 'node:fs'
 import { test } from 'node:test'
 import assert from 'node:assert'
 import { creditNoteEntries, ledger } from '../src/export/ledger.js'
@@ -81,3 +82,26 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세는 줄마다 버림한 합이다 (CN-0112)', () => {
+  const inv2047 = JSON.parse(readFileSync(new URL('../examples/INV-2047.json', import.meta.url)))
+  const req = JSON.parse(readFileSync(new URL('../examples/CN-0112.json', import.meta.url)))
+  const cn = createCreditNote(inv2047, req)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('면세 줄과 영세율 반품 전표의 부가세는 0이다', () => {
+  assert.strictEqual(note([{ sku: 'BK-1800', qty: 2 }]).totals.vat, 0)
+  const zr = issueInvoice(
+    createInvoice({ customerId: 'C-0412', zeroRated: true, lines: [{ sku: 'OF-1450', name: '포스트잇', unitPrice: 1455, qty: 3 }] }),
+    { number: 'INV-0101', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(zr, { number: 'CN-0002', issueDate: '2026-09-10', reason: '파손', returns: [{ sku: 'OF-1450', qty: 3 }] })
+  assert.deepStrictEqual(cn.totals, { supply: 4365, taxable: 4365, exempt: 0, vat: 0, total: 4365 })
+})
+
+test('저장된 totals가 있으면 다시 계산하지 않는다', () => {
+  const cn = note([{ sku: 'OF-1450', qty: 2 }])
+  const totals = { supply: 1, taxable: 1, exempt: 0, vat: 1, total: 2 }
+  assert.strictEqual(creditNoteTotals({ ...cn, totals }), totals)
+})
