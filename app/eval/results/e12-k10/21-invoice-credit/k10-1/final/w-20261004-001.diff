+  const src = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'OF-1342', name: '박스테이프', unitPrice: 1342, qty: 4 },
+        { sku: 'OF-0905', name: '네임펜 흑', unitPrice: 905, qty: 7 },
+      ],
+    }),
+    { number: 'INV-0101', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(src, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [
+      { sku: 'OF-1342', qty: 4 },
+      { sku: 'OF-0905', qty: 7 },
+    ],
+  })
+  // 5368 -> 536, 6335 -> 633. 합계에 한 번 반올림하면 1170이 된다
