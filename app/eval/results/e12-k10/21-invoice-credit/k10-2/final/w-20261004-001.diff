diff --git a/tree/docs/knowledge/invoice/vat-per-line-floor.md b/tree/docs/knowledge/invoice/vat-per-line-floor.md
new file mode 100644
index 0000000..0447d5d
--- /dev/null
+++ b/tree/docs/knowledge/invoice/vat-per-line-floor.md
@@ -0,0 +1,16 @@
+---
+kind: rule
+source: human
+---
+# 부가세는 과세 줄마다 할인 후 금액에 원 단위 버림으로 구해 합산한다
+
+## 규칙
+- 회계팀 규칙: 할인은 줄마다 먼저 적용하고, 부가세는 할인된 과세 품목 줄 금액에 매겨 원 단위 버림(`Math.floor`)으로 구한 뒤 합산한다. 합계에서 다시 반올림하지 않는다.
+- 예: INV-2031(`examples/INV-2031.json`)은 공급가액 26,438원, 부가세 2,641원, 합계 29,079원이다. 합계 기준 반올림(2,644원)이나 합계 기준 버림(2,643원)은 틀린 값이다.
+- 면세 줄은 부가세가 없고, 영세율(`zeroRated`) 청구서의 부가세는 0원이다.
+
+## 아직 규칙을 따르지 않는 곳
+- src/invoice/credit-note.js: 부가세를 합계 기준 `Math.round`로 계산한다(90줄 근처). 사람이 Work w-20261004-001의 범위에서 뺌(2026-10-04)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..6342098 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -23,6 +23,9 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 회계팀 규칙: 과세 줄마다 할인 후 금액의 부가세를 원 단위 버림으로 구해 합산한다
+  const vat = invoice.zeroRated
+    ? 0
+    : sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/total.test.js b/tree/test/total.test.js
index 5b9aafd..7c91d03 100644
--- a/base/test/total.test.js
+++ b/tree/test/total.test.js
@@ -60,3 +60,28 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 과세 줄마다 원 단위 버림으로 구해 합산한다 (INV-2031)', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('줄별 버림 부가세는 할인 후 금액 기준이고 면세 줄은 제외한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1005, qty: 1, discount: { amount: 5 } },
+    { name: 'B', unitPrice: 999, qty: 1 },
+    { name: 'C', unitPrice: 999, qty: 1, taxType: 'exempt' },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.vat, 100 + 99)
+  assert.strictEqual(t.total, 1000 + 999 + 999 + 199)
+})
