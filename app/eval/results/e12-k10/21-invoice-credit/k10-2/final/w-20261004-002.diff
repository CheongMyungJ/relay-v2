+
+const inv2047 = JSON.parse(readFileSync(new URL('../examples/INV-2047.json', import.meta.url), 'utf8'))
+const cn0112 = JSON.parse(readFileSync(new URL('../examples/CN-0112.json', import.meta.url), 'utf8'))
+
+test('CN-0112: 부가세는 과세 줄마다 할인 후 금액에 버림으로 구해 합산한다', () => {
+  const cn = createCreditNote(inv2047, cn0112)
+  // 줄 공급가액 9236 / 6127 / 2075 -> 부가세 923 + 612 + 207 (합계 기준 반올림은 1744)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+})
+
+test('반품 전표 부가세: 면세 줄은 없고 영세율은 0원', () => {
+  const lines = [
+    { sku: 'A', name: 'a', unitPrice: 105, qty: 1, taxType: 'taxable' },
+    { sku: 'B', name: 'b', unitPrice: 105, qty: 1, taxType: 'taxable' },
+    { sku: 'C', name: 'c', unitPrice: 999, qty: 1, taxType: 'exempt' },
+  ]
+  const t = creditTotals({ lines, zeroRated: false })
+  assert.strictEqual(t.vat, 20) // 줄마다 floor(10.5)=10, 합계 기준 반올림이면 21
+  assert.strictEqual(creditTotals({ lines, zeroRated: true }).vat, 0)
+})
+
+test('저장된 totals가 있으면 다시 계산하지 않는다', () => {
+  const totals = { supply: 1, taxable: 1, exempt: 0, vat: 9, total: 10 }
+  assert.strictEqual(creditNoteTotals({ ...createCreditNote(inv2047, cn0112), totals }), totals)
+})
