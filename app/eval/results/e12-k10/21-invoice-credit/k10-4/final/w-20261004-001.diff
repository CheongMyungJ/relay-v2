diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..3fa504f 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -13,6 +13,16 @@ export function lineAmounts(invoice) {
   })
 }
 
+// 과세 줄 하나의 부가세: 공급가액 × 세율을 원 단위로 버림 (회계팀 규칙). 합계에서 다시 반올림하지 않는다
+export function lineVat(net) {
+  return Math.floor((net * VAT_RATE_PERCENT) / 100)
+}
+
+// 과세 줄마다 lineVat을 구해 더한 부가세
+export function sumLineVat(rows) {
+  return sumWon(rows.filter((r) => r.taxable).map((r) => lineVat(r.net)))
+}
+
 // 청구서 합계
 //   subtotal: 할인 전 금액 합, discount: 할인 합, supply: 공급가액 합
 //   taxable / exempt: 공급가액 중 과세분 / 면세분, vat: 부가세, total: 청구 합계
@@ -23,6 +33,6 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  const vat = invoice.zeroRated ? 0 : sumLineVat(rows)
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/credit-note.test.js b/tree/test/credit-note.test.js
index 5c7f920..168f47b 100644
--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -81,3 +81,28 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표의 부가세는 과세 줄마다 버림한 값의 합이다', () => {
+  const odd = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'A-1', name: 'A', unitPrice: 1019, qty: 2 },
+        { sku: 'B-1', name: 'B', unitPrice: 1019, qty: 2, discount: { amount: 11 } },
+      ],
+    }),
+    { number: 'INV-0101', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(odd, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [
+      { sku: 'A-1', qty: 1 },
+      { sku: 'B-1', qty: 1 },
+    ],
+  })
+  // A: 1019 → 101, B: 할인 후 1019 - round(5.5)=1013 → 101 (합계 기준이면 203)
+  assert.strictEqual(cn.totals.vat, 202)
+  assert.strictEqual(cn.totals.total, cn.totals.supply + 202)
+})
