diff --git a/base/src/orders/refund.js b/tree/src/orders/refund.js
index 7d4f479..98056f4 100644
--- a/base/src/orders/refund.js
+++ b/tree/src/orders/refund.js
@@ -1,12 +1,26 @@
 import { POINT_RATE_PERCENT, REFUND_NUMBER } from '../config.js'
 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { sumWon } from '../money.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
 //   쿠폰 할인과 사용한 포인트는 남은 주문에 그대로 둔다. 남은 상품 금액이 그보다 적어지면 전체 취소로 한다.
 // - 전체 취소(cancelOrder): 결제 금액을 모두 돌려주고, 적립 포인트를 모두 회수하고, 사용한 포인트를 돌려준다.
 
+// 남은 주문의 적립 포인트: (남은 상품 금액 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%, 1P 미만 버림. 배송비 제외
+function remainingEarn(order, remainingGoods) {
+  const base = remainingGoods - order.amounts.coupon - order.amounts.pointsUsed
+  return Math.floor((base * POINT_RATE_PERCENT) / 100)
+}
+
+// 회수 포인트 = 환불 전 적립 − 환불 후 적립. 첫 환불의 환불 전 적립은 저장된 points.earned를 쓴다
+function pointsRecoveredOf(order, refundedBefore, remainingGoods) {
+  const before = refundedBefore === 0
+    ? order.points.earned
+    : remainingEarn(order, order.amounts.goods - refundedBefore)
+  return Math.max(0, before - remainingEarn(order, remainingGoods))
+}
+
 export function createRefund(order, input) {
   if (!REFUND_NUMBER.test(input.number ?? '')) throw new Error(`환불 번호 형식은 R-0000: ${input.number}`)
   const already = new Map((input.alreadyRefunded ?? []).map((r) => [r.sku, r.qty]))
@@ -31,7 +45,7 @@ export function createRefund(order, input) {
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered: pointsRecoveredOf(order, refundedBefore, remainingGoods),
   }
 }
 
