 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 대상 금액: 상품 금액 − 쿠폰 할인 − 사용한 포인트. 배송비는 넣지 않는다 */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 적립 대상 금액의 POINT_RATE_PERCENT%. 1P 미만은 버린다 */
+export function pointsOf(base) {
+  return floorPercentOf(base, POINT_RATE_PERCENT)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return pointsOf(earnBase(order.amounts))
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..d631bcd
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,74 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { cancelOrder, createRefund } from '../src/orders/refund.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+const gift = { customerId: 'U-1', recipient: { name: '김하늘', phone: '010-1234-5678' } }
+
+test('O-1042 적립 예정은 237P (상품 − 쿠폰 − 사용 포인트의 1%)', () => {
+  const input = JSON.parse(fs.readFileSync(new URL('../examples/O-1042.json', import.meta.url), 'utf8'))
+  assert.strictEqual(createOrder(input).points.earned, 237)
+})
+
+test('배송비는 적립 대상에서 빠진다: 배송비 있는 주문과 없는 주문', () => {
+  const paid = createOrder({ ...base, number: 'O-0010', lines: [{ sku: 'A', unitPrice: 20000 }] })
+  assert.strictEqual(paid.amounts.shipping, 3000)
+  assert.strictEqual(paid.points.earned, 200)
+  const free = createOrder({ ...base, number: 'O-0011', lines: [{ sku: 'A', unitPrice: 30000 }] })
+  assert.strictEqual(free.amounts.shipping, 0)
+  assert.strictEqual(free.points.earned, 300)
+})
+
+test('1P 미만은 버리고 반올림하지 않는다', () => {
+  const o = createOrder({ ...base, number: 'O-0012', lines: [{ sku: 'A', unitPrice: 29990 }] })
+  assert.strictEqual(o.points.earned, 299)
+})
+
+test('선물하기 적립도 같은 규칙이다', () => {
+  const g = createGiftOrder({ ...gift, number: 'G-0010', lines: [{ sku: 'A', unitPrice: 28270 }], coupon: { code: 'C', amount: 3000 }, pointsUsed: 1500 })
+  assert.strictEqual(g.amounts.shipping, 3000)
+  assert.strictEqual(g.points.earned, 237)
+})
+
+test('환불 회수도 같은 규칙이다: 환불 전후 적립 포인트의 차이', () => {
+  const order = createOrder({
+    ...base, number: 'O-0013', coupon: { code: 'C', amount: 3000 }, pointsUsed: 1500,
+    lines: [{ sku: 'A', unitPrice: 9990, qty: 2 }, { sku: 'B', unitPrice: 8290 }],
+  })
+  assert.strictEqual(order.points.earned, 237)
+  const r = createRefund(order, { number: 'R-0010', items: [{ sku: 'B', qty: 1 }] })
+  // 적립 대상 23770 → 15480: 237P → 154P
+  assert.strictEqual(r.pointsRecovered, 237 - 154)
+})
+
+test('부분 환불을 나눠 해도 회수 합계가 적립을 넘지 않는다', () => {
+  const order = createOrder({
+    ...base, number: 'O-0014',
+    lines: [{ sku: 'A', unitPrice: 1990, qty: 5 }, { sku: 'B', unitPrice: 20050 }],
+  })
+  const r1 = createRefund(order, { number: 'R-0011', items: [{ sku: 'A', qty: 2 }] })
+  const r2 = createRefund(order, { number: 'R-0012', items: [{ sku: 'A', qty: 3 }], alreadyRefunded: [{ sku: 'A', qty: 2 }] })
+  assert.ok(r1.pointsRecovered + r2.pointsRecovered <= order.points.earned)
+  assert.strictEqual(r1.pointsRecovered + r2.pointsRecovered, 300 - 200)
+})
+
+test('저장된 points.earned는 다시 계산하지 않는다', () => {
+  const stored = {
+    number: 'O-0100', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }], coupon: null,
+    amounts: { goods: 20000, coupon: 0, shipping: 3000, pointsUsed: 0, total: 23000 },
+    points: { used: 0, earned: 999 },
+  }
+  assert.strictEqual(createRefund(stored, { number: 'R-0013', items: [{ sku: 'A', qty: 1 }] }).pointsRecovered, 200)
+})
+
+test('전체 취소는 저장된 points.earned를 그대로 회수한다', () => {
+  const stored = {
+    number: 'O-0101', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }], coupon: null,
+    amounts: { goods: 20000, coupon: 0, shipping: 3000, pointsUsed: 0, total: 23000 },
+    points: { used: 0, earned: 999 },
+  }
+  assert.strictEqual(cancelOrder(stored).pointsRecovered, 999)
+})
