@@ -0,0 +1,18 @@
+---
+kind: rule
+source: human
+---
+# 적립 포인트는 (상품 금액 − 쿠폰 − 사용 포인트)의 1%, 배송비 제외, 1P 미만 버림
+
+## 규칙
+- 적립 기준 금액은 상품 금액에서 쿠폰 할인과 사용한 포인트를 뺀 금액이다. 배송비는 넣지 않는다.
+- 적립 포인트는 기준 금액의 1%를 1P 미만 버림한다(반올림 아님). 예: O-1042는 23,770원 → 237P.
+- 일반 주문 적립은 `src/points/earn.js`의 `earnPoints`가 이 규칙대로 계산한다.
+- 부분 환불 회수 포인트 = 주문에 저장된 `points.earned` − 남은 상품으로 다시 계산한 적립. 재계산은 위 규칙(남은 상품 금액 − 쿠폰 − 사용 포인트의 1%, 배송비 제외, 버림)을 쓰고, 쿠폰과 사용 포인트는 남은 주문에 그대로 둔다. 남은 상품 금액은 이전 환불 수량(`alreadyRefunded`)도 뺀다. 예: O-1077/R-0311 → 403−271 = 132P. (`src/orders/refund.js`의 `createRefund`)
+
+## 아직 규칙을 따르지 않는 곳
+- src/gift/gift-points.js: 배송비 포함 결제 금액에 반올림을 쓴다. 사람이 Work w-20261004-001의 범위에서 뺌(2026-10-04)
+
+## 바뀐 이력
+- 2026-10-04 처음 남김 (Work w-20261004-001)
+- 2026-10-04 src/orders/refund.js를 규칙대로 고침: 환불 상품 금액 반올림 → 저장된 적립 − 남은 상품 재계산 적립(버림) (Work w-20261004-002, 사람이 알려 줌)
diff --git a/base/src/orders/refund.js b/tree/src/orders/refund.js
index 7d4f479..94f4910 100644
--- a/base/src/orders/refund.js
+++ b/tree/src/orders/refund.js
@@ -1,6 +1,6 @@
 import { POINT_RATE_PERCENT, REFUND_NUMBER } from '../config.js'
 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { sumWon } from '../money.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
@@ -26,12 +26,16 @@ export function createRefund(order, input) {
   const remainingGoods = order.amounts.goods - refundedBefore - refundGoods
   if (remainingGoods < order.amounts.coupon + order.amounts.pointsUsed)
     throw new Error('남은 상품 금액이 쿠폰 할인과 사용 포인트보다 적다. 전체 취소로 처리한다')
+  // 회수 = 저장된 적립 − 남은 상품으로 다시 계산한 적립(쿠폰·사용 포인트는 남은 주문에 그대로, 배송비 제외, 1P 미만 버림)
+  const remainingEarn = Math.floor(
+    ((remainingGoods - order.amounts.coupon - order.amounts.pointsUsed) * POINT_RATE_PERCENT) / 100,
+  )
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered: Math.max(0, order.points.earned - remainingEarn),
   }
 }
 
