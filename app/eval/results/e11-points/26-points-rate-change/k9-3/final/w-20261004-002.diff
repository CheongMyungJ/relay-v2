-import { POINT_RATE_PERCENT, REFUND_NUMBER } from '../config.js'
+import { REFUND_NUMBER } from '../config.js'
 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { sumWon } from '../money.js'
+import { earnFromAmounts } from '../points/earn.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
@@ -26,12 +27,18 @@ export function createRefund(order, input) {
   const remainingGoods = order.amounts.goods - refundedBefore - refundGoods
   if (remainingGoods < order.amounts.coupon + order.amounts.pointsUsed)
     throw new Error('남은 상품 금액이 쿠폰 할인과 사용 포인트보다 적다. 전체 취소로 처리한다')
+  const remainingEarn = earnFromAmounts({
+    goods: remainingGoods,
+    coupon: order.amounts.coupon,
+    pointsUsed: order.amounts.pointsUsed,
+  })
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    // 저장된 적립(points.earned)에서 남은 주문의 적립 기준을 뺀 만큼 회수한다. 저장된 적립은 다시 계산하지 않는다
+    pointsRecovered: order.points.earned - remainingEarn,
   }
 }
 
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..d0f65b2 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -5,3 +5,8 @@ import { percentOf } from '../money.js'
 export function earnPoints(order) {
   return percentOf(order.amounts.total, POINT_RATE_PERCENT)
 }
+
+/** 적립 기준: (상품 금액 − 쿠폰 − 사용 포인트)의 POINT_RATE_PERCENT%, 1P 미만 버림. 배송비 제외 */
+export function earnFromAmounts({ goods, coupon, pointsUsed }) {
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
+}
diff --git a/base/test/refund.test.js b/tree/test/refund.test.js
index de6f8a4..ea4b1c8 100644
--- a/base/test/refund.test.js
+++ b/tree/test/refund.test.js
@@ -30,3 +30,43 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+test('부분 환불: 쿠폰·사용 포인트가 있으면 남은 주문의 적립 기준 차이만큼 회수한다 (O-1077 / R-0311)', () => {
+  const o = {
+    number: 'O-1077',
+    lines: [
+      { sku: 'KT-2290', unitPrice: 12900, qty: 2 },
+      { sku: 'TW-0838', unitPrice: 8380, qty: 1 },
+      { sku: 'SP-0656', unitPrice: 6565, qty: 2 },
+    ],
+    amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+    points: { used: 2000, earned: 403 },
+  }
+  const r = createRefund(o, { number: 'R-0311', items: [{ sku: 'SP-0656', qty: 2 }] })
+  assert.strictEqual(r.refundAmount, 13130)
+  assert.strictEqual(r.pointsRecovered, 132)
+})
+
+test('부분 환불: 회수 포인트는 저장된 points.earned에서 남은 주문의 적립 기준을 뺀 값이다 (재계산하지 않는다)', () => {
+  const o = {
+    number: 'O-1078',
+    lines: [{ sku: 'A', unitPrice: 10000, qty: 5 }],
+    amounts: { goods: 50000, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 43000 },
+    points: { used: 2000, earned: 450 }, // 기준 재계산 값(430)과 다르게 저장된 적립
+  }
+  const r = createRefund(o, { number: 'R-0312', items: [{ sku: 'A', qty: 2 }] })
+  assert.strictEqual(r.refundAmount, 20000)
+  // 남은 기준 금액 30000-5000-2000=23000 → 230P, 450-230=220
+  assert.strictEqual(r.pointsRecovered, 220)
+})
+
+test('부분 환불: 이미 환불한 수량이 있어도 환불 금액은 이번 줄만 계산한다', () => {
+  const o = {
+    number: 'O-1079',
+    lines: [{ sku: 'A', unitPrice: 10000, qty: 5 }],
+    amounts: { goods: 50000, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 43000 },
+    points: { used: 2000, earned: 430 },
+  }
+  const r = createRefund(o, { number: 'R-0313', items: [{ sku: 'A', qty: 1 }], alreadyRefunded: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r.refundAmount, 10000)
+})
