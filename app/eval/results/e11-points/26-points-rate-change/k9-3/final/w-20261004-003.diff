+++ b/tree/test/earn-rate.test.js
@@ -0,0 +1,40 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+import { earnFromAmounts } from '../src/points/earn.js'
+
+const o1107 = JSON.parse(readFileSync(new URL('../examples/O-1107.json', import.meta.url)))
+
+test('O-1107 적립은 (상품 − 쿠폰 − 사용 포인트)의 2%, 배송비 제외, 버림: 486P', () => {
+  const o = createOrder(o1107)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 486)
+})
+
+test('선물하기 적립도 같은 기준과 2%를 쓴다', () => {
+  const g = createGiftOrder({
+    ...o1107,
+    number: 'G-1107',
+    recipient: { name: '김하늘', phone: '010-1234-5678' },
+  })
+  assert.strictEqual(g.points.earned, 486)
+})
+
+test('earnFromAmounts: 1P 미만은 버린다', () => {
+  assert.strictEqual(earnFromAmounts({ goods: 27350, coupon: 2000, pointsUsed: 1020 }), 486)
+  assert.strictEqual(earnFromAmounts({ goods: 1099, coupon: 0, pointsUsed: 0 }), 21)
+})
+
+test('환불 회수는 적립률 변경과 상관없이 기존 1% 계산 그대로', () => {
+  const order = {
+    number: 'O-0100',
+    lines: [{ sku: 'B', name: 'B', unitPrice: 10050, qty: 1 }, { sku: 'A', name: 'A', unitPrice: 20000, qty: 1 }],
+    amounts: { goods: 30050, coupon: 0, shipping: 0, pointsUsed: 0, total: 30050 },
+    points: { used: 0, earned: 601 },
+  }
+  const r = createRefund(order, { number: 'R-0001', items: [{ sku: 'B', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 101) // round(10050 * 1%) = 100.5 -> 101, 기존 동작
+})
