diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..ec75751 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,17 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준 금액 = 상품 금액 − 쿠폰 할인 − 사용한 포인트. 배송비는 뺀다 */
+export function earnBase({ goods, coupon, pointsUsed }) {
+  return Math.max(0, goods - coupon - pointsUsed)
+}
+
+/** 적립 기준 금액의 POINT_RATE_PERCENT%. 1P 미만은 버린다 */
+export function earnFromAmounts(amounts) {
+  return floorPercentOf(earnBase(amounts), POINT_RATE_PERCENT)
+}
+
+/** 주문의 적립 포인트 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnFromAmounts(order.amounts)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..ee6390f
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,43 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const example = (name) => JSON.parse(readFileSync(new URL(`../examples/${name}.json`, import.meta.url)))
+
+test('O-1042: 쿠폰·사용 포인트·배송비가 있어도 (상품−쿠폰−사용 포인트)의 1%, 237P', () => {
+  const o = createOrder(example('O-1042'))
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('배송비가 있는 주문도 배송비는 적립에서 제외한다', () => {
+  const o = createOrder({ customerId: 'U-1', number: 'O-0003', lines: [{ sku: 'A', unitPrice: 20000, qty: 1 }] })
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 200)
+})
+
+test('1P 미만 끝수는 버린다(반올림 아님)', () => {
+  const o = createOrder({ customerId: 'U-1', number: 'O-0004', lines: [{ sku: 'A', unitPrice: 25990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 259)
+})
+
+test('G-0213: 선물하기 적립도 같은 기준', () => {
+  const g = createGiftOrder(example('G-0213'))
+  // 15900 + 4480*2 = 24860 − 2000 − 1000 = 21860 → 218P
+  assert.strictEqual(g.points.earned, 218)
+})
+
+test('부분 환불 회수는 적립과 같은 기준이며 환불을 모두 더하면 적립분과 같다', () => {
+  const o = createOrder({
+    customerId: 'U-1', number: 'O-0005', coupon: { code: 'C', amount: 1000 }, pointsUsed: 1000,
+    lines: [{ sku: 'A', unitPrice: 9990, qty: 3 }],
+  })
+  assert.strictEqual(o.points.earned, 279) // 29970−1000−1000=27970
+  const r1 = createRefund(o, { number: 'R-0001', items: [{ sku: 'A', qty: 1 }] })
+  const r2 = createRefund(o, { number: 'R-0002', items: [{ sku: 'A', qty: 1 }], alreadyRefunded: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r1.pointsRecovered, 100) // 279 − 179(남은 29970−9990−2000)
+  assert.strictEqual(r2.pointsRecovered, 100) // 179 − 79
+  assert.strictEqual(r1.pointsRecovered + r2.pointsRecovered, 279 - 79)
+})
