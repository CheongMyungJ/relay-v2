@@ -0,0 +1,22 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { createGiftOrder } from '../src/gift/gift-order.js'
+import { createRefund } from '../src/orders/refund.js'
+
+const load = (n) => JSON.parse(readFileSync(new URL(`../examples/${n}.json`, import.meta.url), 'utf8'))
+
+test('O-1107은 배송비를 뺀 24,330원의 2%를 버림해 486P 적립', () => {
+  assert.strictEqual(createOrder(load('O-1107')).points.earned, 486)
+})
+
+test('선물하기도 같은 기준: G-0213은 (24,860 − 2,000 − 1,000)의 2% = 437P', () => {
+  assert.strictEqual(createGiftOrder(load('G-0213')).points.earned, 437)
+})
+
+test('부분 환불 회수는 적립률 변경과 무관하게 변경 전 값(1%, 반올림)', () => {
+  const order = createOrder({ ...load('O-1107'), number: 'O-1107' })
+  const r = createRefund(order, { number: 'R-0001', items: [{ sku: 'BK-0515', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 29)
+})
