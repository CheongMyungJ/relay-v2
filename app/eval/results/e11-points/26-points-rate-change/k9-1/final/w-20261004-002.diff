@@ -30,3 +30,28 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+const couponOrder = {
+  number: 'O-1077',
+  customerId: 'U-11853',
+  lines: [
+    { sku: 'KT-2290', name: 'KT', unitPrice: 12900, qty: 2 },
+    { sku: 'TW-0838', name: 'TW', unitPrice: 8380, qty: 1 },
+    { sku: 'SP-0656', name: 'SP', unitPrice: 6565, qty: 2 },
+  ],
+  coupon: { code: 'WELCOME5000', amount: 5000 },
+  amounts: { goods: 47310, coupon: 5000, shipping: 0, pointsUsed: 2000, total: 40310 },
+  points: { used: 2000, earned: 403 },
+}
+
+test('부분 환불 회수 포인트: 원 적립 − 남은 상품 재계산 적립(버림, 쿠폰·사용 포인트 유지)', () => {
+  const r = createRefund(couponOrder, { number: 'R-0311', items: [{ sku: 'SP-0656', qty: 2 }] })
+  assert.strictEqual(r.refundAmount, 13130)
+  assert.strictEqual(r.pointsRecovered, 132) // 403 − floor(27,180 × 1%)
+})
+
+test('부분 환불을 여러 번 해도 이전 환불의 회수분을 다시 회수하지 않는다', () => {
+  // 이전: SP 1개(6,565원) 환불(회수 403 − 337 = 66). 이번: SP 1개. 이번 몫 = 337 − 271
+  const r = createRefund(couponOrder, { number: 'R-0312', items: [{ sku: 'SP-0656', qty: 1 }], alreadyRefunded: [{ sku: 'SP-0656', qty: 1 }] })
+  assert.strictEqual(r.pointsRecovered, 66) // 이전 환불 뒤 재계산 floor(33,745 × 1%)=337 − 271
+})
