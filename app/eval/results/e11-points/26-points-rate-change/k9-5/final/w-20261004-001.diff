 import { lineAmount } from '../cart/line.js'
-import { percentOf, sumWon } from '../money.js'
+import { sumWon } from '../money.js'
+import { earnBase, earnOnBase } from '../points/earn.js'
 
 // 환불. order는 저장된 주문(createOrder의 결과를 저장한 것)이다. 저장된 금액과 적립 포인트를 쓴다.
 // - 부분 환불(createRefund): 돌려받는 줄의 상품 금액을 돌려주고, 적립했던 포인트 일부를 회수한다.
+//   회수 포인트는 환불 전후 남은 주문의 적립 포인트 차이다(적립 규칙과 같다: 배송비 제외, 버림).
 //   쿠폰 할인과 사용한 포인트는 남은 주문에 그대로 둔다. 남은 상품 금액이 그보다 적어지면 전체 취소로 한다.
 // - 전체 취소(cancelOrder): 결제 금액을 모두 돌려주고, 적립 포인트를 모두 회수하고, 사용한 포인트를 돌려준다.
 
@@ -26,12 +28,14 @@ export function createRefund(order, input) {
   const remainingGoods = order.amounts.goods - refundedBefore - refundGoods
   if (remainingGoods < order.amounts.coupon + order.amounts.pointsUsed)
     throw new Error('남은 상품 금액이 쿠폰 할인과 사용 포인트보다 적다. 전체 취소로 처리한다')
+  const baseBefore = earnBase({ ...order.amounts, goods: order.amounts.goods - refundedBefore })
+  const baseAfter = earnBase({ ...order.amounts, goods: remainingGoods })
   return {
     number: input.number,
     orderNumber: order.number,
     items,
     refundAmount: refundGoods,
-    pointsRecovered: percentOf(refundGoods, POINT_RATE_PERCENT),
+    pointsRecovered: earnOnBase(baseBefore) - earnOnBase(baseAfter),
   }
 }
 
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..3accf6c 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,17 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { floorPercentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 적립 기준액. 배송비를 뺀 금액(상품금액 − 쿠폰 − 사용 포인트) */
+export function earnBase(amounts) {
+  return amounts.goods - amounts.coupon - amounts.pointsUsed
+}
+
+/** 기준액에 대한 적립 포인트. 기준액의 POINT_RATE_PERCENT%를 원 단위로 버림 */
+export function earnOnBase(base) {
+  return floorPercentOf(base, POINT_RATE_PERCENT)
+}
+
+/** 주문의 적립 포인트. 배송비를 뺀 금액의 POINT_RATE_PERCENT% (버림) */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnOnBase(earnBase(order.amounts))
 }
