diff --git a/base/test/refund.test.js b/tree/test/refund.test.js
index de6f8a4..0da879c 100644
--- a/base/test/refund.test.js
+++ b/tree/test/refund.test.js
@@ -30,3 +30,44 @@ test('남은 수량보다 많이 환불할 수 없다', () => {
 test('전체 취소는 저장된 금액과 포인트를 모두 돌려놓는다', () => {
   assert.deepStrictEqual(cancelOrder(order), { orderNumber: 'O-0100', refundAmount: 50000, pointsRecovered: 500, pointsReturned: 0 })
 })
+
+test('부분 환불 회수는 적립 규칙(배송비 제외, 버림)과 어긋나지 않는다', () => {
+  const o = {
+    number: 'O-0101',
+    customerId: 'U-1',
+    lines: [{ sku: 'A', name: 'A', unitPrice: 8900, qty: 2 }, { sku: 'B', name: 'B', unitPrice: 3490, qty: 3 }],
+    coupon: { code: 'C', amount: 3000 },
+    amounts: { goods: 28270, coupon: 3000, shipping: 3000, pointsUsed: 1500, total: 26770 },
+    points: { used: 1500, earned: 237 },
+  }
+  const r = createRefund(o, { number: 'R-0003', items: [{ sku: 'B', qty: 1 }] })
+  // 환불 전 기준액 23,770 → 237, 환불 후 20,280 → 202, 회수 35 (기존: 3,490의 1% 반올림 = 35)
+  assert.strictEqual(r.pointsRecovered, 237 - 202)
+  // 환불 뒤 남은 주문의 적립 = 원래 적립 − 회수
+  assert.strictEqual(o.points.earned - r.pointsRecovered, Math.floor((28270 - 3490 - 3000 - 1500) / 100))
+})
+
+test('부분 환불을 나눠 해도 회수 합계가 남은 주문의 적립 차이와 같다', () => {
+  const o = {
+    number: 'O-0102', customerId: 'U-1',
+    lines: [{ sku: 'A', name: 'A', unitPrice: 1990, qty: 5 }],
+    coupon: null,
+    amounts: { goods: 9950, coupon: 0, shipping: 3000, pointsUsed: 0, total: 12950 },
+    points: { used: 0, earned: 99 },
+  }
+  const r1 = createRefund(o, { number: 'R-0004', items: [{ sku: 'A', qty: 1 }] })
+  const r2 = createRefund(o, { number: 'R-0005', items: [{ sku: 'A', qty: 1 }], alreadyRefunded: [{ sku: 'A', qty: 1 }] })
+  assert.strictEqual(r1.pointsRecovered + r2.pointsRecovered, 99 - Math.floor(5970 / 100))
+})
+
+test('부분 환불 회수는 환불 금액의 반올림이 아니라 남은 주문 적립과의 차이다', () => {
+  const o = {
+    number: 'O-0103', customerId: 'U-1',
+    lines: [{ sku: 'A', name: 'A', unitPrice: 1410, qty: 1 }, { sku: 'B', name: 'B', unitPrice: 3590, qty: 1 }],
+    coupon: null,
+    amounts: { goods: 5000, coupon: 0, shipping: 3000, pointsUsed: 0, total: 8000 },
+    points: { used: 0, earned: 50 },
+  }
+  // 남은 3,590 → 35P 적립. 회수는 50 − 35 = 15 (1,410의 1% 반올림 14가 아님)
+  assert.strictEqual(createRefund(o, { number: 'R-0006', items: [{ sku: 'A', qty: 1 }] }).pointsRecovered, 15)
+})
