-import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { earnPoints } from '../points/earn.js'
 
-/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다) */
+/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다). 일반 주문과 같은 규칙을 쓴다 */
 export function giftPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnPoints(order)
 }
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..df21f99 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 결제 금액의 POINT_RATE_PERCENT%를 원 단위로 내린다 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { total, shipping } = order.amounts
+  return Math.floor(((total - shipping) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..dc662e3
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,22 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+
+const example = (name) => JSON.parse(fs.readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+
+test('O-1042 적립 포인트는 배송비를 뺀 결제 금액의 1%를 내림해 237P', () => {
+  const o = createOrder(example('O-1042'))
+  assert.strictEqual(o.amounts.total, 26770)
+  assert.strictEqual(o.amounts.shipping, 3000)
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('O-1107 적립 포인트는 배송비를 뺀 결제 금액(24,330원)의 1%', () => {
+  assert.strictEqual(createOrder(example('O-1107')).points.earned, 243)
+})
+
+test('배송비가 없으면 결제 금액의 1%', () => {
+  const o = createOrder({ customerId: 'U-1', number: 'O-0003', lines: [{ sku: 'A', unitPrice: 25000, qty: 2 }] })
+  assert.strictEqual(o.points.earned, 500)
+})
