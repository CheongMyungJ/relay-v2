@@ -1,7 +1,6 @@
-import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
+import { earnPoints } from '../points/earn.js'
 
-/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다) */
+/** 선물하기 주문의 적립 포인트(보내는 사람에게 쌓인다). 일반 주문과 같은 기준 */
 export function giftPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  return earnPoints(order)
 }
diff --git a/base/src/points/earn.js b/tree/src/points/earn.js
index 1ad53ff..b3520ad 100644
--- a/base/src/points/earn.js
+++ b/tree/src/points/earn.js
@@ -1,7 +1,7 @@
 import { POINT_RATE_PERCENT } from '../config.js'
-import { percentOf } from '../money.js'
 
-/** 주문의 적립 포인트. 결제 금액의 POINT_RATE_PERCENT% */
+/** 주문의 적립 포인트. 배송비를 뺀 결제 금액(상품 - 쿠폰 - 사용 포인트)의 POINT_RATE_PERCENT%, 원 단위 미만 버림 */
 export function earnPoints(order) {
-  return percentOf(order.amounts.total, POINT_RATE_PERCENT)
+  const { goods, coupon, pointsUsed } = order.amounts
+  return Math.floor(((goods - coupon - pointsUsed) * POINT_RATE_PERCENT) / 100)
 }
diff --git a/tree/test/earn.test.js b/tree/test/earn.test.js
new file mode 100644
index 0000000..dd125e5
--- /dev/null
+++ b/tree/test/earn.test.js
@@ -0,0 +1,33 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { readFileSync } from 'node:fs'
+import { createOrder } from '../src/orders/order.js'
+import { earnPoints } from '../src/points/earn.js'
+
+const base = { customerId: 'U-1', orderedAt: '2026-10-01T10:00:00+09:00' }
+const example = (name) => JSON.parse(readFileSync(new URL(`../examples/${name}.json`, import.meta.url), 'utf8'))
+
+test('O-1042의 적립 예정 포인트는 237P (배송비 제외, 원 단위 미만 버림)', () => {
+  const o = createOrder(example('O-1042'))
+  assert.strictEqual(o.points.earned, 237)
+})
+
+test('적립은 배송비를 뺀 결제 금액 기준', () => {
+  const o = createOrder({ ...base, number: 'O-0003', lines: [{ sku: 'A', unitPrice: 10000, qty: 1 }] })
+  assert.strictEqual(o.amounts.total, 13000)
+  assert.strictEqual(o.points.earned, 100)
+})
+
+test('적립 포인트는 원 단위 미만을 버린다', () => {
+  const o = createOrder({ ...base, number: 'O-0004', lines: [{ sku: 'A', unitPrice: 19990, qty: 1 }] })
+  assert.strictEqual(o.points.earned, 199)
+})
+
+test('무료 배송 주문과 사용 포인트가 있는 주문도 같은 기준', () => {
+  const o = createOrder({ ...base, number: 'O-0005', lines: [{ sku: 'A', unitPrice: 20000, qty: 2 }], pointsUsed: 1050 })
+  assert.strictEqual(o.points.earned, 389)
+})
+
+test('earnPoints는 저장된 amounts만 쓴다', () => {
+  assert.strictEqual(earnPoints({ amounts: { goods: 28270, coupon: 3000, shipping: 3000, pointsUsed: 1500, total: 26770 } }), 237)
+})
