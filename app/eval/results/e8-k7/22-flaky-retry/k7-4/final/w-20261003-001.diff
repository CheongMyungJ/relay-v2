diff --git a/base/test/pool.test.js b/tree/test/pool.test.js
index c22d51a..7b3cc97 100644
--- a/base/test/pool.test.js
+++ b/tree/test/pool.test.js
@@ -34,3 +34,21 @@ test('묶음마다 진행 알림', async () => {
 test('빈 목록', async () => {
   assert.deepStrictEqual(await runPool([], async () => 1, { concurrency: 4 }), [])
 })
+
+test('결과는 끝나는 순서가 아니라 items 순서다', async () => {
+  const delays = [30, 1, 15, 5]
+  const results = await runPool(delays, async (ms) => {
+    await new Promise((r) => setTimeout(r, ms))
+    return ms
+  }, { concurrency: 4 })
+  assert.deepStrictEqual(results, delays)
+})
+
+test('onChunk의 done은 끝난 작업 수이고 묶음 순서대로 알린다', async () => {
+  const seen = []
+  await runPool([20, 1, 10, 2, 3], async (ms) => new Promise((r) => setTimeout(r, ms)), {
+    concurrency: 2,
+    onChunk: (p) => seen.push([p.start, p.done]),
+  })
+  assert.deepStrictEqual(seen, [[0, 2], [2, 4], [4, 5]])
+})
