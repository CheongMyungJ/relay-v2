@@ -9,16 +9,17 @@
  */
 export async function runPool(items, worker, o = {}) {
   const size = Math.max(1, o.concurrency ?? 1)
-  const results = []
+  const results = new Array(items.length)
+  let done = 0
   for (let start = 0; start < items.length; start += size) {
     const chunk = items.slice(start, start + size)
     await Promise.all(
-      chunk.map(async (item) => {
-        const result = await worker(item)
-        results.push(result)
+      chunk.map(async (item, i) => {
+        results[start + i] = await worker(item)
+        done++
       }),
     )
-    o.onChunk?.({ start, size: chunk.length, done: results.length, total: items.length })
+    o.onChunk?.({ start, size: chunk.length, done, total: items.length })
   }
   return results
 }
