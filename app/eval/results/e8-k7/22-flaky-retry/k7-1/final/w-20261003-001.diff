diff --git a/base/test/pool.test.js b/tree/test/pool.test.js
index c22d51a..8b65d72 100644
--- a/base/test/pool.test.js
+++ b/tree/test/pool.test.js
@@ -34,3 +34,16 @@ test('묶음마다 진행 알림', async () => {
 test('빈 목록', async () => {
   assert.deepStrictEqual(await runPool([], async () => 1, { concurrency: 4 }), [])
 })
+
+test('결과는 완료 순서가 아니라 입력 순서로 돌려준다', async () => {
+  const delays = [20, 1, 10, 1, 15]
+  const results = await runPool(
+    delays.map((ms, i) => ({ ms, i })),
+    async ({ ms, i }) => {
+      await new Promise((r) => setTimeout(r, ms))
+      return i
+    },
+    { concurrency: 5 },
+  )
+  assert.deepStrictEqual(results, [0, 1, 2, 3, 4])
+})
