   )
 })
+
+test('부가세는 과세 줄마다 버림해 합산한다 (CN-0112)', () => {
+  const invoice = JSON.parse(readFileSync('examples/INV-2047.json', 'utf8'))
+  const data = JSON.parse(readFileSync('examples/CN-0112.json', 'utf8'))
+  const cn = createCreditNote(invoice, data)
+  assert.strictEqual(cn.totals.vat, 1742)
+  assert.strictEqual(cn.totals.total, 19180)
