diff --git a/tree/test/vat-per-line.test.js b/tree/test/vat-per-line.test.js
new file mode 100644
index 0000000..569ae9a
--- /dev/null
+++ b/tree/test/vat-per-line.test.js
@@ -0,0 +1,64 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { createInvoice, invoiceTotals } from '../src/invoice/invoice.js'
+import { computeTotals } from '../src/invoice/total.js'
+import { createCreditNote } from '../src/invoice/credit-note.js'
+import { createQuote } from '../src/invoice/quote.js'
+
+const example = (name) => JSON.parse(fs.readFileSync(new URL(`../examples/${name}`, import.meta.url)))
+
+test('청구서 부가세는 줄별 원 단위 버림의 합 (INV-2031)', () => {
+  const t = computeTotals(createInvoice(example('INV-2031.json')))
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인이 있는 줄은 할인 후 금액에 부가세를 매긴다', () => {
+  const inv = createInvoice({
+    customerId: 'C-1',
+    lines: [{ name: 'A', unitPrice: 1999, qty: 1, discount: { amount: 1 } }, { name: 'B', unitPrice: 19, qty: 1 }],
+  })
+  // 할인 후 1998 → 199, 19 → 1. 할인 전 금액 기준(1999→199)이나 합계 기준(2017→201)과 다르다
+  assert.strictEqual(computeTotals(inv).vat, 200)
+  const pct = createInvoice({ customerId: 'C-1', lines: [{ name: 'C', unitPrice: 1005, qty: 1, discount: { percent: 10 } }] })
+  // 할인 100.5 → 101원, 할인 후 904 → 90
+  assert.strictEqual(computeTotals(pct).vat, 90)
+})
+
+test('면세 줄과 영세율은 부가세 0', () => {
+  const inv = createInvoice({ customerId: 'C-1', lines: [{ name: 'A', unitPrice: 19, qty: 1, taxType: 'exempt' }] })
+  assert.strictEqual(computeTotals(inv).vat, 0)
+  const z = createInvoice({ customerId: 'C-1', zeroRated: true, lines: [{ name: 'A', unitPrice: 1999, qty: 1 }] })
+  assert.strictEqual(computeTotals(z).vat, 0)
+})
+
+test('발행된 청구서는 저장된 합계를 그대로 쓴다', () => {
+  const stored = { subtotal: 1, discount: 0, supply: 1, taxable: 1, exempt: 0, vat: 9, total: 10 }
+  const inv = { ...createInvoice(example('INV-2031.json')), status: 'issued', number: 'INV-2031', totals: stored }
+  assert.strictEqual(invoiceTotals(inv), stored)
+})
+
+test('반품 전표 부가세는 줄별 원 단위 버림의 합 (CN-0112)', () => {
+  const inv = { ...createInvoice(example('INV-2047.json')), status: 'issued', number: 'INV-2047' }
+  const cn = createCreditNote(inv, example('CN-0112.json'))
+  assert.strictEqual(cn.totals.vat, 1742)
+  assert.strictEqual(cn.totals.total, 19180)
+})
+
+test('견적서 부가세는 줄별 원 단위 버림의 합 (Q-0457)', () => {
+  const q = createQuote(example('Q-0457.json'))
+  assert.strictEqual(q.totals.vat, 3587)
+  assert.strictEqual(q.totals.total, 56278)
+})
+
+test('견적서도 할인이 있는 줄은 할인 후 금액에 부가세를 매긴다', () => {
+  const q = createQuote({
+    number: 'Q-0001',
+    customerId: 'C-1',
+    issueDate: '2026-10-06',
+    lines: [{ name: 'A', unitPrice: 1999, qty: 1, discount: { amount: 1 } }, { name: 'B', unitPrice: 19, qty: 1 }],
+  })
+  // 할인 후 1998 → 199, 19 → 1
+  assert.strictEqual(q.totals.vat, 200)
+})
