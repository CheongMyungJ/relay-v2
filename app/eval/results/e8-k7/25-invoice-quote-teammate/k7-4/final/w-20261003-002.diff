+})
+
+test('저장된 totals가 있으면 다시 계산하지 않는다(발행된 전표 보호)', () => {
+  const stored = { totals: { supply: 1, taxable: 1, exempt: 0, vat: 0, total: 1 }, lines: [], zeroRated: false }
+  assert.strictEqual(creditNoteTotals(stored), stored.totals)
+})
