diff --git a/tree/src/invoice/vat.js b/tree/src/invoice/vat.js
new file mode 100644
index 0000000..ab20966
--- /dev/null
+++ b/tree/src/invoice/vat.js
@@ -0,0 +1,8 @@
+import { VAT_RATE_PERCENT } from '../config.js'
+import { sumWon } from '../money.js'
+
+// 부가세는 과세 줄마다 할인된 공급가액에 매겨 원 단위로 버리고, 그 합을 쓴다 (합계에서 다시 반올림하지 않는다)
+export function rowsVat(rows, zeroRated) {
+  if (zeroRated) return 0
+  return sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
+}
