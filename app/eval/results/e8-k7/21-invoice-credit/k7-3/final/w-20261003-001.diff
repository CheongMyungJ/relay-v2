+++ b/tree/test/total.test.js
@@ -60,3 +60,28 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 과세 줄마다 원 단위로 버림해 합산한다 (INV-2031)', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 2641)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('할인된 과세 줄은 할인 후 금액 기준으로 줄별 버림한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1009, qty: 1, discount: { amount: 4 } }, // 1005 -> 100
+    { name: 'B', unitPrice: 1009, qty: 1, discount: { percent: 10 } }, // 할인 101, 908 -> 90
+    { name: 'C', unitPrice: 999, qty: 1, taxType: 'exempt' },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.vat, 190)
+  assert.strictEqual(t.total, 1005 + 908 + 999 + 190)
+})
