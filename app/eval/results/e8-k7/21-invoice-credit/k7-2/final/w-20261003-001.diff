@@ -0,0 +1,8 @@
+# 할인은 부가세 전에 줄마다 적용하고 부가세는 할인된 줄 금액에 매긴다
+
+- 종류: 규칙
+- 적용: src/invoice/total.js, src/invoice/discount.js
+- 출처: 사람이 알려 줌, relay Work w-20261003-001, 2026-10-03
+
+순서는 줄 할인 적용 → 줄 공급가액(net) 확정 → 그 net에 부가세. 청구서 전체에 한 번 할인하거나 할인 전 금액에 부가세를 매기면 틀리다.
+예: 1,005원 10% 할인 → 할인 100원, 공급가액 905원, 부가세 90원.
diff --git a/tree/docs/knowledge/vat-floor-per-line.md b/tree/docs/knowledge/vat-floor-per-line.md
new file mode 100644
index 0000000..d4f5ad1
--- /dev/null
+++ b/tree/docs/knowledge/vat-floor-per-line.md
@@ -0,0 +1,9 @@
+# 부가세는 품목 줄마다 원 단위 버림으로 계산해 합한다
+
+- 종류: 규칙
+- 적용: src/invoice/total.js (computeTotals), 청구서 부가세 계산 전반
+- 출처: 사람이 알려 줌, relay Work w-20261003-001, 2026-10-03
+
+부가세 = 과세 줄마다 `Math.floor(할인 후 줄 금액 × 세율 / 100)`의 합. 합계에 한 번 반올림하는 방식은 틀리다.
+예: INV-2031 줄별 536+633+325+837+310 = 2,641원(맞음). 과세 합계 26,438원에 반올림하면 2,644원(틀림). 합계는 29,079원.
+면세 줄은 부가세 없음, 영세율 청구서는 0.
diff --git a/base/src/invoice/total.js b/tree/src/invoice/total.js
index 6c97af3..dbfbeea 100644
--- a/base/src/invoice/total.js
+++ b/tree/src/invoice/total.js
@@ -23,6 +23,9 @@ export function computeTotals(invoice) {
   const taxable = sumWon(rows.filter((r) => r.taxable).map((r) => r.net))
   const exempt = sumWon(rows.filter((r) => !r.taxable).map((r) => r.net))
   const supply = taxable + exempt
-  const vat = invoice.zeroRated ? 0 : Math.round((taxable * VAT_RATE_PERCENT) / 100)
+  // 부가세는 과세 줄마다 원 단위 버림으로 구해 합한다(합계에서 다시 반올림하지 않는다)
+  const vat = invoice.zeroRated
+    ? 0
+    : sumWon(rows.filter((r) => r.taxable).map((r) => Math.floor((r.net * VAT_RATE_PERCENT) / 100)))
   return { subtotal, discount, supply, taxable, exempt, vat, total: supply + vat }
 }
diff --git a/base/test/total.test.js b/tree/test/total.test.js
index 5b9aafd..02a9ff3 100644
--- a/base/test/total.test.js
+++ b/tree/test/total.test.js
@@ -60,3 +60,28 @@ test('단가 0원 품목(증정품)', () => {
   ])
   assert.strictEqual(computeTotals(inv).total, 15290)
 })
+
+test('부가세는 과세 줄마다 원 단위 버림으로 구해 합한다', () => {
+  const inv = draft([
+    { name: '박스테이프', unitPrice: 1342, qty: 4 },
+    { name: '네임펜 흑', unitPrice: 905, qty: 7 },
+    { name: '스테이플러 심', unitPrice: 1085, qty: 3 },
+    { name: '수정테이프', unitPrice: 1675, qty: 5 },
+    { name: '볼펜 0.5 흑', unitPrice: 345, qty: 9 },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.supply, 26438)
+  assert.strictEqual(t.vat, 536 + 633 + 325 + 837 + 310)
+  assert.strictEqual(t.total, 29079)
+})
+
+test('부가세는 할인된 줄 금액에 매기고 면세 줄은 제외한다', () => {
+  const inv = draft([
+    { name: 'A', unitPrice: 1005, qty: 1, discount: { percent: 10 } }, // 할인 100(반올림) → 905 → 90
+    { name: 'B', unitPrice: 999, qty: 1, discount: { amount: 4 } }, // 995 → 99
+    { name: 'C', unitPrice: 5000, qty: 1, taxType: 'exempt' },
+  ])
+  const t = computeTotals(inv)
+  assert.strictEqual(t.vat, 90 + 99)
+  assert.strictEqual(t.total, t.supply + 189)
+})
