@@ -81,3 +81,24 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표의 부가세도 줄마다 원 단위 버림 후 합산한다', () => {
+  const base = issueInvoice(
+    createInvoice({
+      customerId: 'C-0412',
+      lines: [
+        { sku: 'A-1', name: '볼펜', unitPrice: 1343, qty: 1 },
+        { sku: 'A-2', name: '연필', unitPrice: 1342, qty: 1 },
+      ],
+    }),
+    { number: 'INV-0101', issueDate: '2026-09-01' },
+  )
+  const cn = createCreditNote(base, {
+    number: 'CN-0002',
+    issueDate: '2026-09-10',
+    reason: '파손',
+    returns: [{ sku: 'A-1', qty: 1 }, { sku: 'A-2', qty: 1 }],
+  })
+  assert.strictEqual(cn.totals.vat, base.totals.vat)
+  assert.strictEqual(cn.totals.vat, 268)
+})
