--- a/base/test/credit-note.test.js
+++ b/tree/test/credit-note.test.js
@@ -1,3 +1,4 @@
+import { readFileSync } from 'node:fs'
 import { test } from 'node:test'
 import assert from 'node:assert'
 import { creditNoteEntries, ledger } from '../src/export/ledger.js'
@@ -81,3 +82,18 @@ test('반품 전표 분개', () => {
     ['INV-0100', 'INV-0100', 'INV-0100', 'CN-0001', 'CN-0001', 'CN-0001'],
   )
 })
+
+test('반품 전표 부가세는 과세 줄마다 원 단위 버림의 합이다', () => {
+  const inv2047 = JSON.parse(readFileSync(new URL('../examples/INV-2047.json', import.meta.url)))
+  const cn0112 = JSON.parse(readFileSync(new URL('../examples/CN-0112.json', import.meta.url)))
+  const cn = createCreditNote(inv2047, cn0112)
+  // 줄별 923 + 612 + 207 = 1,742 (공급가액 17,438에 한 번 반올림하면 1,744)
+  assert.deepStrictEqual(cn.totals, { supply: 17438, taxable: 17438, exempt: 0, vat: 1742, total: 19180 })
+  const exempt = createCreditNote(
+    { ...inv2047, lines: [{ ...inv2047.lines[1], taxType: 'exempt' }] },
+    { ...cn0112, returns: [{ sku: 'OF-0415', qty: 5 }] },
+  )
+  assert.strictEqual(exempt.totals.vat, 0)
+  const zero = createCreditNote({ ...inv2047, zeroRated: true }, cn0112)
+  assert.deepStrictEqual([zero.totals.vat, zero.totals.total], [0, 17438])
+})
