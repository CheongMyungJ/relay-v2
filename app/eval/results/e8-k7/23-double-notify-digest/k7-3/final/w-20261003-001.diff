diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..c2e3389
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,76 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { shippedEvent, setup } from './helpers.js'
+
+// 전달은 됐지만 응답이 제한 시간(send 2000ms, 요약 3000ms)보다 늦게 온 경우: 다시 보내면 안 된다
+const SLOW = { latencyMs: 2500 }
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: ['tok-a'], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+
+async function drain(notifier, clock) {
+  for (let i = 0; i < 5; i++) {
+    clock.advance(60_000)
+    await notifier.retryWorker.runDue()
+  }
+}
+
+test('메일: 느리게 성공한 발송은 재시도로 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [SLOW] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'sent')
+  await drain(notifier, clock)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('푸시: 느리게 성공한 발송은 재시도로 다시 보내지 않는다', async () => {
+  const { notifier, clock, push } = setup({ push: { outcomes: [SLOW] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'push').status, 'sent')
+  await drain(notifier, clock)
+  assert.equal(push.sent.length, 1)
+  assert.equal(push.calls.length, 1)
+})
+
+test('요약 메일: 느리게 성공한 발송은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle({
+    id: 'ord-1-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1',
+    occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1' },
+  })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('실제로 실패한 메일 발송은 여전히 재시도된다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ fail: 'transient' }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'retry-scheduled')
+  await drain(notifier, clock)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('실제로 시간 초과로 실패한 푸시 발송은 여전히 재시도된다', async () => {
+  const { notifier, clock, push } = setup({ push: { outcomes: [{ fail: 'timeout' }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'push').status, 'retry-scheduled')
+  await drain(notifier, clock)
+  assert.equal(push.calls.length, 2)
+  assert.equal(push.sent.length, 1)
+})
+
+test('실제로 실패한 요약 메일은 여전히 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle({
+    id: 'ord-2-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1',
+    occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-2' },
+  })
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
