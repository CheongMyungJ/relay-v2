diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..dca75b2 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,101 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+// --- 중복 발송 회귀 시험: 요약이 나갈 수 있는 경로마다 고객은 한 번만 받는다 ---
+
+test('[경로: 느린 성공] 제한 시간(3000ms)을 넘겨 성공한 요약은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('[경로: 느린 성공] 매번 느려도 한 통만 나간다', async () => {
+  const slow = { latencyMs: 5000 }
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [slow, slow, slow] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[경로: 재실행] 같은 날짜를 다시 실행해도 이미 보낸 요약은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.run({ period: '2026-09-21' })
+  clock.advance(60_000)
+  const second = await notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(first.sent, 1)
+  assert.equal(second.sent, 0)
+  assert.equal(second.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[경로: 재실행] 정기 실행 뒤 수동 실행해도 한 통만 나간다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[경로: 재시도] 실패한 요약은 다시 보내져 결국 한 통만 전달된다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'transient' }, { fail: 'timeout' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'retry', 'sent'])
+})
+
+test('[경로: 재실행] 포기한 요약은 다음 실행에서 다시 보내진다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'permanent' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  assert.equal((await notifier.digest.run({ period: '2026-09-21' })).failed, 1)
+  assert.equal((await notifier.digest.run({ period: '2026-09-21' })).sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[하루 건너뛰기 없음] 이틀 연속 아침마다 그날의 요약이 한 번씩 나간다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  assert.equal((await notifier.digest.tick()).period, '2026-09-21')
+  await notifier.handle({ ...delivered('ord-1002-delivered', 'u-1', 'A-1002'), occurredAt: '2026-09-21T23:04:00Z' })
+  clock.set(NEXT_MORNING + 24 * 60 * 60 * 1000)
+  assert.equal((await notifier.digest.tick()).period, '2026-09-22')
+  assert.equal(mail.sent.length, 2)
+  assert.deepEqual(mail.sent.map((m) => m.headers['X-Notify-Digest']), ['2026-09-21/u-1', '2026-09-22/u-1'])
+})
+
+test('[경로: 재시도] 정기 실행에서 포기한 요약은 다음 tick에서 다시 보내지고 한 통만 전달된다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ fail: 'permanent' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  assert.equal((await notifier.digest.tick()).failed, 1)
+  const second = await notifier.digest.tick()
+  assert.equal(second.sent, 1)
+  assert.equal(await notifier.digest.tick(), null)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('[느린 성공] 제한 시간을 넘긴 성공은 digest.send.slow 지표로만 남는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  assert.equal(notifier.metrics.counter('digest.send.slow'), 1)
+  assert.equal(notifier.metrics.counter('digest.retry'), 0)
+  assert.equal(mail.sent.length, 1)
+})
