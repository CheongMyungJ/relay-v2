diff --git a/base/test/digest.test.js b/tree/test/digest.test.js
index 1917fdb..4c9c72d 100644
--- a/base/test/digest.test.js
+++ b/tree/test/digest.test.js
@@ -118,3 +118,79 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+test('제한 시간보다 오래 걸려도 성공한 요약은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 3500 } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.failed, 0)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  const entries = notifier.digest.ledger.forUser('u-1')
+  assert.deepEqual(entries.map((e) => e.status), ['sent'])
+  assert.equal(entries[0].slow, true)
+})
+
+test('시간 초과 오류로 실패한 요약은 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout', latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'sent'])
+})
+
+test('같은 기간 요약을 다시 실행해도(runId가 달라도) 이미 보낸 사용자에게는 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  await notifier.handle(delivered('ord-2001-delivered', 'u-2', 'B-2001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(second.already, 2)
+  assert.equal(second.sent, 0)
+  assert.equal(mail.sent.length, 2)
+})
+
+test('요약이 건너뛰어지지 않는다: 느린 발송이 있어도 모든 사용자에게 한 통씩 간다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  await notifier.handle(delivered('ord-2001-delivered', 'u-2', 'B-2001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 2)
+  assert.deepEqual(mail.sent.map((m) => m.to).sort(), ['mina@example.com', 'sam@example.com'])
+  assert.equal(mail.calls.length, 2)
+})
+
+test('같은 기간 요약을 동시에 실행해도 한 사용자에게 한 통만 간다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const [a, b] = await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-b' }),
+  ])
+  assert.equal(a.sent + b.sent, 1)
+  assert.equal(a.already + b.already, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('동시에 실행하다 보내기에 실패하면 선점이 풀려 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout', latencyMs: 3500 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const [a, b] = await Promise.all([
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-a' }),
+    notifier.digest.run({ period: '2026-09-21', runId: 'run-b' }),
+  ])
+  assert.equal(a.sent + b.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.calls.length, 2)
+  assert.equal(a.failed + b.failed, 0)
+})
