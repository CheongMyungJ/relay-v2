@@ -118,3 +119,103 @@ test('영구 오류는 다시 보내지 않는다', async () => {
   assert.equal(mail.calls.length, 1)
   assert.equal(notifier.digest.ledger.runSummary(summary.runId).failed, 1)
 })
+
+test('같은 기간을 수동 재실행해도 이미 보낸 사용자에게는 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'manual-1' })
+  assert.equal(again.sent, 0)
+  assert.equal(again.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('재시작해 일정이 다시 돌아도 같은 기간 요약은 한 번만 나간다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await notifier.digest.tick()
+  // 재시작: 일정의 메모리 상태(done)는 사라지고 발송 기록과 요약함만 남는다
+  const restarted = createDigestScheduler({
+    clock,
+    config: notifier.config,
+    runner: { run: notifier.digest.run },
+    inbox: notifier.digest.inbox,
+    logger: { info() {} },
+  })
+  clock.advance(1000)
+  const summary = await restarted.tick()
+  assert.equal(summary.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('느리지만 성공한 발송은 재시도하지 않고 slow로만 알린다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 5000 }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.equal(summary.sent, 1)
+  assert.equal(summary.slow, 1)
+  assert.equal(summary.failed, 0)
+})
+
+test('시간 초과 오류로 실제 실패한 발송은 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(mail.calls.length, 2)
+  assert.equal(summary.sent, 1)
+})
+
+test('실행이 중간에 터져도 그 기간을 건너뛰지 않고 다음 tick에 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const real = notifier.preferences.get
+  let boom = true
+  notifier.preferences.get = (id) => {
+    if (boom) { boom = false; throw new Error('저장소 오류') }
+    return real(id)
+  }
+  await assert.rejects(() => notifier.digest.tick(), /저장소 오류/)
+  clock.advance(60_000)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary?.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('서버가 하루 내내 꺼져 있었어도 놓친 기간의 요약을 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING + 24 * 60 * 60 * 1000) // 9/21 요약 없이 9/23 아침
+  await notifier.digest.tick()
+  assert.equal(mail.sent.length, 1)
+  assert.equal(mail.sent[0].subject, '2026-09-21 알림 요약 (1건)')
+})
+
+test('일정이 겹쳐 돌아도 같은 기간 요약은 한 번만 나간다', async () => {
+  const { notifier, clock, mail } = digestSetup()
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await Promise.all([notifier.digest.tick(), notifier.digest.tick()])
+  assert.equal(mail.sent.length, 1)
+})
+
+test('발송을 포기한 사용자가 있는 기간은 다음 tick에 다시 보낸다', async () => {
+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout' }, { fail: 'timeout' }, { fail: 'timeout' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await notifier.digest.tick()
+  assert.equal(first.failed, 1)
+  assert.equal(mail.sent.length, 0)
+  clock.advance(60_000)
+  const second = await notifier.digest.tick()
+  assert.equal(second.sent, 1)
+  assert.equal(mail.sent.length, 1)
+  clock.advance(60_000)
+  assert.equal(await notifier.digest.tick(), null) // 다 보냈으니 더는 돌지 않는다
+})
