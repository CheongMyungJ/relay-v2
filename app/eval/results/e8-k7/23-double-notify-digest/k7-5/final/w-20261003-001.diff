diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..c3d51f6
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,68 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { SendError } from '../src/adapters/errors.js'
+import { loadConfig } from '../src/config/load.js'
+import { decide } from '../src/retry/policy.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: ['tok-a'], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const delivered = () => ({
+  id: 'ord-1001-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1',
+  occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1001' },
+})
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+
+test('제한 시간보다 느려도 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: options.timeoutMs + 1 }, options), { action: 'done' })
+})
+
+test('느리게 성공한 메일은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: 3000 } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('실제로 시간 초과로 실패한 발송은 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ fail: 'timeout', latencyMs: 3000 }] } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'retry-scheduled')
+  clock.advance(notifier.config.retry.baseDelayMs)
+  assert.equal(await notifier.retryWorker.runDue(), 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약: 느리게 성공한 요약 메일은 다시 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { latencyMs: 5000 } })
+  await notifier.handle(delivered())
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약: 같은 기간을 다시 돌려도 이미 보낸 요약은 건너뛴다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS })
+  await notifier.handle(delivered())
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-1' })
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-2' })
+  assert.equal(second.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('요약: 보낸 키에서 runId를 빼도 실행별 집계는 기록의 runId로 센다', async () => {
+  const { notifier, clock } = setup({ users: DIGEST_USERS })
+  await notifier.handle(delivered())
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-1' })
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-2' })
+  assert.deepEqual(notifier.digest.ledger.runSummary('run-1'), { sent: 1 })
+  assert.deepEqual(notifier.digest.ledger.runSummary('run-2'), {})
+})
