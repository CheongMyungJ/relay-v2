+// ---- 서버 두 대가 같은 발송 기록(공용 DB 대용)을 쓰는 경우 ----
+
+function twoServers(mailOpts = {}) {
+  const clock = createVirtualClock(START)
+  const digestLedger = createDigestLedger({ clock, ttlMs: 7 * 24 * 3600_000 })
+  const make = () => {
+    const mail = createFakeMailTransport({ clock, latencyMs: 300, ...mailOpts })
+    const push = createFakePushTransport({ clock })
+    return { mail, notifier: createNotifier({ clock, transports: { mail, push }, preferences: DIGEST_USERS, digestLedger }) }
+  }
+  return { clock, digestLedger, a: make(), b: make() }
+}
+
+test('서버 두 대가 동시에 같은 요약을 돌려도 고객은 한 통만 받는다', async () => {
+  const { clock, a, b } = twoServers()
+  for (const s of [a, b]) {
+    await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+    await s.notifier.handle(delivered('ord-2001-delivered', 'u-2', 'B-2001'))
+  }
+  clock.set(NEXT_MORNING)
+  const [ra, rb] = await Promise.all([a.notifier.digest.run({ period: '2026-09-21' }), b.notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 2)
+  assert.equal(ra.sent + rb.sent, 2)
+  assert.equal(ra.already + rb.already, 2)
+  assert.deepEqual([...a.mail.sent, ...b.mail.sent].map((m) => m.to).sort(), ['mina@example.com', 'sam@example.com'])
+})
+
