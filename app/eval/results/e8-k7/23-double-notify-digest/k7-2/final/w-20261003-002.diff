+  const { notifier, clock, mail } = digestSetup({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout' }, { fail: 'timeout' }] } })
+  await notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
