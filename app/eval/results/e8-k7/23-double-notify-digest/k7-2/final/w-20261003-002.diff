+  const { clock, a, b } = twoServers()
+  for (const s of [a, b]) await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await a.notifier.digest.tick()
+  const second = await b.notifier.digest.tick()
+  assert.equal(second.already, 1)
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+})
+
+test('선점한 서버가 보내지 못하면 풀려서 재시도로 한 번 전달된다', async () => {
+  const { clock, digestLedger, a, b } = twoServers({ outcomes: [{ fail: 'timeout' }] })
+  for (const s of [a, b]) await s.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  // a가 보내다 실패하면 선점이 풀리고, 60초 뒤 재시도(또는 다른 서버)가 보낸다. 어느 쪽이든 합쳐서 한 통
+  const [ra, rb] = await Promise.all([a.notifier.digest.run({ period: '2026-09-21' }), b.notifier.digest.run({ period: '2026-09-21' })])
+  assert.equal(a.mail.sent.length + b.mail.sent.length, 1)
+  assert.equal(ra.failed + rb.failed, 0)
