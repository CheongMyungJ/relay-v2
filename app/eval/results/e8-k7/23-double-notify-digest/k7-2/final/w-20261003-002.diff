+  assert.equal(digestLedger.has('digest:2026-09-21:u-1'), true)
+})
+
+test('보내지 못하고 포기하면 선점이 풀려 재실행이 보낼 수 있다', async () => {
+  const { clock, digestLedger, a } = twoServers({ outcomes: [{ fail: 'permanent' }] })
+  await a.notifier.handle(delivered('ord-1001-delivered', 'u-1', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  const first = await a.notifier.digest.run({ period: '2026-09-21' })
+  assert.equal(first.failed, 1)
