diff --git a/tree/test/duplicate-send.test.js b/tree/test/duplicate-send.test.js
new file mode 100644
index 0000000..cf779e8
--- /dev/null
+++ b/tree/test/duplicate-send.test.js
@@ -0,0 +1,64 @@
+// 중복 발송 재현: 발송은 성공했는데 느렸다는 이유로 실패 취급해 다시 보내던 문제
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { decide } from '../src/retry/policy.js'
+import { loadConfig } from '../src/config/load.js'
+import { setup, shippedEvent } from './helpers.js'
+
+const config = loadConfig()
+const options = { timeoutMs: config.send.timeoutMs, ...config.retry }
+const SLOW = 2500 // send.timeoutMs(2000)보다 느리지만 성공하는 발송
+
+test('느리게 성공한 발송은 끝으로 본다', () => {
+  assert.deepEqual(decide({ ok: true }, { attempt: 1, elapsedMs: SLOW }, options), { action: 'done' })
+})
+
+test('메일이 느리게 성공해도 한 번만 도착한다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { latencyMs: SLOW }, users: { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko' } } })
+  const res = await notifier.handle(shippedEvent())
+  assert.equal(res.results.find((r) => r.channel === 'mail').status, 'sent')
+  assert.equal(notifier.retryQueue.size(), 0)
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+test('푸시가 느리게 성공해도 한 번만 도착한다', async () => {
+  const { notifier, clock, push } = setup({ push: { latencyMs: SLOW } })
+  await notifier.handle(shippedEvent())
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(push.sent.length, 1)
+})
+
+test('시간 초과로 실제 실패한 발송은 여전히 다시 보낸다', async () => {
+  const { notifier, clock, mail } = setup({ mail: { outcomes: [{ fail: 'timeout' }] } })
+  await notifier.handle(shippedEvent())
+  assert.equal(notifier.retryQueue.size() >= 1, true)
+  clock.advance(10 * 60_000)
+  await notifier.retryWorker.runDue()
+  assert.equal(mail.sent.length, 1)
+})
+
+const DIGEST_USERS = { 'u-1': { email: 'mina@example.com', pushTokens: [], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+const delivered = { id: 'ord-1001-delivered', source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo: 'A-1001' } }
+
+test('요약 메일이 느리게 성공해도 한 통만 간다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS, mail: { latencyMs: 3500 } })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('같은 기간 요약을 다시 실행해도 이미 보낸 사용자에게는 보내지 않는다', async () => {
+  const { notifier, clock, mail } = setup({ users: DIGEST_USERS })
+  await notifier.handle(delivered)
+  clock.set(NEXT_MORNING)
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-a' })
+  const second = await notifier.digest.run({ period: '2026-09-21', runId: 'run-b' })
+  assert.equal(second.already, 1)
+  assert.equal(mail.sent.length, 1)
+})
