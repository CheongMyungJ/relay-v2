 // 요약 한 통을 가리는 키. 발송 기록에 이 키로 남기고, 같은 키로 이미 보냈으면 다시 보내지 않는다.
+// 기간과 사용자만으로 정한다. 실행(runId)이나 서버가 달라도 같은 요약은 같은 키여야 다시 실행해도 두 번 나가지 않는다.
+// 실행별 집계는 발송 기록의 runId 필드로 한다(ledger.runSummary).
 
 /**
- * @param {{ userId: string, period: string, runId: string }} job
+ * @param {{ userId: string, period: string }} job
  */
-export function digestKey({ userId, period, runId }) {
-  // 실행마다 따로 남겨야 운영 화면에서 실행별로 몇 통 보냈는지 셀 수 있다
-  return `digest:${period}:${runId}:${userId}`
+export function digestKey({ userId, period }) {
+  return `digest:${period}:${userId}`
+}
+
+/**
+ * 같은 요약은 몇 번을, 어느 서버에서 보내도 같은 Message-ID를 쓴다. 메일 서버가 응답은 늦어도 받은 메일은 보내므로,
+ * timeout 뒤 재시도가 이미 나간 메일과 같은 메일임을 이 값으로 알린다.
+ */
+export function digestMessageId({ userId, period }, from) {
+  const domain = String(from).split('@').pop() || 'notify.invalid'
+  const local = `digest.${period}.${encodeURIComponent(userId).replace(/%/g, '=')}`
+  return `<${local}@${domain}>`
 }
