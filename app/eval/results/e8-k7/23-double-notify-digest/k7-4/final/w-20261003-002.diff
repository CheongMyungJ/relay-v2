diff --git a/tree/test/digest-duplicate.test.js b/tree/test/digest-duplicate.test.js
new file mode 100644
index 0000000..6706abc
--- /dev/null
+++ b/tree/test/digest-duplicate.test.js
@@ -0,0 +1,82 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { createFakeMailTransport } from '../src/adapters/fake-transports.js'
+import { createVirtualClock } from '../src/clock.js'
+import { createNotifier } from '../src/notifier.js'
+import { digestKey, digestMessageId } from '../src/digest/key.js'
+import { setup } from './helpers.js'
+
+const USERS = { 'u-1': { email: 'mina@example.com', pushTokens: ['tok-a'], locale: 'ko', digest: true } }
+const NEXT_MORNING = Date.parse('2026-09-21T23:05:00Z')
+
+function delivered(id, orderNo) {
+  return { id, source: 'orders', type: 'order.delivered', userId: 'u-1', occurredAt: '2026-09-21T00:59:00Z', data: { orderNo } }
+}
+
+async function collected(opts) {
+  const s = setup({ users: USERS, push: { latencyMs: 60 }, ...opts })
+  await s.notifier.handle(delivered('ord-1001-delivered', 'A-1001'))
+  s.clock.set(NEXT_MORNING)
+  return s
+}
+
+test('키는 기간과 사용자로만 정한다(runId가 달라도 같다)', () => {
+  assert.equal(digestKey({ userId: 'u-1', period: '2026-09-21', runId: 'a' }), digestKey({ userId: 'u-1', period: '2026-09-21', runId: 'b' }))
+})
+
+test('느려도 성공한 발송은 한 통이고 sent가 남는다', async () => {
+  const { notifier, mail } = await collected({ mail: { latencyMs: 300, outcomes: [{ latencyMs: 5000 }] } })
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 1)
+  assert.equal(mail.sent.length, 1)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['sent'])
+})
+
+test('timeout 뒤 재시도: 메일이 이미 나갔어도 같은 Message-ID라 한 통만 나간다', async () => {
+  const { notifier, mail } = await collected({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout', delivered: true, latencyMs: 5000 }] } })
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 2) // 재시도는 유지된다
+  assert.equal(mail.sent.length, 1)
+  assert.match(mail.sent[0].headers['Message-ID'], /^<digest\.2026-09-21\.u-1@notify\.example>$/)
+  assert.deepEqual(notifier.digest.ledger.forUser('u-1').map((e) => e.status), ['retry', 'sent'])
+})
+
+test('timeout로 실제 실패하면 재시도해서 결국 한 통이 나간다', async () => {
+  const { notifier, mail } = await collected({ mail: { latencyMs: 300, outcomes: [{ fail: 'timeout' }, { fail: 'timeout' }] } })
+  const summary = await notifier.digest.tick()
+  assert.equal(summary.sent, 1)
+  assert.equal(mail.calls.length, 3)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('같은 기간을 다시 실행해도(runId가 달라도) 다시 보내지 않는다', async () => {
+  const { notifier, mail } = await collected({ mail: { latencyMs: 300 } })
+  await notifier.digest.run({ period: '2026-09-21', runId: 'run-1' })
+  const again = await notifier.digest.run({ period: '2026-09-21', runId: 'run-2' })
+  assert.equal(again.already, 1)
+  assert.equal(again.sent, 0)
+  assert.equal(mail.calls.length, 1)
+})
+
+test('서버 두 대가 같은 요약을 보내도 같은 메일 서버에는 한 통만 나간다', async () => {
+  const clock = createVirtualClock('2026-09-21T01:00:00Z')
+  const mail = createFakeMailTransport({ clock, latencyMs: 300 })
+  const make = () => createNotifier({ clock, transports: { mail, push: undefined }, preferences: USERS })
+  const a = make()
+  const b = make()
+  for (const n of [a, b]) await n.handle(delivered('ord-1001-delivered', 'A-1001'))
+  clock.set(NEXT_MORNING)
+  await a.digest.run({ period: '2026-09-21', runId: 'server-a' })
+  await b.digest.run({ period: '2026-09-21', runId: 'server-b' }) // 발송 기록은 서버마다 따로라 막지 못한다
+  assert.equal(mail.calls.length, 2)
+  assert.equal(mail.sent.length, 1)
+})
+
+test('Message-ID는 사용자 ID가 달라지면 달라진다(인코딩이 겹치지 않는다)', () => {
+  const id = (userId) => digestMessageId({ userId, period: '2026-09-21' }, 'a@notify.example')
+  assert.notEqual(id('a%20b'), id('a_20b'))
+  assert.notEqual(id('a%20b'), id('a b'))
+  assert.notEqual(id('a=20b'), id('a b'))
+})
