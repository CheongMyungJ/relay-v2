{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/skill-manifest.v1.json",
  "title": "Skill manifest (v1)",
  "description": "<RELAY_HOME>/skills/<name>/relay.json. SKILL.md 옆에 둔다. 앱이 승인 전 검증에 쓰는 메타데이터다. 파이프라인 정보(다음 스킬 등)는 넣지 않는다 (D14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "title", "produces"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "maxLength": 40 },
    "summary": { "type": "string", "maxLength": 120, "description": "[다음 단계 변경] '기타 스킬' 목록에 보여 줄 한 줄" },
    "produces": {
      "type": "array",
      "description": "task 디렉터리에 있어야 하는 산출물. required 산출물이 없으면 handoff 검증 오류로 취급",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required"],
        "properties": {
          "path": { "type": "string" },
          "required": { "type": "boolean" },
          "when": { "type": "string", "description": "pipeline when과 같은 문법. 예: intent.delivery == 'pr'" },
          "required_headings": { "type": "array", "items": { "type": "string" }, "description": "산출물에 있어야 하는 ## 제목" }
        }
      }
    },
    "handoff_extensions": {
      "type": "array",
      "description": "이 스킬의 handoff에 필수인 확장 필드",
      "items": { "enum": ["pipeline_fit", "repro", "intent_revision", "delivery_draft"] }
    },
    "writes_code": { "type": "boolean", "default": false, "description": "true면 승인 시 worktree가 깨끗해야(커밋 완료) 한다" }
  }
}
