{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay/knowledge-entry.v1.schema.json",
  "title": "지식 파일의 YAML 머리글 (D320)",
  "description": "레포의 지식 폴더와 앱 저장소(나만, 공유 대기)의 지식 파일 <kind>/<id>.md의 머리글이다. 본문은 `# <규칙>`과 `## 이유`, `## 코드불가`, `## 유인` 절이다. 정의되지 않은 필드는 스키마에서 허용하고, 앱이 경고만 한다.",
  "type": "object",
  "required": ["id", "kind", "subkind", "status", "superseded_by", "paths", "terms", "hashes", "source"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(domain|recipe|failure|constraint|decision|structure)-[0-9a-z]{8}$"
    },
    "kind": { "enum": ["domain", "recipe", "failure", "constraint", "decision", "structure"] },
    "subkind": { "enum": ["compat", "non_goal", "term", null] },
    "status": { "enum": ["active", "superseded"] },
    "superseded_by": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(domain|recipe|failure|constraint|decision|structure)-[0-9a-z]{8}$"
        }
      ]
    },
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "source": {
      "type": "object",
      "required": ["work", "task", "by"],
      "properties": {
        "work": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "by": { "enum": ["human", "ai"] }
      }
    }
  }
}
