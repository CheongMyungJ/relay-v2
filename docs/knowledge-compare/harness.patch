+import { test } from 'node:test'
+import assert from 'node:assert'
+import fs from 'node:fs'
+import { earnPoints } from '../src/points/earn.js'
+import { normalizeOrder } from '../src/orders/order.js'
+
+// 적립 규칙(Work 1): 기준 금액 = 상품 금액 − 쿠폰 할인 − 포인트 사용. 배송비는 넣지 않는다. 등급 적립률을 곱해 원 단위 버림
+
+test('B-24117: 리포트의 주문이 고객센터 계산과 같다', () => {
+  const o = normalizeOrder(JSON.parse(fs.readFileSync(new URL('../examples/B-24117.json', import.meta.url))))
+  assert.strictEqual(earnPoints(o), 467)
+})
+
+test('배송비는 적립 기준에 넣지 않는다', () => {
+  const o = normalizeOrder({ id: 'B-30', tier: 'basic', items: [{ price: 18700 }] })
+  assert.strictEqual(o.shipping, 3000)
+  assert.strictEqual(earnPoints(o), 187)
+})
+
+test('원 단위 버림', () => {
+  const o = normalizeOrder({ id: 'B-31', tier: 'gold', items: [{ price: 31990 }] })
+  assert.strictEqual(earnPoints(o), 959)
+})
+
+test('쿠폰과 포인트 사용을 뺀 금액에 적립', () => {
+  const o = normalizeOrder({ id: 'B-32', tier: 'gold', items: [{ price: 42350 }], couponDiscount: 2000, pointsUsed: 5000 })
+  assert.strictEqual(earnPoints(o), 1060)
+})
