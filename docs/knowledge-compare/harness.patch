@@ -0,0 +1,10 @@
+import { TIER_RATES } from '../config.js'
+import { percentOf } from '../money.js'
+import { payable } from '../orders/order.js'
+
+/** 결제가 끝난 주문에 적립할 포인트 */
+export function earnPoints(order) {
+  if (order.status !== 'paid') return 0
+  const rate = TIER_RATES[order.tier] ?? TIER_RATES.basic
+  return Math.round(percentOf(payable(order), rate))
+}
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/points/expire.js b/app/eval/scenarios/26-points-policy-change/repo/src/points/expire.js
new file mode 100644
index 0000000..02a7834
--- /dev/null
+++ b/app/eval/scenarios/26-points-policy-change/repo/src/points/expire.js
@@ -0,0 +1,31 @@
+import { POINT_EXPIRY_MONTHS } from '../config.js'
+import { monthsAfter } from '../dates.js'
+
+/** 적립 건의 소멸일 */
+export function expiresOn(earnedAt) {
+  return monthsAfter(earnedAt, POINT_EXPIRY_MONTHS)
+}
+
+/**
+ * asOf 날짜에 남은 포인트. entries는 적립({ type: 'earn', points, at })과 사용({ type: 'use', points, at }).
+ * 사용은 먼저 적립한 것부터 쓴다(선입선출). 소멸일이 asOf 이하인 적립은 남은 만큼 사라진다
+ */
+export function balanceOn(entries, asOf) {
+  const lots = []
+  for (const e of [...entries].sort((a, b) => (a.at < b.at ? -1 : a.at > b.at ? 1 : 0))) {
+    if (e.at > asOf) break
+    if (e.type === 'earn') lots.push({ left: e.points, expires: expiresOn(e.at) })
+    else if (e.type === 'use') {
+      let need = e.points
+      for (const lot of lots) {
+        if (lot.expires <= e.at) continue
+        const take = Math.min(lot.left, need)
+        lot.left -= take
+        need -= take
+        if (!need) break
+      }
+      if (need) throw new Error(`포인트가 모자란 사용: ${e.at} ${e.points}`)
+    }
+  }
+  return lots.filter((l) => l.expires > asOf).reduce((a, l) => a + l.left, 0)
+}
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/points/ledger.js b/app/eval/scenarios/26-points-policy-change/repo/src/points/ledger.js
