@@ -0,0 +1,18 @@
+// 원 단위 금액 도우미. 금액은 모두 0 이상의 정수 원이다
+
+export function assertWon(n, label = '금액') {
+  if (!Number.isInteger(n) || n < 0) throw new TypeError(`${label}은 0 이상의 정수 원이어야 한다: ${n}`)
+  return n
+}
+
+export const sumWon = (xs) => xs.reduce((a, b) => a + b, 0)
+
+/** amount의 percent%. 소수가 나올 수 있다 */
+export function percentOf(amount, percent) {
+  return (amount * percent) / 100
+}
+
+/** 12345 → "12,345원" */
+export function formatWon(n) {
+  return `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}원`
+}
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/orders/order.js b/app/eval/scenarios/26-points-policy-change/repo/src/orders/order.js
new file mode 100644
index 0000000..c030a74
--- /dev/null
+++ b/app/eval/scenarios/26-points-policy-change/repo/src/orders/order.js
@@ -0,0 +1,40 @@
+import { FREE_SHIPPING_OVER, SHIPPING_FEE } from '../config.js'
+import { assertDate } from '../dates.js'
+import { assertWon, sumWon } from '../money.js'
+
+/** 주문 입력(JSON)을 정규화한다 */
+export function normalizeOrder(input) {
+  const items = (input.items ?? []).map((it) => ({
+    sku: it.sku,
+    title: it.title ?? '',
+    price: assertWon(it.price, '단가'),
+    qty: it.qty ?? 1,
+  }))
+  if (!items.length) throw new Error('주문에 상품이 없다')
+  const order = {
+    id: input.id,
+    customerId: input.customerId,
+    tier: input.tier ?? 'basic',
+    items,
+    couponDiscount: assertWon(input.couponDiscount ?? 0, '쿠폰 할인'),
+    pointsUsed: assertWon(input.pointsUsed ?? 0, '사용 포인트'),
+    status: input.status ?? 'paid',
+    paidAt: input.paidAt ? assertDate(input.paidAt, '결제일') : null,
+  }
+  if (order.couponDiscount > itemsTotal(order)) throw new Error('쿠폰 할인이 상품 금액보다 크다')
+  order.shipping = input.shipping ?? shippingFee(order)
+  if (order.pointsUsed > itemsTotal(order) - order.couponDiscount + order.shipping)
+    throw new Error('사용 포인트가 결제할 금액보다 크다')
+  return order
+}
+
+export const itemsTotal = (order) => sumWon(order.items.map((i) => i.price * i.qty))
+
+export function shippingFee(order) {
+  return itemsTotal(order) - order.couponDiscount >= FREE_SHIPPING_OVER ? 0 : SHIPPING_FEE
+}
+
+/** 고객이 카드 등으로 실제 결제하는 금액. 포인트로 낸 금액은 빠진다 */
+export function payable(order) {
+  return itemsTotal(order) - order.couponDiscount + order.shipping - order.pointsUsed
+}
