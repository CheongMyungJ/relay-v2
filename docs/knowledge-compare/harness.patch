+import { RESCHEDULE_FEE_PERCENT } from '../config.js'
+import { percentOf, roundTo } from '../money.js'
+
+/** 예약 변경 수수료. appt.changes는 이번 변경을 넣은 변경 횟수다. 처음 한 번은 무료 */
