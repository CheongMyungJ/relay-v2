+import { TIER_RATES } from '../config.js'
+import { formatWon, percentOf } from '../money.js'
+import { itemsTotal, normalizeOrder, payable } from '../orders/order.js'
+
+/**
+ * 장바구니 결제 미리보기. 앱이 이 객체를 그대로 화면에 찍는다
+ * (items, coupon, shipping, pointsUsed, payable, expectedPoints, lines)
+ */
+export function cartPreview(cart) {
+  const order = normalizeOrder({ ...cart, status: 'paid' })
+  const total = payable(order)
+  const expectedPoints = percentOf(total, TIER_RATES[order.tier] ?? TIER_RATES.basic)
+  return {
+    items: itemsTotal(order),
+    coupon: order.couponDiscount,
+    shipping: order.shipping,
+    pointsUsed: order.pointsUsed,
+    payable: total,
+    expectedPoints,
+    lines: [
+      `상품 ${formatWon(itemsTotal(order))}`,
+      `배송비 ${order.shipping ? formatWon(order.shipping) : '무료'}`,
+      `결제 ${formatWon(total)}`,
+      `적립 예정 ${expectedPoints}P`,
+    ],
+  }
+}
