@@ -0,0 +1,32 @@
+import { test } from 'node:test'
+import assert from 'node:assert'
+import { itemsTotal, normalizeOrder, payable } from '../src/orders/order.js'
+import { orderSummaryLines } from '../src/orders/summary.js'
+
+test('배송비: 쿠폰 뺀 상품 금액 30,000원 이상이면 무료', () => {
+  const a = normalizeOrder({ id: 'B-1', items: [{ price: 15000, qty: 2 }] })
+  assert.strictEqual(a.shipping, 0)
+  const b = normalizeOrder({ id: 'B-2', items: [{ price: 15000, qty: 2 }], couponDiscount: 1000 })
+  assert.strictEqual(b.shipping, 3000)
+})
+
+test('결제 금액은 포인트로 낸 금액을 뺀다', () => {
+  const o = normalizeOrder({ id: 'B-3', items: [{ price: 12000 }], pointsUsed: 2000 })
+  assert.strictEqual(itemsTotal(o), 12000)
+  assert.strictEqual(payable(o), 13000)
+})
+
+test('사용 포인트가 결제할 금액보다 크면 거부', () => {
+  assert.throws(() => normalizeOrder({ id: 'B-4', items: [{ price: 1000 }], pointsUsed: 5000 }), /사용 포인트/)
+})
+
+test('주문 요약 문구', () => {
+  const o = normalizeOrder({ id: 'B-5', items: [{ price: 21000 }], couponDiscount: 1000, pointsUsed: 500 })
+  assert.deepStrictEqual(orderSummaryLines(o), [
+    '상품 금액 21,000원',
+    '쿠폰 할인 -1,000원',
+    '배송비 3,000원',
+    '포인트 사용 -500원',
+    '결제 금액 22,500원',
+  ])
+})
