+import { test } from 'node:test'
+import assert from 'node:assert'
+import { balanceOn, expiresOn } from '../src/points/expire.js'
+import { ledgerLine } from '../src/points/ledger.js'
+
+test('소멸일은 12개월 뒤', () => {
+  assert.strictEqual(expiresOn('2025-03-31'), '2026-03-31')
+  assert.strictEqual(expiresOn('2024-02-29'), '2025-02-28')
+})
+
+test('선입선출로 쓰고 소멸한 것은 빠진다', () => {
+  const entries = [
+    { type: 'earn', points: 300, at: '2025-01-10' },
+    { type: 'earn', points: 500, at: '2025-06-01' },
+    { type: 'use', points: 200, at: '2025-07-01' },
+  ]
+  assert.strictEqual(balanceOn(entries, '2025-12-31'), 600)
+  assert.strictEqual(balanceOn(entries, '2026-01-10'), 500)
+})
+
+test('내역 문구', () => {
+  assert.strictEqual(ledgerLine({ type: 'earn', points: 120, at: '2025-05-02' }), '2025-05-02 적립 +120P (소멸 2026-05-02)')
