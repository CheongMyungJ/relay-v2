+// 등급별 적립률(%)
+export const TIER_RATES = { basic: 1, silver: 2, gold: 3 }
+
+// 등급 기준: 최근 TIER_WINDOW_MONTHS개월 구매 실적(원)
+export const TIER_THRESHOLDS = { silver: 300000, gold: 1000000 }
+export const TIER_WINDOW_MONTHS = 12
+
+// 배송비: 쿠폰을 뺀 상품 금액이 FREE_SHIPPING_OVER 이상이면 무료
