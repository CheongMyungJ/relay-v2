+import { formatWon } from '../money.js'
+import { expiresOn } from './expire.js'
+
+/** 마이페이지 포인트 내역의 한 줄 */
+export function ledgerLine(entry) {
+  if (entry.type === 'earn') return `${entry.at} 적립 +${entry.points}P (소멸 ${expiresOn(entry.at)})`
+  if (entry.type === 'use') return `${entry.at} 사용 -${entry.points}P`
+  throw new Error(`모르는 내역: ${entry.type}`)
+}
+
+/** 포인트를 원으로 보일 때 (1P = 1원) */
+export const pointsAsWon = (points) => formatWon(points)
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/points/tier.js b/app/eval/scenarios/26-points-policy-change/repo/src/points/tier.js
new file mode 100644
