@@ -0,0 +1,26 @@
+import { CLINIC_NAME, CLINIC_PHONE } from '../config.js'
+import { formatWon } from '../money.js'
+
+// 문자 대행사 템플릿과 맞춘 문구. 바꾸면 발송이 거부된다
+
+const total = (appt, kind) => appt.charges.filter((c) => c.kind === kind).reduce((a, c) => a + c.amount, 0)
+
+export function messageFor(appt) {
+  const name = appt.patientName || '환자'
+  switch (appt.status) {
+    case 'booked':
+      return `[${CLINIC_NAME}] ${name}님, ${appt.startsAt.replace('T', ' ')} 예약되었습니다. 문의 ${CLINIC_PHONE}`
+    case 'cancelled': {
+      const fee = total(appt, 'cancel')
+      return `[${CLINIC_NAME}] ${name}님, 예약이 취소되었습니다.${fee ? ` 취소 수수료 ${formatWon(fee)}` : ''}`
+    }
+    case 'noshow': {
+      const fee = total(appt, 'noshow')
+      return `[${CLINIC_NAME}] ${name}님, 예약 시간에 내원하지 않으셨습니다.${fee ? ` 노쇼 수수료 ${formatWon(fee)}` : ''} 문의 ${CLINIC_PHONE}`
+    }
+    case 'done':
+      return `[${CLINIC_NAME}] ${name}님, 진료가 끝났습니다. 감사합니다.`
+    default:
+      throw new Error(`모르는 상태: ${appt.status}`)
+  }
+}
