@@ -0,0 +1,18 @@
+// 원 단위 금액 도우미. 금액은 모두 0 이상의 정수 원이다
+
+export function assertWon(n, label = '금액') {
+  if (!Number.isInteger(n) || n < 0) throw new TypeError(`${label}은 0 이상의 정수 원이어야 한다: ${n}`)
+  return n
+}
+
+/** amount의 percent%. 소수가 나올 수 있다 */
+export const percentOf = (amount, percent) => (amount * percent) / 100
+
+/** unit 단위로 반올림 (예: roundTo(11235, 10) → 11240) */
+export const roundTo = (n, unit) => Math.round(n / unit) * unit
+
+/** unit 단위 미만을 버림 (예: floorTo(11235, 100) → 11200) */
+export const floorTo = (n, unit) => Math.floor(n / unit) * unit
+
+/** 12345 → "12,345원" */
+export const formatWon = (n) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}원`
