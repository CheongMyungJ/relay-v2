+++ b/app/eval/scenarios/26-points-policy-change/repo/src/points/tier.js
@@ -0,0 +1,19 @@
+import { TIER_THRESHOLDS, TIER_WINDOW_MONTHS } from '../config.js'
+import { monthsBefore } from '../dates.js'
+import { payable } from '../orders/order.js'
+
+/** asOf 기준 최근 12개월 구매 실적(원) */
+export function purchaseRecord(orders, asOf) {
+  const from = monthsBefore(asOf, TIER_WINDOW_MONTHS)
+  return orders
+    .filter((o) => o.paidAt > from && o.paidAt <= asOf)
+    .reduce((a, o) => a + payable(o), 0)
+}
+
+/** asOf 기준 회원 등급 */
+export function tierFor(orders, asOf) {
+  const record = purchaseRecord(orders, asOf)
+  if (record >= TIER_THRESHOLDS.gold) return 'gold'
+  if (record >= TIER_THRESHOLDS.silver) return 'silver'
+  return 'basic'
+}
