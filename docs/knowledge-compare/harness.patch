+import { CANCEL_FEE_PERCENT } from '../config.js'
+import { percentOf, roundTo } from '../money.js'
+import { minutesBetween } from '../appointments/appointment.js'
+
+/** 취소 수수료. 진료 시작 24시간 안에 취소하면 예정 진료비의 30% */
+export function cancelFee(appt, cancelledAt) {
+  const before = minutesBetween(cancelledAt, appt.startsAt)
+  if (before >= 24 * 60) return 0
+  return roundTo(percentOf(appt.expectedFee, CANCEL_FEE_PERCENT), 10)
+}
