+test('A-7781: 전날 밤 취소는 수수료 없음', () => {
+  assert.strictEqual(sum(cancel(example('A-7781'), '2025-11-03T21:00'), 'cancel'), 0)
+})
+
+test('당일 아침 취소는 30%를 100원 미만 버림', () => {
+  assert.strictEqual(sum(cancel(appt(), '2025-11-20T08:00'), 'cancel'), 11200)
+  assert.strictEqual(sum(cancel(appt({ expectedFee: 52390 }), '2025-11-20T09:55'), 'cancel'), 15700)
+})
+
+test('전날 23시 59분 취소도 무료', () => {
+  assert.strictEqual(sum(cancel(appt({ startsAt: '2025-11-20T00:30' }), '2025-11-19T23:59'), 'cancel'), 0)
+})
