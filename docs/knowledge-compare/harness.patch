+export const SHIPPING_FEE = 3000
+
+// 적립 포인트의 유효 기간(개월)
+export const POINT_EXPIRY_MONTHS = 12
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/dates.js b/app/eval/scenarios/26-points-policy-change/repo/src/dates.js
new file mode 100644
index 0000000..4f795dc
--- /dev/null
+++ b/app/eval/scenarios/26-points-policy-change/repo/src/dates.js
@@ -0,0 +1,21 @@
+// 날짜는 'YYYY-MM-DD' 문자열이다. 사전 순서가 날짜 순서와 같다
+
+export function assertDate(s, label = '날짜') {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(s ?? '')) throw new TypeError(`${label}는 YYYY-MM-DD여야 한다: ${s}`)
+  return s
+}
+
+/** date에서 months개월 전 (같은 날. 그달에 그날이 없으면 그달의 마지막 날) */
+export function monthsBefore(date, months) {
+  return monthsAfter(date, -months)
+}
+
+export function monthsAfter(date, months) {
+  assertDate(date)
+  const [y, m, d] = date.split('-').map(Number)
+  const total = y * 12 + (m - 1) + months
+  const ny = Math.floor(total / 12)
+  const nm = (total % 12) + 1
+  const last = new Date(Date.UTC(ny, nm, 0)).getUTCDate()
+  return `${ny}-${String(nm).padStart(2, '0')}-${String(Math.min(d, last)).padStart(2, '0')}`
+}
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/money.js b/app/eval/scenarios/26-points-policy-change/repo/src/money.js
