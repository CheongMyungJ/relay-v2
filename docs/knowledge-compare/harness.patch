+import { formatWon } from '../money.js'
+import { itemsTotal, payable } from './order.js'
+
+/** 주문 확인 메일의 금액 줄 */
+export function orderSummaryLines(order) {
+  const lines = [`상품 금액 ${formatWon(itemsTotal(order))}`]
+  if (order.couponDiscount) lines.push(`쿠폰 할인 -${formatWon(order.couponDiscount)}`)
+  lines.push(`배송비 ${order.shipping ? formatWon(order.shipping) : '무료'}`)
+  if (order.pointsUsed) lines.push(`포인트 사용 -${formatWon(order.pointsUsed)}`)
+  lines.push(`결제 금액 ${formatWon(payable(order))}`)
+  return lines
+}
diff --git a/app/eval/scenarios/26-points-policy-change/repo/src/points/earn.js b/app/eval/scenarios/26-points-policy-change/repo/src/points/earn.js
